  function svgPointString(points) { return points.map(p => `${p[0]},${-p[1]}`).join(' '); }
  function netBounds(net) {
    const pts = net.faces.flatMap(f => f.points);
    const xs = pts.map(p => p[0]), ys = pts.map(p => -p[1]);
    const minX = Math.min(...xs), maxX = Math.max(...xs), minY = Math.min(...ys), maxY = Math.max(...ys);
    const pad = 0.35;
    return `${minX - pad} ${minY - pad} ${maxX - minX + pad * 2} ${maxY - minY + pad * 2}`;
  }
  function midpoint2(points) { return [(points[0][0] + points[1][0]) / 2, -(points[0][1] + points[1][1]) / 2]; }

  const internalIndex = id => Math.max(0, Number(String(id).slice(1)) - 1);
  const circledNumber = index => ['①','②','③','④'][index] || String(index + 1);
  function publicEdgeFromInternal(solid, internalId, withPrefix = true) {
    return publicEdgeName(solid, internalIndex(internalId), makeLocalVertexMap(solid), withPrefix);
  }
  function publicVertexFromInternal(solid, internalId, withPrefix = true) {
    return publicVertexName(solid, internalIndex(internalId), makeLocalVertexMap(solid), withPrefix);
  }
  function publicFaceFromInternal(solid, internalId, withPrefix = true) {
    return publicFaceName(solid, internalIndex(internalId), makeLocalVertexMap(solid), withPrefix);
  }
  function edgeRelation(solid, aIndex, bIndex) {
    if (aIndex === bIndex) return 'same';
    const a = solid.topology.edges[aIndex], b = solid.topology.edges[bIndex];
    if (a.some(v => b.includes(v))) return 'intersecting';
    const [a0,a1] = a.map(v => solid.vertices[v]);
    const [b0,b1] = b.map(v => solid.vertices[v]);
    const u = vec3Sub(a1,a0), v = vec3Sub(b1,b0), cross = vec3Cross(u,v);
    if (vec3Length(cross) < 1e-7) return 'parallel';
    const triple = Math.abs(vec3Dot(vec3Sub(b0,a0), cross));
    return triple > 1e-7 ? 'skew' : 'coplanar';
  }
  function relationKorean(relation) {
    return ({intersecting:'만나는 위치',parallel:'평행한 위치',skew:'꼬인 위치',coplanar:'한 평면 안의 위치',same:'같은 모서리'})[relation] || relation;
  }
  function makeRelationChallenge(solidId = state.netSolidId) {
    const solid = DATA.solids[solidId];
    const all = solid.topology.edges.map((_,i)=>i);
    let baseEdgeIndex = 0;
    let skew = all.filter(i => edgeRelation(solid,baseEdgeIndex,i)==='skew');
    if (!skew.length) {
      baseEdgeIndex = all.find(i => all.some(j => edgeRelation(solid,i,j)==='skew')) || 0;
      skew = all.filter(i => edgeRelation(solid,baseEdgeIndex,i)==='skew');
    }
    const intersecting = all.filter(i => edgeRelation(solid,baseEdgeIndex,i)==='intersecting');
    const parallel = all.filter(i => edgeRelation(solid,baseEdgeIndex,i)==='parallel');
    const answerIndex = skew[0];
    const options = [answerIndex, intersecting[0], parallel[0], skew[1] ?? all.find(i=>i!==baseEdgeIndex && ![answerIndex,intersecting[0],parallel[0]].includes(i))]
      .filter(Number.isInteger).filter((v,i,a)=>a.indexOf(v)===i);
    state.relationChallenge = { baseEdgeIndex, answerIndex, options, relation:'skew' };
    state.relationChoice = null;
    state.relationRevealed = false;
  }

  function chooseEdgeChallenge() {
    const net = currentNet();
    const available = Object.entries(net.edge_pairs).filter(([edgeId]) => !state.edgeSolved.has(edgeId));
    const pool = available.length ? available : Object.entries(net.edge_pairs);
    if (!available.length) state.edgeSolved.clear();
    const [edgeId, copies] = pool[Math.floor(Math.random() * pool.length)];
    state.edgeTargetId = edgeId;
    state.edgeSeedCopy = copies[Math.floor(Math.random() * 2)];
    state.edgeWrongCopy = null;
  }

  function chooseVertexChallenge() {
    const net = currentNet();
    const groups = {};
    net.corners.forEach(c => (groups[c.solid_vertex_id] ||= []).push(c));
    const ids = Object.keys(groups);
    const target = ids[Math.floor(Math.random() * ids.length)];
    const seed = groups[target][Math.floor(Math.random() * groups[target].length)];
    state.vertexTargetId = target;
    state.vertexSeedCorner = seed.corner_id;
    state.vertexSelected = new Set([seed.corner_id]);
    state.vertexWrongCorner = null;
  }

  function svgFixedLabel(text, x, y, className, spacing = 0.105) {
    const chars = [...String(text)];
    const start = -(chars.length - 1) * spacing * 0.5;
    return `<g class="${className}-group" role="img" aria-label="${text}">${chars.map((char, index) => `<text class="${className}" x="${x + start + index * spacing}" y="${y}">${char}</text>`).join('')}</g>`;
  }

  function netCornerLabelPosition(net, corner, amount = .19) {
    const faceIndex = Number(corner.face_id?.slice(1)) - 1;
    const face = (net.faces || []).find(item => item.face_id === corner.face_id) || (net.faces || [])[faceIndex];
    const points = face?.points || [];
    if (!points.length) return [corner.point[0] + .07, corner.point[1] + .07];
    const center = points.reduce((sum, point) => [sum[0] + point[0], sum[1] + point[1]], [0,0]).map(value => value / points.length);
    return [lerp(corner.point[0], center[0], amount), lerp(corner.point[1], center[1], amount)];
  }

  function netPointRecords(net) {
    const cornerTokens = netCornerTokenMap(net);
    const groups = new Map();
    (net?.corners || []).forEach(corner => {
      const key = netPointKey(corner);
      if (!groups.has(key)) groups.set(key, { key, point: corner.point, token: cornerTokens.get(corner.corner_id), corners: [] });
      groups.get(key).corners.push(corner);
    });
    return [...groups.values()].sort((a,b) => cornerAlphabetRank(a.token) - cornerAlphabetRank(b.token));
  }

  function renderNetSVG(net, mode = 'autoplay', generated = null) {
    if (generated) return renderGeneratedNetSVG(generated);
    const solid = DATA.solids[state.netSolidId];
    const faceMarkup = net.faces.map(face => `<polygon class="net-face" points="${svgPointString(face.points)}"></polygon>`).join('');
    const foldLineMarkup = net.hinges.map(item => `<line class="net-hinge" x1="${item.points[0][0]}" y1="${-item.points[0][1]}" x2="${item.points[1][0]}" y2="${-item.points[1][1]}"></line>`).join('');
    const boundaryMarkup = net.boundary_edge_copies.map(copy => `<line class="net-boundary" aria-hidden="true" x1="${copy.points[0][0]}" y1="${-copy.points[0][1]}" x2="${copy.points[1][0]}" y2="${-copy.points[1][1]}"></line>`).join('');
    const pointMarkup = netPointRecords(net).map(record => {
      const labelCandidates = record.corners.map(corner => netCornerLabelPosition(net, corner, .22));
      const labelPoint = labelCandidates.reduce((sum,p) => [sum[0]+p[0],sum[1]+p[1]],[0,0]).map(value => value / labelCandidates.length);
      return `<g aria-hidden="true"><circle class="net-corner" cx="${record.point[0]}" cy="${-record.point[1]}" r="0.07"></circle>${svgFixedLabel(record.token,labelPoint[0],-labelPoint[1],'net-vertex-label',.085)}</g>`;
    }).join('');
    return `<svg id="netSvg" class="net-svg" viewBox="${netBounds(net)}" role="img" aria-label="${solid.korean_name}의 ${net.variant_label || '전개도'}. 실제로 보이는 평면 꼭짓점마다 알파벳 하나만 표시했습니다.">${faceMarkup}${foldLineMarkup}${boundaryMarkup}${pointMarkup}</svg>`;
  }

  function renderGeneratedNetSVG(generated) {
    const allPts=generated.faces.flatMap(face=>face.points),xs=allPts.map(p=>p[0]),ys=allPts.map(p=>-p[1]),pad=.35;
    const view=`${Math.min(...xs)-pad} ${Math.min(...ys)-pad} ${Math.max(...xs)-Math.min(...xs)+pad*2} ${Math.max(...ys)-Math.min(...ys)+pad*2}`;
    let k=0;
    return `<svg class="net-svg" viewBox="${view}" role="img" aria-label="선택한 모서리를 잘라 만든 정육면체 전개도. 꼭짓점 알파벳만 표시합니다.">${generated.faces.map(face=>{
      const polygon=`<polygon class="net-face" points="${svgPointString(face.points)}"></polygon>`;
      const center=face.points.reduce((sum,point)=>[sum[0]+point[0],sum[1]+point[1]],[0,0]).map(value=>value/face.points.length);
      const labels=face.points.map(point=>{const token=cornerAlphabetToken(k++);const lp=[lerp(point[0],center[0],.19),lerp(point[1],center[1],.19)];return `<circle class="net-corner" cx="${point[0]}" cy="${-point[1]}" r="0.055"></circle>${svgFixedLabel(token,lp[0],-lp[1],'net-vertex-label',.068)}`;}).join('');
      return polygon+labels;
    }).join('')}</svg>`;
  }

  function attachNetSVGEvents() {
    const net = currentNet();
    const solid = DATA.solids[state.netSolidId];
    if (state.netMode === 'edge') {
      $$('[data-copy-id]', refs.right).forEach(group => group.addEventListener('click', () => {
        const copyId = group.dataset.copyId, edgeId = group.dataset.edgeId;
        const edgeName = publicEdgeFromInternal(solid, edgeId, true);
        if (copyId === state.edgeSeedCopy) { announce('파란 모서리의 짝이 될 다른 경계 모서리를 선택하세요.'); return; }
        if (edgeId === state.edgeTargetId) {
          state.edgeSolved.add(edgeId);
          state.edgeWrongCopy = null;
          announce(`${edgeName}의 두 경계 복사본이 접힌 뒤 하나의 모서리가 됩니다.`);
          chooseEdgeChallenge();
        } else {
          state.edgeWrongCopy = copyId;
          announce(`${edgeName}은 파란 모서리와 만나지 않습니다. 지나가는 면의 순서를 다시 따라가 보세요.`);
        }
        updateNetRightOnly();
      }));
    }
    if (state.netMode === 'vertex') {
      $$('.net-corner', refs.right).forEach(circle => circle.addEventListener('click', () => {
        const cornerId = circle.dataset.cornerId, vertexId = circle.dataset.vertexId;
        const vertexName = publicVertexFromInternal(solid, vertexId, true);
        if (cornerId === state.vertexSeedCorner) return;
        if (vertexId === state.vertexTargetId) {
          state.vertexSelected.add(cornerId);
          state.vertexWrongCorner = null;
          const groupSize = net.corners.filter(c => c.solid_vertex_id === state.vertexTargetId).length;
          if (state.vertexSelected.size === groupSize) {
            announce(`${vertexName}으로 합쳐지는 전개도의 모든 모서리 끝점을 찾았습니다.`);
            chooseVertexChallenge();
          } else announce(`맞습니다. ${vertexName}으로 모일 다른 끝점도 찾아보세요.`);
        } else {
          state.vertexWrongCorner = cornerId;
          announce(`${vertexName}은 다른 입체 꼭짓점이 됩니다. 연결된 면을 따라 다시 확인하세요.`);
        }
        updateNetRightOnly();
      }));
    }
  }

  /* Grade by the mathematical relation, not by one canonical edge index:
     makeRelationChallenge can offer a second skew edge as a distractor, and a
     student who names it has answered the question correctly. */
  function relationChoiceIsCorrect() {
    const challenge = state.relationChallenge;
    if (!challenge || !Number.isInteger(state.relationChoice)) return false;
    return edgeRelation(DATA.solids[state.netSolidId], challenge.baseEdgeIndex, state.relationChoice) === challenge.relation;
  }

  function relationPanelHTML() {
    if (!state.relationChallenge) makeRelationChallenge(state.netSolidId);
    const solid = DATA.solids[state.netSolidId];
    const challenge = state.relationChallenge;
    const baseName = publicEdgeName(solid, challenge.baseEdgeIndex, makeLocalVertexMap(solid));
    const choiceRelation = Number.isInteger(state.relationChoice) ? edgeRelation(solid, challenge.baseEdgeIndex, state.relationChoice) : null;
    const answerName = publicEdgeName(solid, challenge.answerIndex, makeLocalVertexMap(solid));
    const feedback = !state.relationRevealed
      ? '<div class="relation-result"><strong>아직 확인 전</strong><br><span class="small-note">전개도의 면 위치와 접는 선을 따라 먼저 예측하세요.</span></div>'
      : `<div class="relation-result"><strong>${relationChoiceIsCorrect() ? '예측이 맞았습니다.' : '조립 결과를 다시 비교하세요.'}</strong><br>${Number.isInteger(state.relationChoice) ? `${publicEdgeName(solid, state.relationChoice, makeLocalVertexMap(solid))}은(는) ${relationKorean(choiceRelation)}입니다. ` : ''}${answerName}은(는) ${baseName}과 꼭짓점을 공유하지 않고, 평행하지 않으며, 같은 평면에 함께 놓이지 않아 <strong>꼬인 위치</strong>입니다.</div>`;
    return `<section class="panel-section"><h3>전개도만 보고 위치 관계 예측</h3>
      <p class="small-note">공간에서 두 직선의 위치 관계 활동입니다.</p>
      <div class="relation-map">
        <div class="relation-prompt"><strong>${baseName}과 조립 후 꼬인 위치가 되는 모서리는?</strong><p class="small-note">꼬인 위치: 만나지 않고, 평행하지 않고, 한 평면 위에도 함께 놓이지 않는 두 모서리</p></div>
        <div class="relation-options">${challenge.options.map(edgeIndex => `<button class="choice-button ${state.relationChoice === edgeIndex ? 'is-active' : ''}" data-relation-edge="${edgeIndex}" type="button">${publicEdgeName(solid, edgeIndex, makeLocalVertexMap(solid))}</button>`).join('')}</div>
        <div class="inline-actions"><button id="relationHintButton" class="action-button" type="button">전개도 추론 힌트</button><button id="relationVerifyButton" class="action-button primary" type="button">조립하여 확인</button><button id="relationNewButton" class="action-button" type="button">다음 문제</button></div>
        <div id="relationHint" class="small-note">먼저 ${baseName}의 양 끝 꼭짓점과 같은 면에 놓인 모서리를 지워 보세요.</div>
        ${feedback}
      </div>
    </section>`;
  }

  function attachRelationEvents() {
    $$('[data-relation-edge]', refs.left).forEach(button => button.addEventListener('click', () => {
      state.relationChoice = Number(button.dataset.relationEdge);
      state.relationRevealed = false;
      updateRelationPanel();
      announce(`${button.textContent.trim()}을 예측으로 선택했습니다.`);
    }));
    $('#relationHintButton', refs.left)?.addEventListener('click', () => {
      const solid = DATA.solids[state.netSolidId];
      const c = state.relationChallenge;
      const base = solid.topology.edges[c.baseEdgeIndex];
      const faces = solid.topology.edge_incident_faces[c.baseEdgeIndex].map(fi => publicFaceName(solid, fi, makeLocalVertexMap(solid)));
      $('#relationHint', refs.left).innerHTML = `<strong>1단계:</strong> ${publicEdgeName(solid,c.baseEdgeIndex,makeLocalVertexMap(solid))}과 꼭짓점을 공유하는 모서리는 ‘만나는 위치’라서 제외합니다.<br><strong>2단계:</strong> 방향이 나란한 모서리는 ‘평행한 위치’라서 제외합니다.<br><strong>3단계:</strong> 남은 후보가 ${faces.join(' 또는 ')}와 접히며 서로 다른 면 방향을 갖는지 따라가 보세요.`;
      announce('전개도 추론 힌트를 열었습니다. 정답 모서리는 아직 공개하지 않았습니다.');
    });
    $('#relationVerifyButton', refs.left)?.addEventListener('click', () => {
      if (!Number.isInteger(state.relationChoice)) { announce('먼저 모서리 하나를 예측으로 선택하세요.'); return; }
      state.relationRevealed = true;
      state.foldProgress = 1;
      updateRelationPanel();
      applyFoldProgress(1, { announceChange: false, syncSlider: true });
      renderer.setRelationEdgeHighlights([state.relationChallenge.baseEdgeIndex, state.relationChallenge.answerIndex]);
      announce(relationChoiceIsCorrect() ? '조립 결과, 꼬인 위치 예측이 맞았습니다.' : '조립 결과에서 파란 모서리와 분홍 모서리의 꼬인 위치를 확인하세요.');
    });
    $('#relationNewButton', refs.left)?.addEventListener('click', () => {
      makeRelationChallenge(state.netSolidId);
      state.foldProgress = 0;
      updateRelationPanel();
      applyFoldProgress(0, { announceChange: false, syncSlider: true });
      renderer.setRelationEdgeHighlights([]);
      announce('새 위치 관계 문제를 만들었습니다.');
    });
  }

  function updateRelationPanel() {
    const host = $('#relationPanelHost', refs.left);
    if (!host) return;
    host.innerHTML = relationPanelHTML();
    attachRelationEvents();
  }

  function startRelationQuiz() {
    stopFoldPlayback();
    state.netMode = 'relation';
    makeRelationChallenge(state.netSolidId);
    if (refs.foldStageBadge) refs.foldStageBadge.hidden = true;
    renderer.setLabelMode('none');
    renderer.setRelationEdgeHighlights([]);
    setInteractionUI('navigate');
    renderer.onPick = null;
    refs.left.innerHTML = `
      <section class="panel-section"><h2>두 모서리의 위치 관계</h2>
        <div class="callout"><strong>목표</strong>전개도만 보고 조립 뒤 꼬인 위치가 되는 모서리를 예측한 다음, 실제로 조립해 확인하세요.</div>
        <div class="button-stack"><button id="backFromRelationButton" class="action-button" type="button">전개도 조립으로 돌아가기</button></div>
      </section>
      <div id="relationPanelHost"></div>`;
    updateRelationPanel();
    r009EnsureEvidenceButton();
    state.foldProgress = 0;
    applyFoldProgress(0, { announceChange: false, syncSlider: false });
    $('#backFromRelationButton', refs.left)?.addEventListener('click', () => {
      state.netMode = 'autoplay';
      renderer.setRelationEdgeHighlights([]);
      renderCurrentTab();
      announce('전개도 조립 화면으로 돌아왔습니다.');
    });
    announce('두 모서리의 위치 관계를 예측하는 활동을 시작했습니다.');
  }

  function updateNetRightOnly() {
    const net = currentNet();
    const solid = DATA.solids[state.netSolidId];
    const variants = netVariantsFor(state.netSolidId);
    const isCube = state.netSolidId === 'PLATONIC_CUBE';
    const typeNote = isCube
      ? '회전하거나 뒤집어서 같아지는 모양은 하나로 세어, 서로 다른 11개를 제공합니다.'
      : `서로 다른 평면 모양의 검증된 예시 ${variants.length}개입니다. 이 수를 전체 개수라고 주장하지 않습니다.`;
    const pointCount = net.validation?.distinct_net_point_count ?? netPointRecords(net).length;
    refs.right.innerHTML = `
      <section class="panel-section"><h2>${solid.korean_name} · ${net.variant_label || '전개도'}</h2>
        <div class="net-shape-meta"><strong>전개도 종류 ${state.netVariantIndex + 1}/${variants.length}</strong><span>${typeNote}</span><span>조립 순서는 이 전개도를 설명하기 위한 기본 경로 1개이며, 새 전개도 종류로 세지 않습니다.</span></div>
        <div class="net-svg-wrap">${renderNetSVG(net)}</div>
      </section>
      <section class="panel-section"><div class="section-result-grid">
        <div class="section-result-card"><span>면</span><b>${net.faces.length}</b></div>
        <div class="section-result-card"><span>펼친 점</span><b>${pointCount}</b></div>
        <div class="section-result-card"><span>접는 단계</span><b>${Math.max(0,net.faces.length-1)}</b></div>
      </div></section>
      <section class="panel-section"><h3>꼭짓점 문자를 읽는 법</h3>
        <p>처음에는 실제 평면 점 하나에 문자 하나만 붙습니다. 조립 중 서로 떨어져 있던 점이 실제로 닿은 뒤에만 두 문자가 한 점의 이름으로 합쳐집니다.</p>
        <div class="callout success"><strong>관찰 포인트</strong>투명하게 남은 전개도와 움직이는 면을 함께 보며, 접근하는 두 점과 이미 닿은 점을 구분하세요.</div>
      </section>`;
    refreshUniversalMapping({ force: true });
  }

