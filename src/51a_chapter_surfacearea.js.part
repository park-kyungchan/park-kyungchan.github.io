/* ===== P1-3 chapter 6 — 겉넓이 ===== */
/* Every number, expression and formula shown here is read from
   window.P003_MEASURE.surface_area. Nothing in this chapter re-derives an area:
   the spec `value` is the arithmetic authority and `expr` is the display form. */
  const P13_MEASURE = window.P003_MEASURE || { surface_area:{cases:[]}, volume:{cases:[],relations:[]} };
  const P13_REV_PROFILE = Object.freeze({ R009_CYLINDER:'cylinder', R009_CONE:'cone', R009_SPHERE:'sphere', R009_FRUSTUM:'frustum' });
  const P13_TAU = Math.PI * 2;
  const P13_SVG_SPAN = 1000;
  const P13_ORDINALS = Object.freeze(['', '첫 번째', '두 번째', '세 번째']);
  const P13_DIM_LABELS = Object.freeze({
    n:'밑면의 변의 수', base_edge:'밑면 한 변 a', top_edge:'윗면 한 변 b', height:'높이 h',
    radius:'반지름 r', base_radius:'밑면 반지름 r', bottom_radius:'아랫면 반지름 R', top_radius:'윗면 반지름 r',
  });
  const P13_MEASURE_LABELS = Object.freeze({
    base_area:'밑넓이', top_area:'윗면 넓이', base_area_total:'밑넓이의 합', lateral_area:'옆넓이',
    total_area:'겉넓이', slant_height:'모선의 길이 ℓ', base_apothem:'밑면 중심에서 한 변까지', height:'높이', volume:'부피',
  });

  /* ---------- shared 2D helpers (also used by the 부피 chapter) ---------- */
  function p13Arc(cx, cy, radius, a0, a1, segments = 48) {
    const points = [];
    for (let i = 0; i <= segments; i++) { const a = a0 + (a1 - a0) * i / segments; points.push([cx + radius * Math.cos(a), cy + radius * Math.sin(a)]); }
    return points;
  }
  function p13Circle(cx, cy, radius) { return p13Arc(cx, cy, radius, 0, P13_TAU * 62 / 64, 62); }
  function p13Sector(cx, cy, radius, a0, a1) { return [[cx, cy], ...p13Arc(cx, cy, radius, a0, a1)]; }
  function p13RingSector(cx, cy, inner, outer, a0, a1) { return [...p13Arc(cx, cy, outer, a0, a1), ...p13Arc(cx, cy, inner, a1, a0)]; }
  function p13Rect(x, y, w, h) { return [[x, y], [x + w, y], [x + w, y + h], [x, y + h]]; }
  function p13Polygon(n, radius, cx, cy, rotation = 0) {
    const points = [];
    for (let i = 0; i < n; i++) { const a = rotation + P13_TAU * i / n; points.push([cx + radius * Math.cos(a), cy + radius * Math.sin(a)]); }
    return points;
  }
  function p13Centroid(points) {
    const sum = points.reduce((acc, p) => [acc[0] + p[0], acc[1] + p[1]], [0, 0]);
    return [sum[0] / points.length, sum[1] / points.length];
  }
  function p13BuildSVG(groups, { pad = .12 } = {}) {
    const xs = [], ys = [];
    groups.forEach(group => {
      (group.shapes || []).forEach(shape => shape.points.forEach(point => { xs.push(point[0]); ys.push(point[1]); }));
      (group.texts || []).forEach(text => { xs.push(text.x); ys.push(text.y); });
    });
    if (!xs.length) return '';
    const minX = Math.min(...xs), maxX = Math.max(...xs), minY = Math.min(...ys), maxY = Math.max(...ys);
    const w = Math.max(1e-3, maxX - minX), h = Math.max(1e-3, maxY - minY), span = Math.max(w, h);
    /* The model units are around 1..10, and an inherited px letter-spacing would then
       dwarf the glyph advance. Emit the drawing scaled into a ~1000 unit viewBox so
       every font-size stays far larger than any inherited absolute spacing. */
    const k = P13_SVG_SPAN / span, margin = P13_SVG_SPAN * pad;
    const stroke = P13_SVG_SPAN / 240, size = P13_SVG_SPAN / 26;
    const num = value => Number(value).toFixed(2);
    const body = groups.map(group => {
      const shapes = (group.shapes || []).map(shape => `<polygon class="${shape.cls || ''}" points="${shape.points.map(p => `${num(p[0] * k)},${num(p[1] * k)}`).join(' ')}" stroke-width="${(stroke * (shape.weight || 1)).toFixed(2)}"${shape.dash ? ` stroke-dasharray="${(stroke * 5).toFixed(2)} ${(stroke * 4).toFixed(2)}"` : ''}/>`).join('');
      const texts = (group.texts || []).map(text => `<text class="${text.cls || 'p13-svg-text'}" x="${num(text.x * k)}" y="${num(text.y * k)}" font-size="${(size * (text.size || 1)).toFixed(2)}" text-anchor="${text.anchor || 'middle'}">${escapeHTML(text.text)}</text>`).join('');
      const move = group.move ? `translate(${num(group.move[0] * k)},${num(group.move[1] * k)})` : '';
      const spin = group.rotate ? `rotate(${group.rotate[0].toFixed(2)},${num(group.rotate[1] * k)},${num(group.rotate[2] * k)})` : '';
      const transform = [move, spin].filter(Boolean).join(' ');
      return `<g class="${group.cls || ''}"${transform ? ` transform="${transform}"` : ''}>${shapes}${texts}</g>`;
    }).join('');
    return `<svg class="p13-svg" viewBox="${num(minX * k - margin)} ${num(minY * k - margin)} ${num(w * k + 2 * margin)} ${num(h * k + 2 * margin)}" preserveAspectRatio="xMidYMid meet" role="img" aria-hidden="true">${body}</svg>`;
  }
  function p13StagePanel(label, inner) {
    let root = $('#p13StagePanel');
    if (!root) { root = document.createElement('aside'); root.id = 'p13StagePanel'; root.className = 'p13-stage-panel'; refs.stage.appendChild(root); }
    root.hidden = false;
    root.innerHTML = `<p class="p13-stage-panel-label">${escapeHTML(label)}</p><div class="p13-stage-panel-body">${inner}</div>`;
    return root;
  }
  function p13HideStagePanel() { const root = $('#p13StagePanel'); if (root) { root.hidden = true; root.innerHTML = ''; } }
  function p13SolidLabel(solidId) {
    if (DATA.solids[solidId]) return DATA.solids[solidId].korean_name;
    const profile = P13_REV_PROFILE[solidId];
    return profile ? R009_EXACT.revolution_profiles[profile].label : solidId;
  }
  /* Family solids use the standard setSolid pipeline with the 밑면·옆면 tints;
     solids of revolution reuse the complete-solid lathe path that renderRevSections
     draws at sweep = 1. */
  function p13ShowSolid(solidId, { resetView = false } = {}) {
    const profile = P13_REV_PROFILE[solidId];
    showModuleOverlay(false);
    renderer.setInteractionMode('navigate');
    setInteractionUI('navigate');
    renderer.onPick = null;
    if (profile) {
      renderer.faceTints = null;
      const mesh = r9LatheFaces(profile, 1, { segments: 84 });
      r9ApplyCustomScene({ faces: mesh.faces, viewStyle: 'solid', hideMeshEdges: true, resetView });
      return;
    }
    renderer.r009SmoothScene = false;
    const solid = DATA.solids[solidId];
    if (resetView) renderer.resetView('solid');
    renderer.setSolid(solidId);
    renderer.setSelectionType('face');
    renderer.setPublicLabelMap(makeLocalVertexMap(solid));
    renderer.setLabelMode('none');
    renderer.setViewStyle('solid');
    renderer.setFaceTints(baseLateralTints(solid));
  }
  function p13DimLine(dims) {
    return Object.entries(dims || {}).filter(([key]) => P13_DIM_LABELS[key])
      .map(([key, value]) => `${P13_DIM_LABELS[key]} ${r9fmt(value)}`).join(' · ');
  }
  function p13MeasureList(item, keys) {
    return keys.filter(key => item[key] && typeof item[key] === 'object' && 'expr' in item[key])
      .map(key => `<li><strong>${escapeHTML(P13_MEASURE_LABELS[key] || key)}</strong>: ${escapeHTML(item[key].expr)} ≈ ${escapeHTML(r9fmt(item[key].value))} <small>(${escapeHTML(item[key].formula)})</small></li>`).join('');
  }

  /* ---------- case selection ---------- */
  function p13SACases() { return P13_MEASURE.surface_area.cases || []; }
  function p13SACase() { return p13SACases().find(item => item.id === state.saCase) || p13SACases()[0]; }
  function p13SAOptions() {
    const group = (scope, label) => {
      const cases = p13SACases().filter(item => item.scope === scope);
      if (!cases.length) return '';
      return `<optgroup label="${label}">${cases.map(item => `<option value="${item.id}" ${item.id === state.saCase ? 'selected' : ''}>${escapeHTML(p13SolidLabel(item.solid))}${scope === 'enrichment' ? ' · 심화' : ''}</option>`).join('')}</optgroup>`;
    };
    return group('core', '기본 과정') + group('enrichment', '심화 탐구');
  }

  /* ---------- prediction: which pieces make up the surface ---------- */
  function p13PieceSetText(entries) { return entries.map(entry => `${entry.label} ${entry.count}개`).join(' + '); }
  function p13PieceSetOptions(item) {
    if (item.family === 'sphere') {
      const radius = item.dims.radius, unit = Math.PI * radius * radius;
      const truth = Math.round(item.total_area.value / unit);
      const counts = [...new Set([2, 3, truth, 6])].sort((a, b) => a - b);
      return counts.map(count => ({ key: `sphere-${count}`, label: `반지름이 같은 원 ${count}개`, correct: count === truth }));
    }
    const truth = item.piece_breakdown.map(piece => ({ label: piece.korean_label, count: piece.count }));
    const bump = index => truth.map((entry, i) => i === index ? { ...entry, count: entry.count > 1 ? entry.count - 1 : entry.count + 1 } : { ...entry });
    const variants = [truth, bump(0), bump(truth.length - 1)];
    if (truth.length > 2) variants.push(bump(1));
    const seen = new Set(), options = [];
    variants.forEach(variant => {
      const label = p13PieceSetText(variant);
      if (seen.has(label)) return;
      seen.add(label);
      options.push({ key: label, label, correct: variant === truth });
    });
    const shift = item.id.length % options.length;
    return options.slice(shift).concat(options.slice(0, shift));
  }

  /* ---------- piece ↔ area expression matching ---------- */
  function p13PolygonAreaText(n, symbol) {
    if (n === 4) return `${symbol} × ${symbol}`;
    if (n === 3) return `(√3/4) × ${symbol}²`;
    return `정${n}각형의 넓이`;
  }
  function p13AreaFormula(item, piece) {
    if (piece.face_kind === 'regular_polygon_base') return p13PolygonAreaText(item.dims.n, 'a');
    if (piece.face_kind === 'regular_polygon_top') return p13PolygonAreaText(item.dims.n, 'b');
    return piece.area_each.formula;
  }
  function p13AreaDistractors(item, piece) {
    const correct = piece.area_each.formula, symbol = correct.includes('R') ? 'R' : 'r';
    switch (piece.face_kind) {
      case 'regular_polygon_base': return [`${item.dims.n} × a`, `(1/2) × a × a`];
      case 'regular_polygon_top': return [`${item.dims.n} × b`, `(1/2) × b × b`];
      case 'rectangle_lateral': return ['a + h', '(1/2) × a × h'];
      case 'rectangle_lateral_development': return ['π r² h', '2 π r + h'];
      case 'isosceles_triangle_lateral': return ['a l', '(1/2) a h'];
      case 'trapezoid_lateral': return ['(a + b) l', '(1/2) a b'];
      case 'circle_base': case 'circle_top': return [`2 π ${symbol}`, `(1/2) π ${symbol}²`];
      case 'sector_lateral_development': return ['π r²', '2 π r l'];
      case 'sector_ring_lateral_development': return ['π (R − r) l', 'π R r l'];
      case 'sphere_surface': return ['2 π r²', '(4/3) π r³'];
      default: return ['(1/2) × 밑변 × 높이', '밑변 + 높이'];
    }
  }
  function p13AreaChoices(item, piece, index) {
    const choices = [p13AreaFormula(item, piece), ...p13AreaDistractors(item, piece)];
    const shift = index % choices.length;
    return choices.slice(shift).concat(choices.slice(0, shift));
  }
  function p13SAMatchedCount(item) { return item.piece_breakdown.filter(piece => state.saMatched[piece.face_kind]).length; }
  function p13SAComplete(item) { return p13SAMatchedCount(item) >= item.piece_breakdown.length; }

  /* ---------- parametric development drawings ---------- */
  function p13DevelopmentPieces(item) {
    const dims = item.dims, gap = .34, pieces = [];
    const push = (faceKind, points, extra = {}) => pieces.push({ faceKind, points, ...extra });
    if (item.family === 'prism') {
      const n = dims.n, a = dims.base_edge, h = dims.height, radius = a / (2 * Math.sin(Math.PI / n));
      for (let i = 0; i < n; i++) push('rectangle_lateral', p13Rect(i * a, 0, a, h), { rot: -8 });
      push('regular_polygon_base', p13Polygon(n, radius, a / 2, -gap - radius, Math.PI / 2 - Math.PI / n), { rot: 14, tag: '윗면' });
      push('regular_polygon_base', p13Polygon(n, radius, a / 2, h + gap + radius, -Math.PI / 2 - Math.PI / n), { rot: -14, tag: '밑면' });
      pieces[0].notes = [{ x: n * a / 2, y: h * .5, text: `가로 = 밑면 둘레`, cls: 'p13-svg-note' }];
      return pieces;
    }
    if (item.family === 'pyramid') {
      const n = dims.n, a = dims.base_edge, slant = item.slant_height.value;
      const radius = a / (2 * Math.sin(Math.PI / n)), apothem = a / (2 * Math.tan(Math.PI / n));
      const base = p13Polygon(n, radius, 0, 0, -Math.PI / 2);
      push('regular_polygon_base', base, { rot: 10, tag: '밑면' });
      for (let i = 0; i < n; i++) {
        const v0 = base[i], v1 = base[(i + 1) % n], mid = [(v0[0] + v1[0]) / 2, (v0[1] + v1[1]) / 2];
        const scale = (apothem + slant) / apothem;
        push('isosceles_triangle_lateral', [v0, v1, [mid[0] * scale, mid[1] * scale]], { rot: -12 });
      }
      pieces[1].notes = [{ x: 0, y: -(apothem + slant) * .62, text: 'ℓ = 옆면의 높이', cls: 'p13-svg-note' }];
      return pieces;
    }
    if (item.family === 'cylinder') {
      const radius = dims.radius, h = dims.height, width = item.lateral_development.width.value;
      push('rectangle_lateral_development', p13Rect(0, 0, width, h), {
        notes: [{ x: width / 2, y: h * .44, text: `가로 = 밑면 둘레 = ${item.lateral_development.width.expr}`, cls: 'p13-svg-note' },
                { x: width / 2, y: h * .74, text: `세로 = 높이 ${item.lateral_development.height.expr}`, cls: 'p13-svg-note' }],
      });
      push('circle_base', p13Circle(width / 2, -gap - radius, radius), { rot: 12, tag: '윗면' });
      push('circle_base', p13Circle(width / 2, h + gap + radius, radius), { rot: -12, tag: '밑면' });
      return pieces;
    }
    if (item.family === 'cone') {
      const radius = dims.base_radius, slant = item.slant_height.value;
      const theta = item.lateral_development.sector_angle_rad.value;
      const a0 = Math.PI / 2 - theta / 2, a1 = Math.PI / 2 + theta / 2;
      push('sector_lateral_development', p13Sector(0, 0, slant, a0, a1), {
        notes: [{ x: 0, y: slant * .92, text: `호의 길이 = 밑면 둘레 = ${item.lateral_development.sector_arc_length.expr}`, cls: 'p13-svg-note' },
                { x: 0, y: slant * .20, text: `중심각 ≈ ${r9fmt(item.lateral_development.sector_angle_deg.value, 1)}°`, cls: 'p13-svg-note' }],
      });
      push('circle_base', p13Circle(0, slant + gap + radius, radius), { rot: -14, tag: '밑면' });
      return pieces;
    }
    if (item.family === 'sphere') {
      const radius = dims.radius, step = 2 * radius + gap;
      for (let i = 0; i < 4; i++) push('sphere_surface', p13Circle((i % 2) * step, Math.floor(i / 2) * step, radius), { rot: i % 2 ? 10 : -10, exprLabel: false, tag: `원 ${i + 1}` });
      pieces[0].notes = [{ x: step / 2, y: -radius - gap * .6, text: `구의 겉넓이 = 반지름이 같은 원 4개 = ${item.total_area.expr}`, cls: 'p13-svg-note' }];
      return pieces;
    }
    if (item.family === 'frustum_pyramid') {
      const n = dims.n, a = dims.base_edge, b = dims.top_edge, slant = item.slant_height.value;
      const bottomR = a / (2 * Math.sin(Math.PI / n)), topR = b / (2 * Math.sin(Math.PI / n));
      for (let i = 0; i < n; i++) {
        const x0 = i * a;
        push('trapezoid_lateral', [[x0, slant], [x0 + a, slant], [x0 + (a + b) / 2, 0], [x0 + (a - b) / 2, 0]], { rot: -8 });
      }
      push('regular_polygon_top', p13Polygon(n, topR, a / 2, -gap - topR, Math.PI / 2 - Math.PI / n), { rot: 14, tag: '윗면' });
      push('regular_polygon_base', p13Polygon(n, bottomR, a / 2, slant + gap + bottomR, -Math.PI / 2 - Math.PI / n), { rot: -14, tag: '아랫면' });
      return pieces;
    }
    const bottom = dims.bottom_radius, top = dims.top_radius, slant = item.slant_height.value;
    const outer = slant * bottom / (bottom - top), inner = slant * top / (bottom - top), theta = P13_TAU * (bottom - top) / slant;
    const a0 = Math.PI / 2 - theta / 2, a1 = Math.PI / 2 + theta / 2;
    push('sector_ring_lateral_development', p13RingSector(0, 0, inner, outer, a0, a1), {
      notes: [{ x: 0, y: outer * .95, text: '바깥 호 = 아랫면 둘레', cls: 'p13-svg-note' },
              { x: 0, y: inner * .82, text: '안쪽 호 = 윗면 둘레', cls: 'p13-svg-note' }],
    });
    push('circle_top', p13Circle(0, -gap - top, top), { rot: 14, tag: '윗면' });
    push('circle_base', p13Circle(0, outer + gap + bottom, bottom), { rot: -14, tag: '아랫면' });
    return pieces;
  }
  const P13_BASE_KINDS = Object.freeze(['regular_polygon_base', 'regular_polygon_top', 'circle_base', 'circle_top']);
  function p13DevelopmentSVG(item, unfold) {
    const pieces = p13DevelopmentPieces(item);
    const all = pieces.flatMap(piece => piece.points);
    const centre = p13Centroid(all);
    const groups = pieces.map(piece => {
      const c = p13Centroid(piece.points), rest = 1 - clamp(unfold, 0, 1);
      const dx = (centre[0] - c[0]) * rest, dy = (centre[1] - c[1]) * rest, rot = (piece.rot || 0) * rest;
      const matched = !!state.saMatched[piece.faceKind];
      const role = P13_BASE_KINDS.includes(piece.faceKind) ? 'is-base' : piece.faceKind === 'sphere_surface' ? 'is-whole' : 'is-lateral';
      const texts = [];
      if (piece.tag) texts.push({ x: c[0], y: c[1], text: piece.tag, cls: 'p13-svg-tag', size: .82 });
      if (matched && piece.exprLabel !== false) {
        const expr = item.piece_breakdown.find(entry => entry.face_kind === piece.faceKind).area_each.expr;
        texts.length = 0;
        texts.push({ x: c[0], y: c[1], text: expr, cls: 'p13-svg-expr' });
      }
      (piece.notes || []).forEach(note => texts.push({ ...note, size: .84 }));
      return {
        cls: `p13-dev-piece ${role}${matched ? ' is-matched' : ''}`,
        move: [dx, dy], rotate: [rot, c[0], c[1]],
        shapes: [{ points: piece.points }], texts,
      };
    });
    return p13BuildSVG(groups);
  }

  function p13ResetSurfaceState() {
    state.saPrediction = null;
    state.saRevealed = false;
    state.saUnfold = 0;
    state.saMatched = {};
    state.saFeedback = null;
    state.saMatchFeedback = null;
  }

  /* ---------- rendering ---------- */
  function p13SurfaceProgress() {
    const item = p13SACase();
    if (!item) return .1;
    if (!state.saRevealed) return state.saPrediction ? .26 : .10;
    const total = item.piece_breakdown.length, done = p13SAMatchedCount(item);
    return done >= total ? 1 : .46 + .42 * (done / total);
  }
  function p13SurfaceGuide() {
    const item = p13SACase();
    if (!item) return null;
    const p = p13SurfaceProgress(), label = p13SolidLabel(item.solid);
    const copy = !state.saRevealed
      ? ['겉면을 이루는 조각을 먼저 예상합니다.', '펼치기 전에 어떤 모양이 몇 개 필요한지 스스로 정하고 고르세요.']
      : !p13SAMatchedCount(item)
        ? ['전개도에서 조각을 확인합니다.', '슬라이더로 펼치고 접으며 각 조각이 입체의 어느 부분이었는지 짚어 보세요.']
        : p13SAComplete(item)
          ? ['조각의 넓이를 모두 더합니다.', '겉넓이는 밑넓이와 옆넓이를 합한 값이며, 정확한 값은 근거 시트에서 확인합니다.']
          : ['조각마다 넓이 식을 맞춥니다.', '각 조각의 모양을 보고 어떤 식으로 넓이를 구하는지 고르세요.'];
    return {
      kicker: `${Math.round(p * 100)}% · ${r009PhaseLabel(p)}`, title: copy[0], body: copy[1],
      chips: [label, `조각 ${item.piece_breakdown.length}종류`, state.saRevealed ? `맞춘 조각 ${p13SAMatchedCount(item)}개` : '예측 먼저'],
    };
  }
  function p13SurfaceEvidence() {
    const item = p13SACase(), label = p13SolidLabel(item.solid);
    const pieces = item.piece_breakdown.map(piece => `<li><strong>${escapeHTML(piece.korean_label)} ${piece.count}개</strong>: 한 조각 ${escapeHTML(piece.area_each.expr)} ≈ ${escapeHTML(r9fmt(piece.area_each.value))} <small>(${escapeHTML(piece.area_each.formula)})</small></li>`).join('');
    refs.right.innerHTML = `<section class="panel-section"><p class="eyebrow">${r009ChapterNo('surfacearea')} · 정확 데이터</p><h2>${escapeHTML(label)}의 겉넓이</h2>
      <div class="callout success"><strong>겉넓이 = ${escapeHTML(item.total_area.expr)} ≈ ${escapeHTML(r9fmt(item.total_area.value))}</strong>${escapeHTML(item.total_area.formula)}</div>
      <ul>${item.dims ? Object.entries(item.dims).filter(([key]) => P13_DIM_LABELS[key]).map(([key, value]) => `<li><strong>${escapeHTML(P13_DIM_LABELS[key])}</strong>: ${escapeHTML(r9fmt(value))}</li>`).join('') : ''}</ul>
      <ul>${p13MeasureList(item, ['slant_height', 'base_apothem', 'base_area', 'top_area', 'base_area_total', 'lateral_area', 'total_area'])}</ul></section>
    <section class="panel-section"><h3>조각별 넓이</h3><ul>${pieces}</ul>${item.note ? `<p class="small-note">${escapeHTML('구는 밑면도 전개도도 없습니다. 겉넓이는 겉면 전체의 넓이입니다.')}</p>` : ''}</section>
    <section class="panel-section"><h3>표시 모델</h3><p>넓이의 값은 측정 데이터의 exact value가 권위이고, 화면의 전개도는 그 수치로 그린 표시 도형입니다. 화면을 재어서 넓이를 구하지 않습니다.</p></section>`;
  }
  function p13DrawSurfaceStage() {
    const item = p13SACase();
    p13ShowSolid(item.solid);
    const kicker = `${r009ChapterNo('surfacearea')} · 겉넓이`;
    r9SetHud({
      kicker, title: `${p13SolidLabel(item.solid)}의 겉면 조각`,
      subtitle: state.saRevealed ? '전개도의 조각 넓이를 모두 더하면 겉넓이가 됩니다.' : '펼치기 전에 어떤 조각이 몇 개 필요한지 먼저 예상하세요.',
      progress: p13SurfaceProgress(),
      legend: [{ cls: 'surface', label: '옆면' }, { cls: 'focus', label: '밑면·윗면' }, { cls: 'plane', label: '펼친 조각' }],
    });
    r9HideInset();
    if (state.saRevealed) p13StagePanel(item.family === 'sphere' ? '구의 겉넓이는 반지름이 같은 원 4개' : '펼친 전개도', p13DevelopmentSVG(item, state.saUnfold));
    else p13HideStagePanel();
    renderer.effectUntil = performance.now() + 190;
    renderer.requestRender();
    R009.lastDraw = () => p13DrawSurfaceStage();
  }
  function p13DrawUnfold(value, announceChange = false) {
    state.saUnfold = clamp(Number(value) || 0, 0, 1);
    const item = p13SACase();
    if (state.saRevealed) p13StagePanel(item.family === 'sphere' ? '구의 겉넓이는 반지름이 같은 원 4개' : '펼친 전개도', p13DevelopmentSVG(item, state.saUnfold));
    r009SetProgressUI('saUnfold', state.saUnfold);
    r009UpdateLiveGuide();
    if (announceChange) announce(`전개도를 ${Math.round(state.saUnfold * 100)}%까지 펼쳤습니다.`);
  }
  function renderSurfaceArea() {
    stopR007Playback();
    const item = p13SACase();
    if (!item) { refs.left.innerHTML = '<section class="panel-section"><h2>겉넓이 데이터를 불러오지 못했습니다.</h2></section>'; return; }
    state.saCase = item.id;
    const options = p13PieceSetOptions(item);
    const matchedCount = p13SAMatchedCount(item), complete = p13SAComplete(item);
    const matchRows = item.piece_breakdown.map((piece, index) => {
      const matched = !!state.saMatched[piece.face_kind];
      const choices = p13AreaChoices(item, piece, index);
      const inner = matched
        ? `<div class="p13-match-done"><strong>${escapeHTML(p13AreaFormula(item, piece))}</strong><span>${escapeHTML(piece.area_each.expr)} ≈ ${escapeHTML(r9fmt(piece.area_each.value))}</span></div>`
        : `<div class="p13-choice-column">${choices.map(choice => `<button class="choice-button" type="button" data-sa-area="${escapeHTML(piece.face_kind)}" data-sa-formula="${escapeHTML(choice)}">${escapeHTML(choice)}</button>`).join('')}</div>`;
      return `<div class="p13-match-row"><p class="p13-match-title">${escapeHTML(piece.korean_label)} ${piece.count}개</p>${inner}</div>`;
    }).join('');
    refs.left.innerHTML = `<section class="panel-section"><p class="eyebrow">${r009ChapterNo('surfacearea')} · 겉넓이</p><h2>전개도의 조각을 모아 겉넓이 구하기</h2>
      <p>겉넓이는 입체의 겉면을 이루는 모든 조각의 넓이를 더한 값입니다. 먼저 어떤 조각이 필요한지 예상하고, 펼쳐서 확인한 뒤 넓이를 계산합니다.</p>
      <label class="control-label" for="saCaseSelect">겉넓이를 구할 입체</label><select id="saCaseSelect">${p13SAOptions()}</select>
      <div class="r009-status-line">${escapeHTML(p13DimLine(item.dims))}</div></section>
    <section class="panel-section"><h3>1. 겉넓이에 필요한 조각 고르기</h3>
      <p class="small-note">이 입체의 겉면을 펼치면 어떤 조각이 몇 개 나올까요? 고르기 전에는 전개도가 열리지 않습니다.</p>
      <div class="p13-choice-column" role="group" aria-label="겉면을 이루는 조각 예측">${options.map(option => `<button class="choice-button ${state.saPrediction === option.key ? 'is-active' : ''}" type="button" data-sa-piece-set="${escapeHTML(option.key)}">${escapeHTML(option.label)}</button>`).join('')}</div>
      ${state.saFeedback ? `<div class="callout ${state.saRevealed ? 'success' : ''}"><strong>${escapeHTML(state.saFeedback)}</strong></div>` : ''}</section>
    ${state.saRevealed ? `<section class="panel-section"><h3>2. 전개도 펼쳐 보기</h3>
      <div class="r009-control-row"><span>접힘</span><input id="saUnfold" type="range" min="0" max="1" step="0.01" value="${state.saUnfold}" aria-label="전개도 펼침 진행률"><output id="saUnfoldValue" class="progress-value">${Math.round(state.saUnfold * 100)}%</output></div>
      <div class="r009-play-row"><button id="saUnfoldPlay" class="action-button primary" type="button" aria-pressed="false">▶ 자동재생</button><button id="saUnfoldFold" class="quiet-button" type="button">모으기</button><button id="saUnfoldOpen" class="quiet-button" type="button">펼치기</button></div>
      <p class="small-note">${escapeHTML(item.family === 'sphere' ? '구는 평면으로 펼칠 수 없습니다. 대신 반지름이 같은 원 4개와 겉넓이가 같다는 사실을 실험으로 확인합니다.' : '가운데 화면의 조각이 입체의 어느 부분이었는지 짚어 보세요.')}</p></section>
    <section class="panel-section"><h3>3. 조각과 넓이 식 맞추기</h3>${matchRows}
      ${state.saMatchFeedback ? `<div class="callout"><strong>${escapeHTML(state.saMatchFeedback)}</strong></div>` : ''}
      ${complete ? `<div class="callout success"><strong>겉넓이 = ${escapeHTML(item.total_area.expr)} ≈ ${escapeHTML(r9fmt(item.total_area.value))}</strong>${escapeHTML(item.total_area.formula)}</div>` : `<p class="small-note">조각 ${matchedCount}/${item.piece_breakdown.length}개를 맞췄습니다. 모두 맞추면 합계가 나타납니다.</p>`}</section>` : ''}`;
    p13SurfaceEvidence();
    p13DrawSurfaceStage();
    $('#saCaseSelect', refs.left).addEventListener('change', event => {
      stopR007Playback();
      state.saCase = event.target.value;
      p13ResetSurfaceState();
      renderer.resetView('solid');
      renderSurfaceArea();
      announce(`${p13SolidLabel(p13SACase().solid)}의 겉넓이 탐구로 바꿨습니다.`);
    });
    $$('[data-sa-piece-set]', refs.left).forEach(button => button.addEventListener('click', () => {
      const option = options.find(entry => entry.key === button.dataset.saPieceSet);
      state.saPrediction = option.key;
      if (option.correct) {
        state.saRevealed = true;
        state.saUnfold = 1;
        state.saFeedback = '조각을 정확히 골랐습니다. 이제 전개도를 펼쳐 확인하세요.';
      } else {
        state.saFeedback = '아직 전개도를 열 수 없습니다. 밑면과 옆면이 각각 몇 개인지 입체를 돌려 다시 세어 보세요.';
      }
      renderSurfaceArea();
      announce(state.saFeedback);
    }));
    $$('[data-sa-area]', refs.left).forEach(button => button.addEventListener('click', () => {
      const kind = button.dataset.saArea, piece = item.piece_breakdown.find(entry => entry.face_kind === kind);
      if (button.dataset.saFormula === p13AreaFormula(item, piece)) {
        state.saMatched = { ...state.saMatched, [kind]: true };
        state.saMatchFeedback = `${piece.korean_label}의 넓이를 맞췄습니다.`;
      } else {
        state.saMatchFeedback = `${piece.korean_label}의 모양을 다시 보세요. 그 식은 이 조각의 넓이를 구하는 식이 아닙니다.`;
      }
      renderSurfaceArea();
      announce(state.saMatchFeedback);
    }));
    $('#saUnfold', refs.left)?.addEventListener('input', event => { stopR007Playback(); p13DrawUnfold(Number(event.target.value)); });
    $('#saUnfoldPlay', refs.left)?.addEventListener('click', () => state.r007Playing ? stopR007Playback({ announceStop: true }) : startR007Playback('saUnfold', p13DrawUnfold, 7));
    $('#saUnfoldFold', refs.left)?.addEventListener('click', () => { stopR007Playback(); p13DrawUnfold(0, true); });
    $('#saUnfoldOpen', refs.left)?.addEventListener('click', () => { stopR007Playback(); p13DrawUnfold(1, true); });
    requestAnimationFrame(() => r009AfterRender());
  }
