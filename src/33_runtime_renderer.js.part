  class PolyRenderer {
    constructor(canvas, labelCanvas) {
      this.canvas = canvas;
      this.labelCanvas = labelCanvas;
      this.labelCtx = labelCanvas.getContext('2d');
      this.gl = FORCE_CANVAS_2D ? null : canvas.getContext('webgl', { antialias: true, alpha: true, preserveDrawingBuffer: true });
      this.available = !!this.gl;
      this.ctx2d = this.available ? null : canvas.getContext('2d');
      this.contextLossCount = 0;
      this.contextRestoreCount = 0;
      this.fov = radians(42);
      this.yaw = -0.58;
      this.pitch = 0.42;
      this.distance = 6.8;
      this.interactionMode = 'navigate';
      this.selectionType = 'face';
      this.viewStyle = 'solid';
      this.labelMode = 'none';
      this.assemblyProgress = null;
      this.selectedFaces = new Set();
      this.selectedEdges = new Set();
      this.selectedVertices = new Set();
      this.countedFaces = new Set();
      this.countedEdges = new Set();
      this.countedVertices = new Set();
      this.cutEdges = new Set();
      this.faceTints = null;
      this.currentSolid = null;
      this.sharedMode = true;
      this.facePolygons = [];
      this.currentVertices = [];
      this.currentFaces = [];
      this.currentEdges = [];
      this.currentFaceIds = [];
      this.currentFaceSideCounts = [];
      this.pointers = new Map();
      this.pointerStart = new Map();
      this.lastPinchDistance = null;
      this.onPick = null;
      this.emptyMessage = '';
      this.overlaySegments = [];
      this.ghostSegments = [];
      this.netGhostPolygons = [];
      this.netGhostMarkers = [];
      this.relationSegments = [];
      this.mergeSegments = [];
      this.vertexMarkers = [];
      this.currentFoldInfo = null;
      this.effectUntil = 0;
      this.soccerProgress = 0;
      this.panelThickness = 0.045;
      this.foldMode = 'guided';
      this.foldPlan = null;
      this.foldStage = foldStageForProgress(0);
      this.publicLabelMap = null;
      if (this.available) this.initWebGL();
      this.renderRequested = false;
      this.bindInteraction();
      canvas.addEventListener('webglcontextlost', event => {
        event.preventDefault();
        this.contextLossCount += 1;
        this.available = false;
        this.ctx2d = null;
        this.requestRender();
      });
      canvas.addEventListener('webglcontextrestored', () => {
        try {
          this.gl = canvas.getContext('webgl', { antialias: true, alpha: true, preserveDrawingBuffer: true });
          this.available = !!this.gl;
          this.ctx2d = null;
          if (this.available) { this.initWebGL(); this.contextRestoreCount += 1; this.uploadGeometry(); }
        } catch (_) { this.available = false; this.ctx2d = null; }
        this.requestRender();
      });
      window.addEventListener('resize', () => this.requestRender(), { passive: true });
      this.requestRender();
    }

    initWebGL() {
      const gl = this.gl;
      const vertexSource = `
        attribute vec3 aPosition;
        attribute vec3 aNormal;
        attribute vec4 aColor;
        uniform mat4 uProjection;
        uniform float uYaw;
        uniform float uPitch;
        uniform float uDistance;
        uniform float uPointSize;
        varying vec3 vNormal;
        varying vec3 vViewPos;
        varying vec4 vColor;
        void main() {
          float cy = cos(uYaw); float sy = sin(uYaw);
          float cx = cos(uPitch); float sx = sin(uPitch);
          vec3 p1 = vec3(cy*aPosition.x + sy*aPosition.z, aPosition.y, -sy*aPosition.x + cy*aPosition.z);
          vec3 p2 = vec3(p1.x, cx*p1.y - sx*p1.z, sx*p1.y + cx*p1.z);
          vec3 n1 = vec3(cy*aNormal.x + sy*aNormal.z, aNormal.y, -sy*aNormal.x + cy*aNormal.z);
          vec3 n2 = vec3(n1.x, cx*n1.y - sx*n1.z, sx*n1.y + cx*n1.z);
          vViewPos = vec3(p2.x, p2.y, p2.z - uDistance);
          gl_Position = uProjection * vec4(vViewPos, 1.0);
          gl_PointSize = uPointSize;
          vNormal = n2;
          vColor = aColor;
        }
      `;
      const fragmentSource = `
        precision mediump float;
        varying vec3 vNormal;
        varying vec3 vViewPos;
        varying vec4 vColor;
        uniform float uUnlit;
        uniform float uPointMode;
        void main() {
          if (uPointMode > 0.5) {
            vec2 d = gl_PointCoord - vec2(0.5);
            if (dot(d,d) > 0.25) discard;
          }
          vec3 n = normalize(vNormal);
          vec3 viewDir = normalize(-vViewPos);
          vec3 keyDir = normalize(vec3(0.36, 0.78, 0.92));
          vec3 fillDir = normalize(vec3(-0.72, 0.18, 0.55));
          float key = max(dot(n, keyDir), 0.0);
          float fill = max(dot(n, fillDir), 0.0);
          float rim = pow(1.0 - max(dot(n, viewDir), 0.0), 2.2);
          vec3 halfDir = normalize(keyDir + viewDir);
          float spec = pow(max(dot(n, halfDir), 0.0), 30.0);
          float shade = 0.34 + 0.54 * key + 0.12 * fill;
          vec3 lit = vColor.rgb * shade + vec3(0.24, 0.56, 0.76) * rim * 0.17 + vec3(1.0) * spec * 0.16;
          lit = mix(lit, vColor.rgb, uUnlit);
          gl_FragColor = vec4(lit, vColor.a);
        }
      `;
      const compile = (type, source) => {
        const shader = gl.createShader(type);
        gl.shaderSource(shader, source);
        gl.compileShader(shader);
        if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(shader));
        return shader;
      };
      const program = gl.createProgram();
      gl.attachShader(program, compile(gl.VERTEX_SHADER, vertexSource));
      gl.attachShader(program, compile(gl.FRAGMENT_SHADER, fragmentSource));
      gl.linkProgram(program);
      if (!gl.getProgramParameter(program, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(program));
      this.program = program;
      this.locations = {
        position: gl.getAttribLocation(program, 'aPosition'),
        normal: gl.getAttribLocation(program, 'aNormal'),
        color: gl.getAttribLocation(program, 'aColor'),
        projection: gl.getUniformLocation(program, 'uProjection'),
        yaw: gl.getUniformLocation(program, 'uYaw'),
        pitch: gl.getUniformLocation(program, 'uPitch'),
        distance: gl.getUniformLocation(program, 'uDistance'),
        pointSize: gl.getUniformLocation(program, 'uPointSize'),
        unlit: gl.getUniformLocation(program, 'uUnlit'),
        pointMode: gl.getUniformLocation(program, 'uPointMode'),
      };
      this.buffers = {
        faces: { position: gl.createBuffer(), normal: gl.createBuffer(), color: gl.createBuffer(), count: 0 },
        edges: { position: gl.createBuffer(), normal: gl.createBuffer(), color: gl.createBuffer(), count: 0 },
        points: { position: gl.createBuffer(), normal: gl.createBuffer(), color: gl.createBuffer(), count: 0 },
      };
      gl.enable(gl.DEPTH_TEST);
      gl.depthFunc(gl.LEQUAL);
      gl.enable(gl.BLEND);
      gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);
      gl.clearColor(0, 0, 0, 0);
      this.canvas.tabIndex = 0;
    }

    bindInteraction() {
      const canvas = this.canvas;
      const resetPointers = () => {
        this.pointers.clear();
        this.pointerStart.clear();
        this.lastPinchDistance = null;
      };
      canvas.addEventListener('pointerdown', (event) => {
        try { canvas.setPointerCapture(event.pointerId); } catch (_) { /* capture may be unavailable in fallback contexts */ }
        this.pointers.set(event.pointerId, { x: event.clientX, y: event.clientY, type: event.pointerType });
        this.pointerStart.set(event.pointerId, { x: event.clientX, y: event.clientY, moved: 0, canceled: false });
        if (this.pointers.size === 2) {
          const pts = [...this.pointers.values()];
          this.lastPinchDistance = Math.hypot(pts[1].x - pts[0].x, pts[1].y - pts[0].y);
        }
        canvas.focus({ preventScroll: true });
      });
      canvas.addEventListener('pointermove', (event) => {
        const prev = this.pointers.get(event.pointerId);
        if (!prev) return;
        const next = { x: event.clientX, y: event.clientY, type: event.pointerType };
        const start = this.pointerStart.get(event.pointerId);
        if (start) start.moved += Math.hypot(next.x - prev.x, next.y - prev.y);
        this.pointers.set(event.pointerId, next);
        if (this.pointers.size >= 2) {
          const pts = [...this.pointers.values()];
          const d = Math.hypot(pts[1].x - pts[0].x, pts[1].y - pts[0].y);
          if (this.lastPinchDistance && d > 2) this.distance = clamp(this.distance * (this.lastPinchDistance / d), 2.5, 14);
          this.lastPinchDistance = d;
        } else if (this.interactionMode === 'navigate') {
          this.yaw += (next.x - prev.x) * 0.008;
          this.pitch = clamp(this.pitch + (next.y - prev.y) * 0.008, -1.42, 1.42);
        }
        this.requestRender();
      });
      const finish = (event, allowPick) => {
        const start = this.pointerStart.get(event.pointerId);
        const pointerCountBefore = this.pointers.size;
        if (allowPick && this.interactionMode === 'select' && start && !start.canceled && start.moved < 12 && pointerCountBefore === 1) {
          const result = this.pick(event.clientX, event.clientY, this.selectionType);
          if (result && this.onPick) this.onPick(result);
        }
        this.pointers.delete(event.pointerId);
        this.pointerStart.delete(event.pointerId);
        if (this.pointers.size < 2) this.lastPinchDistance = null;
      };
      canvas.addEventListener('pointerup', event => finish(event, true));
      canvas.addEventListener('pointercancel', event => {
        const start = this.pointerStart.get(event.pointerId);
        if (start) start.canceled = true;
        finish(event, false);
      });
      canvas.addEventListener('lostpointercapture', event => {
        if (this.pointers.has(event.pointerId)) finish(event, false);
      });
      canvas.addEventListener('pointerleave', event => {
        if (event.buttons === 0 && this.pointers.has(event.pointerId)) finish(event, false);
      });
      window.addEventListener('blur', resetPointers);
      document.addEventListener('visibilitychange', () => { if (document.hidden) resetPointers(); });
      canvas.addEventListener('wheel', (event) => {
        event.preventDefault();
        this.distance = clamp(this.distance * Math.exp(event.deltaY * 0.001), 2.5, 14);
        this.requestRender();
      }, { passive: false });
      canvas.addEventListener('keydown', (event) => {
        const step = 0.09;
        if (event.key === 'ArrowLeft') this.yaw -= step;
        else if (event.key === 'ArrowRight') this.yaw += step;
        else if (event.key === 'ArrowUp') this.pitch = clamp(this.pitch - step, -1.42, 1.42);
        else if (event.key === 'ArrowDown') this.pitch = clamp(this.pitch + step, -1.42, 1.42);
        else if (event.key === '+' || event.key === '=') this.distance = clamp(this.distance - 0.3, 2.5, 14);
        else if (event.key === '-') this.distance = clamp(this.distance + 0.3, 2.5, 14);
        else if (event.key.toLowerCase() === 'r') this.resetView();
        else return;
        event.preventDefault();
        this.requestRender();
      });
    }

    resetView(preset = 'solid') {
      if (preset === 'net') { this.yaw = -0.52; this.pitch = 0.40; this.distance = 7.0; }
      else if (preset === 'soccer') { this.yaw = -0.58; this.pitch = 0.28; this.distance = 7.55; }
      else { this.yaw = -0.58; this.pitch = 0.34; this.distance = 6.8; }
      this.requestRender();
    }

    setEmpty(message = '') {
      this.currentSolid = null;
      this.sharedMode = false;
      this.facePolygons = [];
      this.currentVertices = [];
      this.currentFaces = [];
      this.currentEdges = [];
      this.overlaySegments = [];
      this.ghostSegments = [];
      this.relationSegments = [];
      this.mergeSegments = [];
      this.vertexMarkers = [];
      this.currentFoldInfo = null;
      this.foldPlan = null;
      this.emptyMessage = message;
      this.uploadGeometry();
    }

    setSolid(solidId, { resetView = true } = {}) {
      const solid = DATA.solids[solidId];
      if (!solid) return;
      this.currentSolid = solid;
      this.sharedMode = true;
      this.assemblyProgress = null;
      this.overlaySegments = [];
      this.ghostSegments = [];
      this.netGhostPolygons = [];
      this.netGhostMarkers = [];
      this.relationSegments = [];
      this.mergeSegments = [];
      this.foldPlan = null;
      this.currentFoldInfo = null;
      this.currentVertices = solid.vertices.map(v => [...v]);
      this.currentFaces = solid.faces.map(f => [...f]);
      this.currentEdges = solid.topology.edges.map(e => [...e]);
      this.currentFaceIds = this.currentFaces.map((_, i) => faceIdFromIndex(i));
      this.currentFaceSideCounts = this.currentFaces.map(f => f.length);
      this.facePolygons = this.currentFaces.map((face, fi) => ({
        faceIndex: fi,
        faceId: faceIdFromIndex(fi),
        sideCount: face.length,
        points: face.map(vi => this.currentVertices[vi]),
      }));
      const localMap = makeLocalVertexMap(solid);
      this.vertexMarkers = this.currentVertices.map((point, vertexIndex) => ({
        point,
        vertexIndex,
        solidVertexIndex: vertexIndex,
        label: publicVertexToken(solid, vertexIndex, localMap),
        active: this.selectedVertices.has(vertexIndex) || this.countedVertices.has(vertexIndex),
        showLabel: this.labelMode === 'vertices' || this.labelMode === 'all',
        primaryInGroup: true,
      }));
      this.emptyMessage = '';
      this.clearSelection();
      if (resetView) this.resetView('solid');
      this.uploadGeometry();
    }

    setAssembly(solidId, progress, netOrOptions = null, maybeOptions = {}) {
      const netOverride = netOrOptions && Array.isArray(netOrOptions.faces) ? netOrOptions : null;
      const options = netOverride ? maybeOptions : (netOrOptions || {});
      const plan = buildRigidFoldPlan(solidId, netOverride);
      if (!plan) return;
      const tRaw = clamp(progress, 0, 1);
      const frame = foldFrameForProgress(plan, tRaw);
      this.assemblyProgress = tRaw;
      this.foldMode = 'sequential';
      this.foldPlan = plan;
      this.foldStage = foldStageForProgress(tRaw, plan);
      this.currentFoldInfo = foldMappingInfo(plan, frame);

      const transforms = Array(plan.faces.length);
      transforms[plan.root] = { q: [0, 0, 0, 1], t: [0, 0, 0] };
      const foldLineSegments = [];
      plan.order.slice(1).forEach(child => {
        const parentIndex = plan.parent[child];
        const parentTransform = transforms[parentIndex];
        const link = plan.hingeForFace[child];
        const foldAmount = sequentialHingeProgress(plan, tRaw, child);
        const parentFlatMap = plan.flatMaps[parentIndex];
        const a = rigidTransformPoint(parentTransform, parentFlatMap.get(link.u));
        const b = rigidTransformPoint(parentTransform, parentFlatMap.get(link.v));
        const rotation = rotationAboutLine(a, vec3Sub(b, a), plan.foldAngles[child] * foldAmount);
        transforms[child] = rigidCompose(rotation, parentTransform);
        foldLineSegments.push({
          a: plan.alignPoint(a), b: plan.alignPoint(b), depth: plan.depth[child],
          progress: foldAmount, active: child === frame.faceIndex && frame.phase !== 'hold', faceIndex: child,
        });
      });

      const polygons = plan.net.assembly_faces.map((assemblyFace, faceIndex) => {
        const transform = transforms[faceIndex] || transforms[plan.root];
        const points = assemblyFace.flat_points.map(point => plan.alignPoint(rigidTransformPoint(transform, point)));
        return { faceIndex, faceId: assemblyFace.face_id, sideCount: points.length, points, rigidPanel: true, depth: plan.depth[faceIndex] };
      });

      const flatPolygons = plan.net.assembly_faces.map((assemblyFace, faceIndex) => ({
        faceIndex,
        points: assemblyFace.flat_points.map(point => plan.alignPoint(point)),
        alpha: tRaw <= .001 ? 0 : .15,
      }));
      const cornerTokens = netCornerTokenMap(plan.net);
      const activeFaceIndex = frame.faceIndex;
      const rawMarkers = (plan.net.corners || []).map((corner, orderIndex) => {
        const faceIndex = Number(corner.face_id.slice(1)) - 1;
        const cornerIndex = Number(corner.corner_id.split('-C')[1]) - 1;
        const solidVertexIndex = Number(corner.solid_vertex_id.slice(1)) - 1;
        const point = polygons[faceIndex]?.points?.[cornerIndex] || [0,0,0];
        const originPoint = plan.alignPoint(plan.net.assembly_faces[faceIndex]?.flat_points?.[cornerIndex] || [0,0,0]);
        const movedDistance = vec3Length(vec3Sub(point, originPoint));
        const token = cornerTokens.get(corner.corner_id) || cornerAlphabetToken(orderIndex);
        const sequenceIndex = plan.sequenceIndexByFace.get(faceIndex) ?? -1;
        const faceFoldAmount = faceIndex === plan.root ? 1 : sequentialHingeProgress(plan, tRaw, faceIndex);
        const assembled = faceIndex === plan.root || sequenceIndex < frame.unitIndex;
        const assemblyEligible = faceIndex === plan.root || assembled || (faceIndex === activeFaceIndex && faceFoldAmount > .035);
        return { point, originPoint, movedDistance, faceIndex, cornerIndex, solidVertexIndex,
          solidVertexId: corner.solid_vertex_id, cornerId: corner.corner_id, netPointId: netPointKey(corner),
          token, label: token, sequenceIndex, faceFoldAmount, assemblyEligible,
          active: faceIndex === activeFaceIndex, moving: faceIndex === activeFaceIndex && faceFoldAmount > .015,
          assembled, showLabel: tRaw <= .015 || faceIndex === activeFaceIndex,
          primaryInGroup: true, mergeCandidate: false, merged: false };
      });
      const markerGroupsByNetPoint = new Map();
      rawMarkers.forEach(marker => {
        if (!markerGroupsByNetPoint.has(marker.netPointId)) markerGroupsByNetPoint.set(marker.netPointId, []);
        markerGroupsByNetPoint.get(marker.netPointId).push(marker);
      });
      const markers = [...markerGroupsByNetPoint.values()].map(group => {
        const representative = group.find(marker => marker.active) || group.find(marker => marker.assembled) || group[0];
        return { ...representative,
          active: group.some(marker => marker.active), moving: group.some(marker => marker.moving),
          assembled: group.some(marker => marker.assembled), assemblyEligible: group.some(marker => marker.assemblyEligible),
          showLabel: tRaw <= .015 || group.some(marker => marker.active), cornerIds: group.map(marker => marker.cornerId) };
      });

      const MERGE_DISTANCE = .055;
      const APPROACH_DISTANCE = .58;
      const groups = new Map();
      markers.forEach(marker => {
        if (!groups.has(marker.solidVertexId)) groups.set(marker.solidVertexId, []);
        groups.get(marker.solidVertexId).push(marker);
      });
      const mergeSegments = [];
      const actualMergeNames = [];
      groups.forEach(group => {
        const eligible = group.filter(marker => marker.assemblyEligible);
        const remaining = new Set(eligible);
        while (remaining.size) {
          const seed = remaining.values().next().value;
          remaining.delete(seed);
          const cluster = [seed];
          let expanded = true;
          while (expanded) {
            expanded = false;
            [...remaining].forEach(candidate => {
              const touches = cluster.some(item => item.faceIndex !== candidate.faceIndex && vec3Length(vec3Sub(item.point,candidate.point)) <= MERGE_DISTANCE);
              if (touches) { cluster.push(candidate); remaining.delete(candidate); expanded = true; }
            });
          }
          cluster.sort((a,b)=>cornerAlphabetRank(a.token)-cornerAlphabetRank(b.token));
          if (cluster.length > 1) {
            const primary=cluster[0];primary.label=mergedCornerLabel(cluster.map(item=>item.token));primary.merged=true;primary.showLabel=true;actualMergeNames.push(primary.label);
            cluster.slice(1).forEach(item=>{item.primaryInGroup=false;item.merged=true;});
          }
        }
        const moving = group.find(marker => marker.moving && marker.faceFoldAmount >= .68);
        const targets = group.filter(marker => marker.assemblyEligible && marker !== moving && !marker.moving);
        const target = moving && targets.length ? targets.sort((a,b)=>vec3Length(vec3Sub(moving.point,a.point))-vec3Length(vec3Sub(moving.point,b.point)))[0] : null;
        if (moving && target) {
          const distance=vec3Length(vec3Sub(moving.point,target.point));
          if (distance > MERGE_DISTANCE && distance <= APPROACH_DISTANCE) {
            moving.mergeCandidate=true;target.mergeCandidate=true;moving.mergeRole='moving';target.mergeRole='target';moving.showLabel=true;target.showLabel=true;
            mergeSegments.push({a:moving.point,b:target.point,fromToken:moving.token,toToken:target.token,distance});
          }
        }
      });

      // The transparent original net remains in the central stage. Every original point is
      // retained, while letters are shown only for the currently moving/meeting points to keep
      // the scene readable. The complete A… sequence remains in the integrated net diagram.
      const ghostMarkers = tRaw <= .001 ? [] : markers.map(marker => ({
        point: marker.originPoint,
        label: (marker.active || marker.mergeCandidate) ? marker.token : '',
        alpha: .44,
        active: marker.active || marker.mergeCandidate,
        role: marker.mergeRole || '',
      }));

      this.currentSolid = plan.solid;
      this.sharedMode = false;
      this.facePolygons = polygons;
      this.currentVertices = [];
      this.currentFaces = [];
      this.currentEdges = [];
      this.currentFaceIds = polygons.map(p => p.faceId);
      this.currentFaceSideCounts = polygons.map(p => p.sideCount);
      this.vertexMarkers = markers;
      this.mergeSegments = mergeSegments;
      this.overlaySegments = tRaw >= .999 ? [] : foldLineSegments;
      this.ghostSegments = [];
      this.netGhostPolygons = options.ghost === false ? [] : flatPolygons;
      this.netGhostMarkers = options.ghost === false ? [] : ghostMarkers;
      this.effectUntil = Math.max(this.effectUntil || 0, performance.now() + (mergeSegments.length ? 900 : 260));
      const mergeNames = [...new Set(actualMergeNames)]
        .sort((a,b) => cornerAlphabetRank(a.split('(')[0]) - cornerAlphabetRank(b.split('(')[0]));
      this.currentFoldInfo = {
        ...this.currentFoldInfo,
        mergeVertices: mergeNames,
        mergeText: mergeNames.length ? `${mergeNames.join(' · ')}처럼 같은 점으로 모입니다.` : '이번 면의 꼭짓점 위치를 확인합니다.',
      };
      this.clearSelection();
      this.emptyMessage = '';
      this.uploadGeometry();
    }

    setSoccer(progress, inflated = false) {
      const p = clamp(progress, 0, 1);
      this.soccerProgress = p;
      this.assemblyProgress = null;
      this.overlaySegments = [];
      this.ghostSegments = [];
      this.netGhostPolygons = [];
      this.netGhostMarkers = [];
      this.relationSegments = [];
      this.mergeSegments = [];
      this.foldPlan = null;
      this.currentFoldInfo = null;
      if (p < 0.001) {
        this.setSolid('PLATONIC_ICOSA', { resetView: false });
        this.setLabelMode('vertices');
        return;
      }
      const source = DATA.solids.PLATONIC_ICOSA;
      const target = DATA.solids.ARCH_TRUNC_ICOSA;
      const map = target.lineage.directed_vertex_map;
      const t = p / 3;
      const dynamic = Array(target.vertices.length);
      const lineageByTarget = new Map();
      Object.entries(map).forEach(([key, idx]) => {
        const [u, v] = key.split('>').map(Number);
        const point = source.vertices[u].map((value, axis) => (1 - t) * value + t * source.vertices[v][axis]);
        dynamic[idx] = point;
        lineageByTarget.set(Number(idx), {u,v});
      });
      const maxR = Math.max(...dynamic.map(vec3Length));
      dynamic.forEach((point, i) => {
        let scaled = vec3Scale(point, 1.55 / maxR);
        if (inflated) scaled = vec3Scale(vec3Unit(scaled), 1.62);
        dynamic[i] = scaled;
      });
      this.currentSolid = target;
      this.sharedMode = true;
      this.currentVertices = dynamic;
      this.currentFaces = target.faces.map(f => [...f]);
      this.currentEdges = target.topology.edges.map(e => [...e]);
      this.currentFaceIds = this.currentFaces.map((_, i) => faceIdFromIndex(i));
      this.currentFaceSideCounts = this.currentFaces.map(f => f.length);
      this.facePolygons = this.currentFaces.map((face, fi) => ({ faceIndex: fi, faceId: faceIdFromIndex(fi), sideCount: face.length, points: face.map(vi => dynamic[vi]) }));
      const focusSourceVertex = Math.min(11, Math.floor(p * 12));
      const focusTargets = [...lineageByTarget.entries()].filter(([,lineage]) => lineage.u === focusSourceVertex).map(([idx]) => idx);
      this.vertexMarkers = dynamic.map((point, vertexIndex) => ({
        point, vertexIndex, solidVertexIndex: vertexIndex,
        label: focusTargets.includes(vertexIndex) ? cornerAlphabetToken(focusTargets.indexOf(vertexIndex)) : '',
        active: focusTargets.includes(vertexIndex),
        showLabel: focusTargets.includes(vertexIndex),
        primaryInGroup: true,
        mergeCandidate: false,
      }));
      this.effectUntil = Math.max(this.effectUntil || 0, performance.now() + 320);
      this.emptyMessage = '';
      this.uploadGeometry();
    }

    clearSelection() {
      this.selectedFaces.clear(); this.selectedEdges.clear(); this.selectedVertices.clear();
      this.countedFaces.clear(); this.countedEdges.clear(); this.countedVertices.clear();
      this.cutEdges.clear();
      this.faceTints = null;
    }

    setInteractionMode(mode) { this.interactionMode = mode; }
    setPublicLabelMap(map = null) { this.publicLabelMap = map; this.requestRender(); }
    setSelectionType(type) { this.selectionType = type; }
    setLabelMode(mode) { this.labelMode = mode; this.requestRender(); }
    setViewStyle(style) { this.viewStyle = style; this.uploadGeometry(); }
    setRelationEdgeHighlights(edgeIndices = []) {
      const source = this.foldPlan?.targetEdges || (this.currentSolid && this.currentVertices.length
        ? this.currentSolid.topology.edges.map(([a, b]) => [this.currentVertices[a], this.currentVertices[b]])
        : []);
      this.relationSegments = edgeIndices.map((edgeIndex, order) => ({
        edgeIndex,
        a: source[edgeIndex]?.[0],
        b: source[edgeIndex]?.[1],
        order,
      })).filter(segment => segment.a && segment.b);
      this.requestRender();
    }

    setFaceTints(tints = null) {
      this.faceTints = tints && tints.size ? tints : null;
      this.uploadGeometry();
    }

    faceColor(side, faceIndex) {
      if (this.selectedFaces.has(faceIndex)) return palette.selected;
      if (this.countedFaces.has(faceIndex)) return palette.counted;
      const base = this.faceTints?.get(faceIndex) || palette[side] || palette.default;
      const alpha = this.viewStyle === 'transparent' ? 0.38 : 0.94;
      return [base[0], base[1], base[2], alpha];
    }

    uploadArray(buffer, data) {
      const gl = this.gl;
      gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array(data), gl.DYNAMIC_DRAW);
    }

    uploadGeometry() {
      if (!this.available) { this.requestRender(); return; }
      const facePos = [], faceNorm = [], faceColor = [];
      const edgePos = [], edgeNorm = [], edgeColor = [];
      const pointPos = [], pointNorm = [], pointColor = [];

      const pushTriangle = (a, b, c, normal, color) => {
        [a, b, c].forEach(point => {
          facePos.push(...point); faceNorm.push(...normal); faceColor.push(...color);
        });
      };
      this.facePolygons.forEach((poly, fi) => {
        const normal = polygonNormal(poly.points);
        const color = this.faceColor(poly.sideCount, poly.faceIndex ?? fi);
        const useThickness = !!poly.rigidPanel && this.panelThickness > 0 && this.viewStyle !== 'wire';
        if (!useThickness) {
          for (let i = 1; i < poly.points.length - 1; i++) pushTriangle(poly.points[0], poly.points[i], poly.points[i + 1], normal, color);
          return;
        }
        const half = this.panelThickness * 0.5;
        const front = poly.points.map(point => vec3Add(point, vec3Scale(normal, half)));
        const back = poly.points.map(point => vec3Sub(point, vec3Scale(normal, half)));
        const backColor = [color[0] * 0.58, color[1] * 0.62, color[2] * 0.68, color[3]];
        const sideColor = [color[0] * 0.42, color[1] * 0.48, color[2] * 0.58, Math.min(1, color[3] + 0.03)];
        for (let i = 1; i < front.length - 1; i++) {
          pushTriangle(front[0], front[i], front[i + 1], normal, color);
          pushTriangle(back[0], back[i + 1], back[i], vec3Scale(normal, -1), backColor);
        }
        for (let i = 0; i < front.length; i++) {
          const j = (i + 1) % front.length;
          const sideNormal = vec3Unit(vec3Cross(vec3Sub(front[j], front[i]), vec3Scale(normal, -1)));
          pushTriangle(front[i], front[j], back[j], sideNormal, sideColor);
          pushTriangle(front[i], back[j], back[i], sideNormal, sideColor);
        }
      });

      if (this.sharedMode && this.currentSolid) {
        this.currentEdges.forEach((edge, ei) => {
          const color = this.cutEdges.has(ei) ? palette.cut : (this.selectedEdges.has(ei) || this.countedEdges.has(ei) ? palette.selected : palette.edge);
          edge.forEach(vi => { edgePos.push(...this.currentVertices[vi]); edgeNorm.push(0, 0, 1); edgeColor.push(...color); });
        });
      } else {
        this.facePolygons.forEach((poly) => {
          for (let i = 0; i < poly.points.length; i++) {
            const color = palette.edge;
            edgePos.push(...poly.points[i], ...poly.points[(i + 1) % poly.points.length]);
            edgeNorm.push(0, 0, 1, 0, 0, 1);
            edgeColor.push(...color, ...color);
          }
        });
      }
      const markers = this.vertexMarkers?.length
        ? this.vertexMarkers
        : (this.currentVertices || []).map((point, vertexIndex) => ({ point, vertexIndex, active: this.selectedVertices.has(vertexIndex) || this.countedVertices.has(vertexIndex) }));
      markers.forEach(marker => {
        const markerActive = marker.active || this.selectedVertices.has(marker.vertexIndex) || this.countedVertices.has(marker.vertexIndex);
        const color = markerActive ? palette.selected : palette.vertex;
        pointPos.push(...marker.point); pointNorm.push(0, 0, 1); pointColor.push(...color);
      });

      const groups = [
        [this.buffers.faces, facePos, faceNorm, faceColor],
        [this.buffers.edges, edgePos, edgeNorm, edgeColor],
        [this.buffers.points, pointPos, pointNorm, pointColor],
      ];
      groups.forEach(([group, pos, norm, color]) => {
        this.uploadArray(group.position, pos);
        this.uploadArray(group.normal, norm);
        this.uploadArray(group.color, color);
        group.count = pos.length / 3;
      });
      this.requestRender();
    }

    requestRender() {
      if (this.renderRequested) return;
      this.renderRequested = true;
      requestAnimationFrame(() => {
        this.renderRequested = false;
        this.draw();
      });
    }

    bindGroup(group) {
      const gl = this.gl, loc = this.locations;
      const bind = (buffer, location, size) => {
        gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
        gl.enableVertexAttribArray(location);
        gl.vertexAttribPointer(location, size, gl.FLOAT, false, 0, 0);
      };
      bind(group.position, loc.position, 3);
      bind(group.normal, loc.normal, 3);
      bind(group.color, loc.color, 4);
    }

    resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rect = this.canvas.getBoundingClientRect();
      const width = Math.max(1, Math.round(rect.width * dpr));
      const height = Math.max(1, Math.round(rect.height * dpr));
      if (this.canvas.width !== width || this.canvas.height !== height) {
        this.canvas.width = width; this.canvas.height = height;
        this.labelCanvas.width = width; this.labelCanvas.height = height;
      }
      if (this.available) this.gl.viewport(0, 0, width, height);
      return { width, height, dpr, aspect: width / height };
    }

    draw() {
      if (!this.available) { this.draw2D(); return; }
      const gl = this.gl;
      const size = this.resize();
      gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);
      gl.useProgram(this.program);
      gl.uniformMatrix4fv(this.locations.projection, false, perspectiveMatrix(this.fov, size.aspect, 0.1, 100));
      gl.uniform1f(this.locations.yaw, this.yaw);
      gl.uniform1f(this.locations.pitch, this.pitch);
      gl.uniform1f(this.locations.distance, this.distance);

      if (this.buffers.faces.count && this.viewStyle !== 'wire') {
        if (this.viewStyle === 'transparent') gl.disable(gl.CULL_FACE);
        else { gl.enable(gl.CULL_FACE); gl.cullFace(gl.BACK); }
        gl.enable(gl.POLYGON_OFFSET_FILL);
        gl.polygonOffset(1, 1);
        this.bindGroup(this.buffers.faces);
        gl.uniform1f(this.locations.pointSize, 1);
        gl.uniform1f(this.locations.unlit, 0);
        gl.uniform1f(this.locations.pointMode, 0);
        gl.drawArrays(gl.TRIANGLES, 0, this.buffers.faces.count);
        gl.disable(gl.POLYGON_OFFSET_FILL);
      }
      if (this.buffers.edges.count) {
        gl.disable(gl.CULL_FACE);
        this.bindGroup(this.buffers.edges);
        gl.uniform1f(this.locations.pointSize, 1);
        gl.uniform1f(this.locations.unlit, 1);
        gl.uniform1f(this.locations.pointMode, 0);
        try { gl.lineWidth(2); } catch (_) {}
        gl.drawArrays(gl.LINES, 0, this.buffers.edges.count);
      }
      if (this.buffers.points.count) {
        this.bindGroup(this.buffers.points);
        gl.uniform1f(this.locations.pointSize, Math.max(8, (this.sharedMode ? 10.5 : 12.5) * size.dpr));
        gl.uniform1f(this.locations.unlit, 1);
        gl.uniform1f(this.locations.pointMode, 1);
        gl.drawArrays(gl.POINTS, 0, this.buffers.points.count);
      }
      this.drawLabels(size);
    }

    draw2D() {
      const size = this.resize();
      const ctx = this.ctx2d;
      if (!ctx) return;
      const rect = this.canvas.getBoundingClientRect();
      const dpr = size.dpr;
      ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
      ctx.save();
      ctx.scale(dpr, dpr);
      ctx.lineJoin = 'round';
      ctx.lineCap = 'round';

      const cssColor = (rgba, alphaOverride = null) => {
        const a = alphaOverride == null ? rgba[3] : alphaOverride;
        return `rgba(${Math.round(rgba[0]*255)},${Math.round(rgba[1]*255)},${Math.round(rgba[2]*255)},${a})`;
      };
      const visibleFaces = this.facePolygons.map((poly, fi) => {
        const projected = poly.points.map(p => this.projectPoint(p));
        const depth = projected.reduce((sum, p) => sum + p.depth, 0) / Math.max(1, projected.length);
        const normal = rotatePoint(polygonNormal(poly.points), this.yaw, this.pitch);
        const light = clamp(0.58 + 0.42 * Math.max(0, vec3Dot(vec3Unit(normal), vec3Unit([0.45,0.8,0.9]))), 0.35, 1);
        return { poly, fi, projected, depth, light };
      }).sort((a,b) => b.depth - a.depth);

      if (this.viewStyle !== 'wire') {
        visibleFaces.forEach(item => {
          const pts = item.projected;
          if (!pts.length || pts.some(p => !Number.isFinite(p.x))) return;
          const base = this.faceColor(item.poly.sideCount, item.poly.faceIndex ?? item.fi);
          const shaded = [base[0]*item.light, base[1]*item.light, base[2]*item.light, this.viewStyle === 'transparent' ? 0.32 : 0.92];
          ctx.beginPath();
          ctx.moveTo(pts[0].x, pts[0].y);
          for (let i=1;i<pts.length;i++) ctx.lineTo(pts[i].x, pts[i].y);
          ctx.closePath();
          ctx.fillStyle = cssColor(shaded);
          ctx.fill();
          ctx.strokeStyle = 'rgba(15,23,42,.35)';
          ctx.lineWidth = 1.25;
          ctx.stroke();
        });
      }

      if (this.sharedMode && this.currentSolid) {
        const edgeItems = this.currentEdges.map((edge, ei) => {
          const a=this.projectPoint(this.currentVertices[edge[0]]), b=this.projectPoint(this.currentVertices[edge[1]]);
          return {ei,a,b,depth:(a.depth+b.depth)/2};
        }).sort((a,b)=>b.depth-a.depth);
        edgeItems.forEach(({ei,a,b}) => {
          const cut=this.cutEdges.has(ei), selected=this.selectedEdges.has(ei)||this.countedEdges.has(ei);
          ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y);
          ctx.strokeStyle = cut ? cssColor(palette.cut,1) : selected ? cssColor(palette.selected,1) : 'rgba(15,23,42,.9)';
          ctx.lineWidth = cut ? 5 : selected ? 4 : 2;
          ctx.stroke();
        });

      } else {
        visibleFaces.forEach(item=>{
          const pts=item.projected;
          ctx.beginPath(); ctx.moveTo(pts[0].x,pts[0].y);
          for(let i=1;i<pts.length;i++) ctx.lineTo(pts[i].x,pts[i].y);
          ctx.closePath(); ctx.strokeStyle='rgba(15,23,42,.88)'; ctx.lineWidth=2; ctx.stroke();
        });
      }
      const markerItems=(this.vertexMarkers||[]).map(marker=>({marker,p:this.projectPoint(marker.point)})).sort((a,b)=>b.p.depth-a.p.depth);
      markerItems.forEach(({marker,p})=>{
        if(!p.visible)return;
        const markerActive=marker.active||this.selectedVertices.has(marker.vertexIndex)||this.countedVertices.has(marker.vertexIndex);
        if(markerActive){ctx.beginPath();ctx.arc(p.x,p.y,10,0,Math.PI*2);ctx.fillStyle='rgba(255,189,89,.22)';ctx.fill();}
        ctx.beginPath();ctx.arc(p.x,p.y,markerActive?6.5:4.8,0,Math.PI*2);
        ctx.fillStyle=markerActive?cssColor(palette.selected,1):'white';ctx.fill();
        ctx.strokeStyle=markerActive?'rgba(126,75,0,.98)':'rgba(15,23,42,.95)';ctx.lineWidth=markerActive?2.3:1.8;ctx.stroke();
      });
      ctx.restore();
      this.drawLabels(size);
    }

    animate() { this.requestRender(); }

    projectPoint(point, size = null) {
      const rect = this.canvas.getBoundingClientRect();
      const width = rect.width, height = rect.height;
      const aspect = width / Math.max(1, height);
      const rotated = rotatePoint(point, this.yaw, this.pitch);
      const z = rotated[2] - this.distance;
      if (z >= -0.05) return { x: 0, y: 0, depth: Infinity, visible: false };
      const f = 1 / Math.tan(this.fov / 2);
      const ndcX = (rotated[0] * f / aspect) / (-z);
      const ndcY = (rotated[1] * f) / (-z);
      return {
        x: (ndcX * 0.5 + 0.5) * width,
        y: (1 - (ndcY * 0.5 + 0.5)) * height,
        depth: -z,
        visible: Math.abs(ndcX) <= 1.2 && Math.abs(ndcY) <= 1.2,
      };
    }

    pick(clientX, clientY, type) {
      const rect = this.canvas.getBoundingClientRect();
      const px = clientX - rect.left, py = clientY - rect.top;
      if (type === 'face') {
        let best = null;
        this.facePolygons.forEach((poly, fi) => {
          const projected = poly.points.map(p => this.projectPoint(p));
          for (let i = 1; i < projected.length - 1; i++) {
            const a = projected[0], b = projected[i], c = projected[i + 1];
            if (pointInTriangle(px, py, a, b, c)) {
              const depth = (a.depth + b.depth + c.depth) / 3;
              if (!best || depth < best.depth) best = { type: 'face', index: poly.faceIndex ?? fi, faceId: poly.faceId || faceIdFromIndex(fi), depth };
            }
          }
        });
        return best;
      }
      if (!this.sharedMode || !this.currentSolid) return null;
      if (type === 'edge') {
        let best = null;
        this.currentEdges.forEach((edge, ei) => {
          const a = this.projectPoint(this.currentVertices[edge[0]]);
          const b = this.projectPoint(this.currentVertices[edge[1]]);
          const dist = pointSegmentDistance(px, py, a, b);
          const depth = (a.depth + b.depth) / 2;
          if (dist <= 20 && (!best || dist < best.distance - 1 || (Math.abs(dist - best.distance) < 1 && depth < best.depth))) {
            best = { type: 'edge', index: ei, edgeId: edgeIdFromIndex(ei), distance: dist, depth };
          }
        });
        return best;
      }
      if (type === 'vertex') {
        let best = null;
        this.currentVertices.forEach((vertex, vi) => {
          const p = this.projectPoint(vertex);
          const dist = Math.hypot(px - p.x, py - p.y);
          if (dist <= 24 && (!best || dist < best.distance)) best = { type: 'vertex', index: vi, vertexId: vertexIdFromIndex(vi), distance: dist, depth: p.depth };
        });
        return best;
      }
      return null;
    }

    drawLabels(size) {
      const ctx=this.labelCtx,rect=this.canvas.getBoundingClientRect(),dpr=size.dpr;
      ctx.clearRect(0,0,this.labelCanvas.width,this.labelCanvas.height);ctx.save();ctx.scale(dpr,dpr);ctx.textAlign='center';ctx.textBaseline='middle';
      const occupied=[];
      const overlapArea=(a,b)=>Math.max(0,Math.min(a.x2,b.x2)-Math.max(a.x1,b.x1))*Math.max(0,Math.min(a.y2,b.y2)-Math.max(a.y1,b.y1));
      const chooseBox=(p,w,h,ghost=false)=>{
        const cx=rect.width/2,cy=(rect.height||1)/2,dx0=p.x-cx,dy0=p.y-cy,len=Math.max(1,Math.hypot(dx0,dy0));
        const rx=dx0/len,ry=dy0/len,base=ghost?6:9;
        const offsets=[[rx*base,ry*base],[-ry*base,rx*base],[ry*base,-rx*base],[0,-base],[base,0],[-base,0],[0,base],[base*.72,-base*.72],[-base*.72,-base*.72]];
        let best=null,bestScore=Infinity;
        offsets.forEach(([dx,dy],order)=>{const box={x1:p.x+dx-w/2,y1:p.y+dy-h/2,x2:p.x+dx+w/2,y2:p.y+dy+h/2,dx,dy};const score=occupied.reduce((s,o)=>s+overlapArea(box,o),0)+order*.015;if(score<bestScore){best=box;bestScore=score;}});
        occupied.push(best);return best;
      };
      const drawVertexTag=(text,p,{active=false,ghost=false,merged=false,role=''}={})=>{
        if(!p.visible||!text)return;
        const fontSize=merged?11.6:active?10.8:ghost?9.2:9.8;ctx.font=`900 ${fontSize}px ${HAND_CANVAS_FONT}`;
        const usePill=merged||active;const w=Math.max(usePill?13:8,ctx.measureText(text).width+(usePill?6:2)),h=usePill?12:9;
        const box=chooseBox(p,w,h,ghost),x=p.x+box.dx,y=p.y+box.dy;
        if(usePill){ctx.beginPath();if(ctx.roundRect)ctx.roundRect(x-w/2,y-h/2,w,h,4);else ctx.rect(x-w/2,y-h/2,w,h);
          const moving=role==='moving',target=role==='target';
          ctx.fillStyle=merged?'rgba(223,250,239,.95)':moving?'rgba(255,239,199,.94)':target?'rgba(222,240,255,.94)':'rgba(255,255,255,.91)';ctx.fill();
          ctx.strokeStyle=merged?'rgba(17,151,101,.78)':moving?'rgba(213,128,0,.78)':target?'rgba(10,120,255,.76)':'rgba(67,58,145,.48)';ctx.lineWidth=.9;ctx.stroke();
        }
        ctx.lineJoin='round';ctx.strokeStyle=ghost?'rgba(255,255,255,.82)':'rgba(255,255,255,.96)';ctx.lineWidth=ghost?1.9:2.3;ctx.strokeText(text,x,y+.15);
        ctx.fillStyle=ghost?'rgba(61,80,103,.62)':merged?'#07583d':role==='moving'?'#754500':role==='target'?'#004e93':'#403389';ctx.fillText(text,x,y+.15);
      };
      const pulse=.5+.5*Math.sin(performance.now()/155);
      const ring=(p,color,radius=8,alpha=.75)=>{if(!p.visible)return;ctx.beginPath();ctx.arc(p.x,p.y,radius,0,Math.PI*2);ctx.strokeStyle=color.replace('ALPHA',String(alpha));ctx.lineWidth=2;ctx.stroke();};
      if(this.netGhostPolygons?.length){ctx.save();this.netGhostPolygons.forEach(poly=>{const pts=poly.points.map(point=>this.projectPoint(point));if(!pts.length||pts.some(p=>!Number.isFinite(p.x)))return;ctx.beginPath();ctx.moveTo(pts[0].x,pts[0].y);for(let i=1;i<pts.length;i++)ctx.lineTo(pts[i].x,pts[i].y);ctx.closePath();ctx.fillStyle=`rgba(86,153,205,${poly.alpha*.22})`;ctx.fill();ctx.setLineDash([4,6]);ctx.strokeStyle=`rgba(56,120,171,${Math.min(.38,poly.alpha+.12)})`;ctx.lineWidth=1;ctx.stroke();ctx.setLineDash([]);});ctx.restore();}
      (this.netGhostMarkers||[]).forEach(marker=>{const p=this.projectPoint(marker.point);if(!p.visible)return;if(marker.active){ctx.beginPath();ctx.arc(p.x,p.y,6.2+2.4*pulse,0,Math.PI*2);ctx.fillStyle=`rgba(255,193,58,${.07+.08*pulse})`;ctx.fill();ctx.strokeStyle=`rgba(191,112,0,${.42+.26*pulse})`;ctx.lineWidth=1.5;ctx.stroke();}ctx.beginPath();ctx.arc(p.x,p.y,marker.active?2.8:2.15,0,Math.PI*2);ctx.fillStyle=marker.active?'rgba(255,240,192,.92)':'rgba(255,255,255,.55)';ctx.fill();ctx.strokeStyle=marker.active?'rgba(132,76,0,.74)':'rgba(58,84,112,.38)';ctx.lineWidth=marker.active?1.15:.9;ctx.stroke();drawVertexTag(marker.label,p,{ghost:true,active:!!marker.active,role:marker.role||''});});
      if(this.mergeSegments?.length){ctx.save();ctx.setLineDash([3,5]);ctx.lineCap='round';this.mergeSegments.forEach(segment=>{const a=this.projectPoint(segment.a),b=this.projectPoint(segment.b);if(!a.visible&&!b.visible)return;ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);ctx.strokeStyle=`rgba(116,83,190,${.46+.18*pulse})`;ctx.lineWidth=1.7;ctx.stroke();ring(a,'rgba(220,128,0,ALPHA)',7+3*pulse,.52+.28*pulse);ring(b,'rgba(10,120,255,ALPHA)',7+3*(1-pulse),.52+.28*(1-pulse));});ctx.restore();}
      if(this.overlaySegments?.length){ctx.save();ctx.lineCap='round';this.overlaySegments.forEach(segment=>{const a=this.projectPoint(segment.a),b=this.projectPoint(segment.b);if(!a.visible&&!b.visible)return;if(segment.active){ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);ctx.strokeStyle='rgba(10,120,255,.13)';ctx.lineWidth=10;ctx.stroke();}ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);ctx.strokeStyle=segment.active?'rgba(10,120,255,.92)':'rgba(218,147,30,.34)';ctx.lineWidth=segment.active?2.7:1.05;ctx.stroke();if(segment.active){[a,b].forEach(point=>{ctx.beginPath();ctx.arc(point.x,point.y,3.2,0,Math.PI*2);ctx.fillStyle='white';ctx.fill();ctx.strokeStyle='#005ba8';ctx.lineWidth=1.3;ctx.stroke();});}});ctx.restore();}
      if(this.relationSegments?.length){ctx.save();ctx.lineCap='round';this.relationSegments.forEach((segment,order)=>{const a=this.projectPoint(segment.a),b=this.projectPoint(segment.b);if(!a.visible&&!b.visible)return;ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);ctx.strokeStyle=order===0?'rgba(10,120,255,.94)':'rgba(220,63,103,.94)';ctx.lineWidth=5;ctx.stroke();});ctx.restore();}
      (this.vertexMarkers||[]).forEach(marker=>{if(!marker.primaryInGroup)return;const sharedLabel=this.sharedMode&&this.labelMode==='vertices';const markerActive=marker.active||marker.mergeCandidate||marker.merged||this.selectedVertices.has(marker.vertexIndex)||this.countedVertices.has(marker.vertexIndex);if(!(sharedLabel||marker.showLabel||markerActive))return;const p=this.projectPoint(marker.point);if(!p.visible)return;if(marker.mergeCandidate){const target=marker.mergeRole==='target';ctx.beginPath();ctx.arc(p.x,p.y,7.2+3.2*pulse,0,Math.PI*2);ctx.fillStyle=target?`rgba(10,120,255,${.07+.10*pulse})`:`rgba(255,176,38,${.08+.11*pulse})`;ctx.fill();ctx.strokeStyle=target?`rgba(10,120,255,${.48+.30*pulse})`:`rgba(213,128,0,${.48+.30*pulse})`;ctx.lineWidth=1.8;ctx.stroke();}if(marker.merged){ctx.beginPath();ctx.arc(p.x,p.y,8.8+2.4*pulse,0,Math.PI*2);ctx.strokeStyle=`rgba(19,168,117,${.48+.30*pulse})`;ctx.lineWidth=2;ctx.stroke();}const label=marker.label||publicVertexToken(this.currentSolid,marker.solidVertexIndex??marker.vertexIndex,this.publicLabelMap);drawVertexTag(label,p,{active:markerActive,merged:marker.merged,role:marker.mergeRole||''});});
      if(this.emptyMessage){ctx.fillStyle='rgba(21,34,53,.82)';ctx.font=`900 20px ${HAND_CANVAS_FONT}`;ctx.fillText(this.emptyMessage,rect.width/2,rect.height/2);}ctx.restore();if(performance.now()<(this.effectUntil||0))this.requestRender();
    }
  }

