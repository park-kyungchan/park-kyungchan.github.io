      <div class="proof-counter-bar"><div class="proof-counter">V<strong>${counts.V}</strong></div><div class="proof-counter">E<strong>${counts.E}</strong></div><div class="proof-counter">F<strong>${counts.F}</strong></div><div class="proof-counter">변화량<strong>${delta?`${delta.dV>=0?'+':''}${delta.dV}, ${delta.dE>=0?'+':''}${delta.dE}, ${delta.dF>=0?'+':''}${delta.dF}`:'—'}</strong></div><div class="proof-counter proof-invariant">V−E+F<strong>${state.eulerPredictionLocked?eulerInvariant(counts):'?'}</strong></div></div>`;
