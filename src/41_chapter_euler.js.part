    const detail=phase==='preview'?unit.before.detail:phase==='anticipation'?`곧 실행: ${unit.actionLabel}`:phase==='transform'?unit.actionLabel:phase==='settle'?unit.after.detail:`정지 상태: ${unit.after.detail}`;
