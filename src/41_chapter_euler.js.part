    const nodes=model.letters.map(v=>{const removed=snapshot.removedVertices.has(v),active=item.activeVertex===v,leaf=interactive&&degrees[v]===1&&!removed;const cls=['proof-node',removed?'is-removed':'',active?'is-active':'',leaf?'is-leaf':''].filter(Boolean).join(' ');return `<circle class="${cls}" data-proof-vertex="${v}" cx="${positions[v][0]}" cy="${positions[v][1]}" r="12" role="button" tabindex="${interactive&&!removed?'0':'-1'}" aria-label="꼭짓점 ${v}${leaf?' · 끝에 달린 꼭짓점':''}"></circle><text class="proof-label" x="${positions[v][0]}" y="${positions[v][1]-22}">${removed?'':v}</text>`;}).join('');
