  function proofAnimatedSVG(model, frame) {
    const unit=frame.unit,before=unit.before.snapshot,after=unit.after.snapshot,t=frame.transformT;
    const positions={};
    model.letters.forEach(v=>{const a=model.solid[v],b=model.planar[v];positions[v]=[lerp(a[0],b[0],frame.layoutT),lerp(a[1],b[1],frame.layoutT)];});
