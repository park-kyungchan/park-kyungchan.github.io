      timeline.push({kind:'leaf-post',stage:3,title:'끝가지 떼기',detail:`꼭짓점 ${vertex}와 모서리 ${edgeId}가 함께 사라졌습니다.`,activeEdge:edgeId,activeVertex:vertex,delta:{dV:-1,dE:-1,dF:0},snapshot:proofSnapshot(model,snap.removedEdges,snap.removedVertices,snap.F)});
