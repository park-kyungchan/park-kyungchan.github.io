  }
  function cloneDirectSnapshot(s){return {removedEdges:new Set(s.removedEdges),removedVertices:new Set(s.removedVertices),F:s.F};}
  function ensureDirectProof(reset=false){const model=EULER_PROOFS[state.eulerProofId];if(reset||!state.eulerDirectState||state.eulerDirectState.modelId!==model.id){state.eulerDirectState={modelId:model.id,...proofSnapshot(model)};state.eulerDirectHistory=[];state.eulerDirectRedo=[];state.eulerDirectFeedback='평면 연결 그림에서 먼저 어떤 수가 함께 변할지 예측하세요.';state.eulerOperationPrediction=[];}}
