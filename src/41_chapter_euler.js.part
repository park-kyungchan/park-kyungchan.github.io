      else if(!br&&ar)opacity=1-t;
      else if(br&&!ar)opacity=t;
      const cls=['proof-edge',active?'is-active':''].filter(Boolean).join(' '),labelOpacity=opacity>.28?opacity:0;
      return `<line class="${cls}" x1="${p1[0]}" y1="${p1[1]}" x2="${p2[0]}" y2="${p2[1]}" style="opacity:${opacity.toFixed(3)}"></line>`;
    }).join('');
    const nodes=model.letters.map(v=>{
