      <div class="proof-counter-bar"><div class="proof-counter">V<strong>${counts.V}</strong></div><div class="proof-counter">E<strong>${counts.E}</strong></div><div class="proof-counter">F<strong>${counts.F}</strong></div><div class="proof-counter">변화량<strong>${delta?`${delta.dV>=0?'+':''}${delta.dV}, ${delta.dE>=0?'+':''}${delta.dE}, ${delta.dF>=0?'+':''}${delta.dF}`:'—'}</strong></div><div class="proof-counter proof-invariant">V−E+F<strong>${state.eulerPredictionLocked?eulerInvariant(counts):'?'}</strong></div></div>`;
  }

  function proofGraphDegrees(model,snapshot){const degrees=Object.fromEntries(model.letters.filter(v=>!snapshot.removedVertices.has(v)).map(v=>[v,0]));model.edges.forEach(([id,a,b])=>{if(snapshot.removedEdges.has(id)||snapshot.removedVertices.has(a)||snapshot.removedVertices.has(b))return;degrees[a]=(degrees[a]||0)+1;degrees[b]=(degrees[b]||0)+1;});return degrees;}
  function graphConnectedWithoutEdge(model,snapshot,edgeToRemove){const vertices=model.letters.filter(v=>!snapshot.removedVertices.has(v));if(vertices.length<=1)return true;const adj=Object.fromEntries(vertices.map(v=>[v,[]]));model.edges.forEach(([id,a,b])=>{if(id===edgeToRemove||snapshot.removedEdges.has(id)||snapshot.removedVertices.has(a)||snapshot.removedVertices.has(b))return;adj[a].push(b);adj[b].push(a);});const seen=new Set([vertices[0]]),q=[vertices[0]];while(q.length){const v=q.shift();adj[v].forEach(n=>{if(!seen.has(n)){seen.add(n);q.push(n);}});}return seen.size===vertices.length;}
  function directLegalState(model,snapshot){
    const counts=proofCounts(model,snapshot),activeEdges=model.edges.filter(([id,a,b])=>!snapshot.removedEdges.has(id)&&!snapshot.removedVertices.has(a)&&!snapshot.removedVertices.has(b));
