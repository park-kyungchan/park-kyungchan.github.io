      mergeWash=`<ellipse cx="${(a[0]+b[0])/2}" cy="${(a[1]+b[1])/2}" rx="${54+18*t}" ry="${34+12*t}" fill="rgba(240,138,0,${pulse.toFixed(3)})" stroke="#d67700" stroke-width="3" stroke-dasharray="9 6"></ellipse>`;
    }
