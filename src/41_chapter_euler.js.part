      timeline.push({kind:'leaf-pre',stage:3,title:'끝가지 떼기',detail:`끝에 달린 꼭짓점 ${vertex}와 모서리 ${edgeId}를 한 쌍으로 확인합니다.`,activeEdge:edgeId,activeVertex:vertex,delta:{dV:-1,dE:-1,dF:0},snapshot:proofSnapshot(model,snap.removedEdges,snap.removedVertices,snap.F)});
