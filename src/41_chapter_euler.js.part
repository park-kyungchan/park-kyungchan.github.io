      if(active&&(removing||adding)&&!activeVertex){const mid=[(positions[a][0]+positions[b][0])/2,(positions[a][1]+positions[b][1])/2],k=removing?t:1-t;p1=[lerp(positions[a][0],mid[0],k),lerp(positions[a][1],mid[1],k)];p2=[lerp(positions[b][0],mid[0],k),lerp(positions[b][1],mid[1],k)];opacity=removing?1-t:t;}
