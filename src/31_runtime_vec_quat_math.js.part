  const palette = {
    3: [0.25, 0.57, 0.81, 1],
    4: [0.18, 0.68, 0.58, 1],
    5: [0.93, 0.52, 0.22, 1],
    6: [0.46, 0.43, 0.82, 1],
    8: [0.83, 0.36, 0.58, 1],
    default: [0.48, 0.58, 0.69, 1],
    selected: [1.0, 0.74, 0.12, 1],
    counted: [0.22, 0.76, 0.42, 1],
    cut: [0.86, 0.16, 0.18, 1],
    edge: [0.08, 0.12, 0.18, 1],
    vertex: [0.98, 0.98, 0.98, 1],
  };

  function vec3Add(a, b) { return [a[0] + b[0], a[1] + b[1], a[2] + b[2]]; }
  function vec3Sub(a, b) { return [a[0] - b[0], a[1] - b[1], a[2] - b[2]]; }
  function vec3Scale(a, s) { return [a[0] * s, a[1] * s, a[2] * s]; }
  function vec3Dot(a, b) { return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]; }
  function vec3Cross(a, b) { return [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]]; }
  function vec3Length(a) { return Math.hypot(a[0], a[1], a[2]); }
  function vec3Unit(a) { const n = vec3Length(a) || 1; return [a[0] / n, a[1] / n, a[2] / n]; }
  function vec3Mean(points) {
    const out = [0, 0, 0];
    points.forEach(p => { out[0] += p[0]; out[1] += p[1]; out[2] += p[2]; });
    return out.map(v => v / Math.max(1, points.length));
  }
  function polygonNormal(points) {
    const n = [0, 0, 0];
    for (let i = 0; i < points.length; i++) {
      const c = vec3Cross(points[i], points[(i + 1) % points.length]);
      n[0] += c[0]; n[1] += c[1]; n[2] += c[2];
    }
    return vec3Unit(n);
  }
  function rotatePoint(p, yaw, pitch) {
    const cy = Math.cos(yaw), sy = Math.sin(yaw);
    const cx = Math.cos(pitch), sx = Math.sin(pitch);
    const x1 = cy * p[0] + sy * p[2];
    const z1 = -sy * p[0] + cy * p[2];
    const y2 = cx * p[1] - sx * z1;
    const z2 = sx * p[1] + cx * z1;
    return [x1, y2, z2];
  }
  function perspectiveMatrix(fovy, aspect, near, far) {
    const f = 1 / Math.tan(fovy / 2);
    const nf = 1 / (near - far);
    return new Float32Array([
      f / aspect, 0, 0, 0,
      0, f, 0, 0,
      0, 0, (far + near) * nf, -1,
      0, 0, 2 * far * near * nf, 0,
    ]);
  }
  function pointInTriangle(px, py, a, b, c) {
    const v0x = c.x - a.x, v0y = c.y - a.y;
    const v1x = b.x - a.x, v1y = b.y - a.y;
    const v2x = px - a.x, v2y = py - a.y;
    const dot00 = v0x * v0x + v0y * v0y;
    const dot01 = v0x * v1x + v0y * v1y;
    const dot02 = v0x * v2x + v0y * v2y;
    const dot11 = v1x * v1x + v1y * v1y;
    const dot12 = v1x * v2x + v1y * v2y;
    const denom = dot00 * dot11 - dot01 * dot01;
    if (Math.abs(denom) < 1e-8) return false;
    const inv = 1 / denom;
    const u = (dot11 * dot02 - dot01 * dot12) * inv;
    const v = (dot00 * dot12 - dot01 * dot02) * inv;
    return u >= -0.001 && v >= -0.001 && u + v <= 1.001;
  }
  function pointSegmentDistance(px, py, a, b) {
    const dx = b.x - a.x, dy = b.y - a.y;
    const l2 = dx * dx + dy * dy;
    if (!l2) return Math.hypot(px - a.x, py - a.y);
    const t = clamp(((px - a.x) * dx + (py - a.y) * dy) / l2, 0, 1);
    return Math.hypot(px - (a.x + t * dx), py - (a.y + t * dy));
  }
  function quaternionNormalize(q) {
    const n = Math.hypot(q[0], q[1], q[2], q[3]) || 1;
    return q.map(v => v / n);
  }
  function quaternionSlerp(a, b, t) {
    let q1 = quaternionNormalize(a), q2 = quaternionNormalize(b);
    let dot = q1.reduce((sum, v, i) => sum + v * q2[i], 0);
    if (dot < 0) { q2 = q2.map(v => -v); dot = -dot; }
    if (dot > 0.9995) return quaternionNormalize(q1.map((v, i) => lerp(v, q2[i], t)));
    const theta0 = Math.acos(clamp(dot, -1, 1));
    const theta = theta0 * t;
    const s0 = Math.cos(theta) - dot * Math.sin(theta) / Math.sin(theta0);
    const s1 = Math.sin(theta) / Math.sin(theta0);
    return q1.map((v, i) => s0 * v + s1 * q2[i]);
  }
  function quaternionRotate(q, v) {
    const [x, y, z, w] = q;
    const ix = w * v[0] + y * v[2] - z * v[1];
    const iy = w * v[1] + z * v[0] - x * v[2];
    const iz = w * v[2] + x * v[1] - y * v[0];
    const iw = -x * v[0] - y * v[1] - z * v[2];
    return [
      ix * w + iw * -x + iy * -z - iz * -y,
      iy * w + iw * -y + iz * -x - ix * -z,
      iz * w + iw * -z + ix * -y - iy * -x,
    ];
  }

  function quaternionMultiply(a, b) {
    const [ax, ay, az, aw] = a, [bx, by, bz, bw] = b;
    return quaternionNormalize([
      aw * bx + ax * bw + ay * bz - az * by,
      aw * by - ax * bz + ay * bw + az * bx,
      aw * bz + ax * by - ay * bx + az * bw,
      aw * bw - ax * bx - ay * by - az * bz,
    ]);
  }
  function quaternionConjugate(q) { return [-q[0], -q[1], -q[2], q[3]]; }
  function quaternionFromAxisAngle(axis, angle) {
    const a = vec3Unit(axis), h = angle * 0.5, s = Math.sin(h);
    return quaternionNormalize([a[0] * s, a[1] * s, a[2] * s, Math.cos(h)]);
  }
  function smoothstep01(t) { const x = clamp(t, 0, 1); return x * x * (3 - 2 * x); }
  function rigidTransformPoint(transform, point) { return vec3Add(quaternionRotate(transform.q, point), transform.t); }
  function rigidCompose(after, before) {
    return {
      q: quaternionMultiply(after.q, before.q),
      t: vec3Add(quaternionRotate(after.q, before.t), after.t),
    };
  }
  function rotationAboutLine(pointOnAxis, axis, angle) {
    const q = quaternionFromAxisAngle(axis, angle);
    return { q, t: vec3Sub(pointOnAxis, quaternionRotate(q, pointOnAxis)) };
  }
  function faceNormalFromIndices(vertices, face) {
    return polygonNormal(face.map(index => vertices[index]));
  }

