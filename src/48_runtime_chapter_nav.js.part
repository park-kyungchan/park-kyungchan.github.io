  const CHAPTER_ORDER = ['explorer','generator','net','section','euler','soccer','revolution','revsection','locus','distance','geodesic','transfer'];
  const CHAPTER_NAMES = { explorer:'입체 읽기', generator:'왜 5개?', net:'전개도 조립', section:'다면체 단면', euler:'오일러 증명', soccer:'축구공 확장', revolution:'회전체 생성', revsection:'회전체 단면', locus:'곡선의 자취', distance:'거리의 조건', geodesic:'펼친 최단길', transfer:'전이 과제' };
  function updateChapterNav() {
    const index=Math.max(0,CHAPTER_ORDER.indexOf(state.tab));
    const prev=$('#chapterPrevButton'),next=$('#chapterNextButton'),progress=$('#chapterProgress');
    if(prev){prev.disabled=index<=0;prev.textContent=index>0?`← ${CHAPTER_NAMES[CHAPTER_ORDER[index-1]]}`:'← 처음';}
    if(next){next.disabled=index>=CHAPTER_ORDER.length-1;next.textContent=index<CHAPTER_ORDER.length-1?`${CHAPTER_NAMES[CHAPTER_ORDER[index+1]]} →`:'마침';}
    if(progress)progress.textContent=`${index+1}/${CHAPTER_ORDER.length} · ${CHAPTER_NAMES[state.tab] || ''}`;
  }
  function goChapter(direction) {
    const index=CHAPTER_ORDER.indexOf(state.tab);const next=clamp(index+direction,0,CHAPTER_ORDER.length-1);if(next===index)return;
    stopFoldPlayback();stopGeneratorPlayback();stopSectionPlayback();stopEulerPlayback();stopSoccerPlayback();stopR007Playback();
    state.tab=CHAPTER_ORDER[next];activateTabButton(state.tab);renderCurrentTab();announce(`${CHAPTER_NAMES[state.tab]} 장으로 이동했습니다.`);
  }
  $('#chapterPrevButton')?.addEventListener('click',()=>goChapter(-1));
  $('#chapterNextButton')?.addEventListener('click',()=>goChapter(1));


