/* ===== P1-3 chapter 7 — 부피 ===== */
/* Claims, ratios and every displayed number come from window.P003_MEASURE.volume
   (cases + relations). The pouring simulation is a display of the stored 1/3 and
   2/3 relations, never a measurement of the drawing. */
  const P13_FRACTION_GLYPH = Object.freeze({ '1/2':'½', '1/3':'⅓', '1/4':'¼', '2/3':'⅔', '3/4':'¾' });
  const P13_VOLUME_MODES = Object.freeze([
    { key:'prism', label:'기둥' }, { key:'cone', label:'뿔' }, { key:'sphere', label:'구' }, { key:'frustum', label:'뿔대 · 심화' },
  ]);
  const P13_PILLAR_CASES = Object.freeze(['V-PRISM-3', 'V-PRISM-4', 'V-CYLINDER']);
  const P13_RELATION_LABELS = Object.freeze({ 'REL-PYRAMID-THIRD':'각뿔과 각기둥', 'REL-CONE-THIRD':'원뿔과 원기둥' });

  function p13VCase(id) { return (P13_MEASURE.volume.cases || []).find(item => item.id === id); }
  function p13Relation(id) { return (P13_MEASURE.volume.relations || []).find(item => item.id === id); }
  function p13PillarCase() { return p13VCase(state.volumePillar) || p13VCase(P13_PILLAR_CASES[1]); }
  function p13RelationPair(relation) {
    /* REL-PYRAMID-THIRD pairs two stored cases; REL-CONE-THIRD stores its matching
       cylinder inline because the R009 cylinder profile has a different radius. */
    if (relation.id === 'REL-PYRAMID-THIRD') {
      const prism = p13VCase(relation.pair[0]), pyramid = p13VCase(relation.pair[1]);
      return {
        cone: pyramid, coneLabel: p13SolidLabel(pyramid.solid),
        pillarLabel: p13SolidLabel(prism.solid), pillarVolume: prism.volume,
        width: pyramid.dims.base_edge, height: pyramid.height.value, reference: null,
      };
    }
    const cone = p13VCase(relation.pair[0]), reference = relation.matched_reference;
    return {
      cone, coneLabel: p13SolidLabel(cone.solid), pillarLabel: reference.korean_label, pillarVolume: reference.volume,
      width: 2 * reference.radius, height: reference.height, reference,
    };
  }
  function p13VolumeSolidId() {
    if (state.volumeMode === 'prism') return p13PillarCase().solid;
    if (state.volumeMode === 'cone') return p13RelationPair(p13Relation(state.volumeRelation)).cone.solid;
    if (state.volumeMode === 'sphere') return p13VCase('V-SPHERE').solid;
    return p13VCase('V-FRUSTUM-CONE').solid;
  }

  /* ---------- 2D section insets ---------- */
  function p13PillarSVG(item, fill) {
    const width = item.dims.radius != null ? 2 * item.dims.radius : item.dims.base_edge;
    const height = item.height.value, layers = 12, filled = Math.round(clamp(fill, 0, 1) * layers);
    const shapes = [];
    for (let i = 0; i < filled; i++) shapes.push({ cls: 'is-fill', points: p13Rect(-width / 2, height - (i + 1) * height / layers, width, height / layers) });
    shapes.push({ cls: 'is-outline', points: p13Rect(-width / 2, 0, width, height) });
    const texts = [
      { x: 0, y: height + height * .22, text: `밑넓이 ${item.base_area.expr}`, cls: 'p13-svg-note' },
      { x: width / 2 + width * .12, y: height / 2, text: `높이 ${item.height.expr}`, cls: 'p13-svg-note', anchor: 'start' },
      { x: 0, y: -height * .12, text: fill >= .999 ? `부피 = ${item.volume.expr} ≈ ${r9fmt(item.volume.value)}` : `밑넓이를 ${Math.round(clamp(fill, 0, 1) * 100)}% 높이만큼 쌓았습니다`, cls: 'p13-svg-expr' },
    ];
    return p13BuildSVG([{ cls: 'p13-vol-figure', shapes, texts }]);
  }
  function p13PourSVG(relation, pours) {
    const pair = p13RelationPair(relation), width = pair.width, height = pair.height, gap = width * .95;
    const leftX = -(width + gap) / 2, rightX = (width + gap) / 2, level = clamp(pours / 3, 0, 1);
    const cone = { cls: 'p13-vol-figure', shapes: [
      { cls: 'is-fill', points: [[leftX, 0], [leftX - width / 2, height], [leftX + width / 2, height]] },
      { cls: 'is-outline', points: [[leftX, 0], [leftX - width / 2, height], [leftX + width / 2, height]] },
    ], texts: [{ x: leftX, y: height + height * .20, text: `${pair.coneLabel} · 한 번 담는 양`, cls: 'p13-svg-note' }] };
    const pillarShapes = [];
    if (level > 0) pillarShapes.push({ cls: 'is-fill', points: p13Rect(rightX - width / 2, height * (1 - level), width, height * level) });
    for (let i = 1; i < 3; i++) pillarShapes.push({ cls: 'is-guide', points: p13Rect(rightX - width / 2, height * i / 3, width, height * .012) });
    pillarShapes.push({ cls: 'is-outline', points: p13Rect(rightX - width / 2, 0, width, height) });
    const pillar = { cls: 'p13-vol-figure', shapes: pillarShapes, texts: [
      { x: rightX, y: height + height * .20, text: `${pair.pillarLabel} · ${pours}/3`, cls: 'p13-svg-note' },
    ] };
    const caption = { cls: 'p13-vol-figure', shapes: [], texts: [
      { x: 0, y: -height * .14, text: pours >= 3 ? '가득 찼습니다' : pours ? `${P13_ORDINALS[pours]} 붓기` : '아직 붓지 않았습니다', cls: 'p13-svg-expr' },
    ] };
    return p13BuildSVG([cone, pillar, caption]);
  }
  function p13SphereSVG(relation) {
    const reference = relation.matched_reference, radius = reference.radius, height = reference.height;
    const shapes = [
      { cls: 'is-outline', points: p13Rect(-radius, 0, 2 * radius, height) },
      { cls: 'is-fill', points: p13Circle(0, height / 2, radius) },
      { cls: 'is-outline', points: p13Circle(0, height / 2, radius) },
    ];
    const texts = [
      { x: 0, y: -height * .10, text: reference.korean_label, cls: 'p13-svg-note' },
      { x: 0, y: height / 2, text: '구', cls: 'p13-svg-expr' },
      { x: radius * 1.1, y: height / 2, text: `높이 = 지름 ${r9fmt(height)}`, cls: 'p13-svg-note', anchor: 'start' },
    ];
    return p13BuildSVG([{ cls: 'p13-vol-figure', shapes, texts }]);
  }
  function p13FrustumSVG(item) {
    const cut = item.cut_cone, bigHeight = cut.big_cone_height.value, smallHeight = cut.small_cone_height.value;
    const bottom = item.dims.bottom_radius, top = item.dims.top_radius;
    const shapes = [
      { cls: 'is-fill', points: [[-top, smallHeight], [top, smallHeight], [bottom, bigHeight], [-bottom, bigHeight]] },
      { cls: 'is-outline', points: [[-top, smallHeight], [top, smallHeight], [bottom, bigHeight], [-bottom, bigHeight]] },
      { cls: 'is-cut', dash: true, points: [[0, 0], [-top, smallHeight], [top, smallHeight]] },
      { cls: 'is-guide-line', dash: true, points: [[0, 0], [-bottom, bigHeight], [bottom, bigHeight]] },
    ];
    const texts = [
      { x: 0, y: smallHeight * .55, text: '잘라낸 작은 원뿔', cls: 'p13-svg-note' },
      { x: 0, y: (smallHeight + bigHeight) / 2, text: '원뿔대', cls: 'p13-svg-expr' },
      { x: 0, y: bigHeight + bigHeight * .11, text: `큰 원뿔 − 작은 원뿔 = ${item.volume.expr}`, cls: 'p13-svg-note' },
    ];
    return p13BuildSVG([{ cls: 'p13-vol-figure', shapes, texts }]);
  }
  function p13VolumeInset() {
    if (state.volumeMode === 'prism') return { label: '옆에서 본 단면 · 밑넓이가 높이만큼 쌓입니다', svg: p13PillarSVG(p13PillarCase(), state.volumeFill) };
    if (state.volumeMode === 'cone') {
      const relation = p13Relation(state.volumeRelation);
      return { label: '옆에서 본 단면 · 뿔에서 기둥으로 붓기', svg: p13PourSVG(relation, state.volumePours) };
    }
    if (state.volumeMode === 'sphere') return { label: '옆에서 본 단면 · 구와 꼭 맞는 원기둥', svg: p13SphereSVG(p13Relation('REL-SPHERE-TWO-THIRDS')) };
    return { label: '옆에서 본 단면 · 큰 원뿔에서 작은 원뿔 빼기', svg: p13FrustumSVG(p13VCase('V-FRUSTUM-CONE')) };
  }

  /* ---------- guide + evidence ---------- */
  function p13VolumeProgress() {
    if (state.volumeMode === 'prism') return .22 + .78 * clamp(state.volumeFill, 0, 1);
    if (state.volumeMode === 'cone') return !state.volumeConePrediction ? .12 : .34 + .66 * clamp(state.volumePours / 3, 0, 1);
    if (state.volumeMode === 'sphere') return state.volumeSpherePrediction ? 1 : .12;
    return .92;
  }
  function p13VolumeGuide() {
    const p = p13VolumeProgress();
    let copy, chips;
    if (state.volumeMode === 'prism') {
      const item = p13PillarCase();
      copy = state.volumeFill >= .999
        ? ['밑넓이 × 높이가 부피입니다.', '밑면이 높이만큼 그대로 쌓였으므로 부피는 밑넓이에 높이를 곱한 값입니다.']
        : ['밑면을 높이만큼 쌓습니다.', '슬라이더를 올리며 같은 밑면이 위로 쌓여 가는 과정을 보세요.'];
      chips = [p13SolidLabel(item.solid), `밑넓이 ${item.base_area.expr}`, `높이 ${item.height.expr}`];
    } else if (state.volumeMode === 'cone') {
      const relation = p13Relation(state.volumeRelation), pair = p13RelationPair(relation);
      copy = !state.volumeConePrediction
        ? ['먼저 예상합니다.', '밑면과 높이가 같은 기둥과 비교하면 뿔의 부피는 그 몇 분의 몇일까요?']
        : state.volumePours >= 3
          ? ['세 번 부으면 기둥이 가득 찹니다.', `${pair.coneLabel}의 부피는 밑면과 높이가 같은 기둥의 부피의 ${relation.expected_ratio.expr}입니다.`]
          : ['뿔에 담아 기둥에 붓습니다.', '몇 번을 부어야 기둥이 가득 차는지 직접 세어 보세요.'];
      chips = [pair.coneLabel, pair.pillarLabel, `${state.volumePours}/3`];
    } else if (state.volumeMode === 'sphere') {
      const relation = p13Relation('REL-SPHERE-TWO-THIRDS');
      copy = state.volumeSpherePrediction
        ? ['구와 꼭 맞는 원기둥을 비교합니다.', relation.claim]
        : ['먼저 예상합니다.', '구에 꼭 맞는 원기둥과 비교하면 구의 부피는 그 몇 분의 몇일까요?'];
      chips = ['구', relation.matched_reference.korean_label, relation.expected_ratio.expr];
    } else {
      const item = p13VCase('V-FRUSTUM-CONE');
      copy = ['큰 원뿔에서 작은 원뿔을 뺍니다.', '원뿔대의 부피는 잘리기 전 큰 원뿔의 부피에서 잘라낸 작은 원뿔의 부피를 뺀 값입니다.'];
      chips = ['원뿔대', '심화', item.volume.expr];
    }
    return { kicker: `${Math.round(p * 100)}% · ${r009PhaseLabel(p)}`, title: copy[0], body: copy[1], chips };
  }
  function p13VolumeEvidence() {
    const sections = [];
    if (state.volumeMode === 'prism') {
      const item = p13PillarCase();
      sections.push(`<section class="panel-section"><p class="eyebrow">${r009ChapterNo('volume')} · 정확 데이터</p><h2>${escapeHTML(p13SolidLabel(item.solid))}의 부피</h2>
        <div class="callout success"><strong>부피 = ${escapeHTML(item.volume.expr)} ≈ ${escapeHTML(r9fmt(item.volume.value))}</strong>${escapeHTML(item.volume.formula)}</div>
        <ul>${p13MeasureList(item, ['base_area', 'height', 'volume'])}</ul></section>`);
    } else if (state.volumeMode === 'cone') {
      const relation = p13Relation(state.volumeRelation), pair = p13RelationPair(relation);
      sections.push(`<section class="panel-section"><p class="eyebrow">${r009ChapterNo('volume')} · 정확 데이터</p><h2>${escapeHTML(pair.coneLabel)}와 ${escapeHTML(pair.pillarLabel)}</h2>
        <div class="callout success"><strong>${escapeHTML(relation.claim)}</strong>비 = ${escapeHTML(relation.expected_ratio.expr)}</div>
        <ul><li><strong>${escapeHTML(pair.coneLabel)}의 부피</strong>: ${escapeHTML(pair.cone.volume.expr)} ≈ ${escapeHTML(r9fmt(pair.cone.volume.value))} <small>(${escapeHTML(pair.cone.volume.formula)})</small></li>
        <li><strong>${escapeHTML(pair.pillarLabel)}의 부피</strong>: ${escapeHTML(pair.pillarVolume.expr)} ≈ ${escapeHTML(r9fmt(pair.pillarVolume.value))} <small>(${escapeHTML(pair.pillarVolume.formula)})</small></li></ul>
        ${pair.reference ? `<p class="small-note">짝이 되는 원기둥은 밑면 반지름 ${escapeHTML(r9fmt(pair.reference.radius))}, 높이 ${escapeHTML(r9fmt(pair.reference.height))}입니다. 4장에서 본 반지름 ${escapeHTML(r9fmt(p13VCase('V-CYLINDER').dims.radius))}인 원기둥과는 다른 원기둥입니다.</p>` : ''}</section>`);
    } else if (state.volumeMode === 'sphere') {
      const relation = p13Relation('REL-SPHERE-TWO-THIRDS'), sphere = p13VCase('V-SPHERE');
      sections.push(`<section class="panel-section"><p class="eyebrow">${r009ChapterNo('volume')} · 정확 데이터</p><h2>구의 부피</h2>
        <div class="callout success"><strong>${escapeHTML(relation.claim)}</strong>비 = ${escapeHTML(relation.expected_ratio.expr)}</div>
        <ul><li><strong>구의 부피</strong>: ${escapeHTML(sphere.volume.expr)} ≈ ${escapeHTML(r9fmt(sphere.volume.value))} <small>(${escapeHTML(sphere.volume.formula)})</small></li>
        <li><strong>${escapeHTML(relation.matched_reference.korean_label)}의 부피</strong>: ${escapeHTML(relation.matched_reference.volume.expr)} ≈ ${escapeHTML(r9fmt(relation.matched_reference.volume.value))}</li>
        <li><strong>반지름 r</strong>: ${escapeHTML(r9fmt(sphere.dims.radius))}</li></ul></section>`);
    } else {
      const item = p13VCase('V-FRUSTUM-CONE'), cut = item.cut_cone;
      sections.push(`<section class="panel-section"><p class="eyebrow">${r009ChapterNo('volume')} · 정확 데이터</p><h2>원뿔대의 부피 · 심화</h2>
        <div class="callout success"><strong>부피 = ${escapeHTML(item.volume.expr)} ≈ ${escapeHTML(r9fmt(item.volume.value))}</strong>${escapeHTML(item.volume.formula)}</div>
        <ul><li><strong>${escapeHTML(cut.korean_label)}</strong></li>
        <li><strong>큰 원뿔의 높이</strong>: ${escapeHTML(cut.big_cone_height.expr)} ≈ ${escapeHTML(r9fmt(cut.big_cone_height.value))}</li>
        <li><strong>큰 원뿔의 부피</strong>: ${escapeHTML(cut.big_cone_volume.expr)} ≈ ${escapeHTML(r9fmt(cut.big_cone_volume.value))}</li>
        <li><strong>작은 원뿔의 높이</strong>: ${escapeHTML(cut.small_cone_height.expr)} ≈ ${escapeHTML(r9fmt(cut.small_cone_height.value))}</li>
        <li><strong>작은 원뿔의 부피</strong>: ${escapeHTML(r9fmt(cut.small_cone_volume.value))}</li></ul></section>`);
    }
    sections.push(`<section class="panel-section"><h3>표시 모델</h3><p>부피의 값과 비는 측정 데이터의 exact value가 권위입니다. 붓기 장면과 단면 그림은 그 관계를 보여 주는 표시이며, 화면을 재어서 부피를 구하지 않습니다.</p></section>`);
    refs.right.innerHTML = sections.join('');
  }

  /* ---------- rendering ---------- */
  function p13DrawVolumeStage() {
    const solidId = p13VolumeSolidId();
    p13ShowSolid(solidId);
    const inset = p13VolumeInset();
    r9SetHud({
      kicker: `${r009ChapterNo('volume')} · 부피`,
      title: `${p13SolidLabel(solidId)}의 부피`,
      subtitle: state.volumeMode === 'prism' ? '밑면이 높이만큼 쌓이는 과정을 옆에서 본 단면으로 확인합니다.' : state.volumeMode === 'cone' ? '뿔에 담은 양을 기둥에 부어 몇 번 만에 가득 차는지 확인합니다.' : state.volumeMode === 'sphere' ? '구와 꼭 맞는 원기둥을 나란히 놓고 비교합니다.' : '큰 원뿔에서 작은 원뿔을 뺀 부분이 원뿔대입니다.',
      progress: p13VolumeProgress(),
      legend: [{ cls: 'surface', label: '입체' }, { cls: 'plane', label: '옆에서 본 단면' }, { cls: 'focus', label: '채워진 양' }],
    });
    r9HideInset();
    p13StagePanel(inset.label, inset.svg);
    renderer.effectUntil = performance.now() + 190;
    renderer.requestRender();
    R009.lastDraw = () => p13DrawVolumeStage();
  }
  function p13DrawFill(value, announceChange = false) {
    state.volumeFill = clamp(Number(value) || 0, 0, 1);
    const inset = p13VolumeInset();
    p13StagePanel(inset.label, inset.svg);
    r009SetProgressUI('volumeFill', state.volumeFill);
    r009UpdateLiveGuide();
    if (announceChange) announce(`밑넓이를 높이의 ${Math.round(state.volumeFill * 100)}%까지 쌓았습니다.`);
  }
  function p13PredictionRow(name, options, current) {
    return `<div class="r009-prediction" role="group" aria-label="부피의 비 예측">${options.map(key => `<button class="choice-button ${current === key ? 'is-active' : ''}" type="button" data-volume-predict="${name}" data-volume-ratio="${key}">${P13_FRACTION_GLYPH[key] || key}</button>`).join('')}</div>`;
  }
  function renderVolume() {
    stopR007Playback();
    if (!p13VCase('V-PRISM-4')) { refs.left.innerHTML = '<section class="panel-section"><h2>부피 데이터를 불러오지 못했습니다.</h2></section>'; return; }
    let sections = '';
    if (state.volumeMode === 'prism') {
      const item = p13PillarCase();
      sections = `<section class="panel-section"><h3>기둥의 부피</h3>
        <div class="callout"><strong>부피 = 밑넓이 × 높이</strong>같은 밑면이 높이만큼 그대로 쌓입니다.</div>
        <label class="control-label" for="volumePillarSelect">기둥 고르기</label>
        <select id="volumePillarSelect">${P13_PILLAR_CASES.map(id => p13VCase(id)).filter(Boolean).map(entry => `<option value="${entry.id}" ${entry.id === state.volumePillar ? 'selected' : ''}>${escapeHTML(p13SolidLabel(entry.solid))}</option>`).join('')}</select>
        <div class="r009-status-line">밑넓이 ${escapeHTML(item.base_area.expr)} · 높이 ${escapeHTML(item.height.expr)}</div></section>
      <section class="panel-section"><h3>밑면을 높이만큼 쌓기</h3>
        <div class="r009-control-row"><span>0</span><input id="volumeFill" type="range" min="0" max="1" step="0.01" value="${state.volumeFill}" aria-label="쌓은 높이 비율"><output id="volumeFillValue" class="progress-value">${Math.round(state.volumeFill * 100)}%</output></div>
        <div class="r009-play-row"><button id="volumeFillPlay" class="action-button primary" type="button" aria-pressed="false">▶ 자동재생</button><button id="volumeFillEmpty" class="quiet-button" type="button">비우기</button><button id="volumeFillFull" class="quiet-button" type="button">가득</button></div>
        ${state.volumeFill >= .999 ? `<div class="callout success"><strong>부피 = ${escapeHTML(item.volume.expr)} ≈ ${escapeHTML(r9fmt(item.volume.value))}</strong>${escapeHTML(item.volume.formula)}</div>` : '<p class="small-note">끝까지 쌓으면 정확한 부피가 나타납니다.</p>'}</section>`;
    } else if (state.volumeMode === 'cone') {
      const relation = p13Relation(state.volumeRelation), pair = p13RelationPair(relation), locked = !state.volumeConePrediction;
      sections = `<section class="panel-section"><h3>뿔의 부피</h3>
        <label class="control-label" for="volumeRelationSelect">비교할 짝</label>
        <select id="volumeRelationSelect">${['REL-PYRAMID-THIRD', 'REL-CONE-THIRD'].filter(id => p13Relation(id)).map(id => `<option value="${id}" ${id === state.volumeRelation ? 'selected' : ''}>${escapeHTML(P13_RELATION_LABELS[id])}</option>`).join('')}</select>
        <p class="small-note">뿔의 부피는 같은 밑면·높이 기둥의 부피의 얼마일까요?</p>
        ${p13PredictionRow('cone', ['1/2', '1/3', '1/4'], state.volumeConePrediction)}
        ${locked ? '<p class="small-note">예상을 고르기 전에는 붓기를 시작할 수 없습니다.</p>' : ''}</section>
      <section class="panel-section"><h3>붓기 시뮬레이션</h3>
        <div class="r009-play-row"><button id="volumePour" class="action-button primary" type="button" ${locked ? 'disabled' : ''}>▶ 한 번 붓기</button><button id="volumePourReset" class="quiet-button" type="button" ${locked ? 'disabled' : ''}>처음부터</button></div>
        <div class="r009-status-line">${escapeHTML(state.volumePours ? `${P13_ORDINALS[state.volumePours]} 붓기 · ${state.volumePours}/3` : '아직 붓지 않았습니다')}</div>
        ${state.volumePours >= 3 ? `<div class="callout success"><strong>세 번을 부으니 기둥이 가득 찼습니다.</strong>${escapeHTML(relation.claim)} 비 = ${escapeHTML(relation.expected_ratio.expr)}<br>${escapeHTML(pair.coneLabel)} ${escapeHTML(pair.cone.volume.expr)} ≈ ${escapeHTML(r9fmt(pair.cone.volume.value))} · ${escapeHTML(pair.pillarLabel)} ${escapeHTML(pair.pillarVolume.expr)} ≈ ${escapeHTML(r9fmt(pair.pillarVolume.value))}</div>
        ${pair.reference ? `<p class="small-note">여기서 짝이 되는 원기둥은 밑면 반지름 ${escapeHTML(r9fmt(pair.reference.radius))}, 높이 ${escapeHTML(r9fmt(pair.reference.height))}인 원기둥입니다. 4장에 나온 반지름 ${escapeHTML(r9fmt(p13VCase('V-CYLINDER').dims.radius))}인 원기둥이 아닙니다.</p>` : ''}` : ''}
        ${state.volumeFeedback ? `<div class="callout"><strong>${escapeHTML(state.volumeFeedback)}</strong></div>` : ''}</section>`;
    } else if (state.volumeMode === 'sphere') {
      const relation = p13Relation('REL-SPHERE-TWO-THIRDS'), sphere = p13VCase('V-SPHERE');
      sections = `<section class="panel-section"><h3>구의 부피</h3>
        <p class="small-note">구에 꼭 맞는 원기둥과 비교하면 구의 부피는 그 얼마일까요?</p>
        ${p13PredictionRow('sphere', ['1/2', '2/3', '3/4'], state.volumeSpherePrediction)}
        ${state.volumeSpherePrediction ? '' : '<p class="small-note">예상을 고르기 전에는 결과를 보여 주지 않습니다.</p>'}</section>
      ${state.volumeSpherePrediction ? `<section class="panel-section"><h3>꼭 맞는 원기둥과 비교</h3>
        <div class="callout success"><strong>${escapeHTML(relation.claim)}</strong>비 = ${escapeHTML(relation.expected_ratio.expr)}</div>
        <div class="formula-box">구의 부피 = ${escapeHTML(sphere.volume.formula)} = ${escapeHTML(sphere.volume.expr)} ≈ ${escapeHTML(r9fmt(sphere.volume.value))}<br>${escapeHTML(relation.matched_reference.korean_label)} = ${escapeHTML(relation.matched_reference.volume.expr)} ≈ ${escapeHTML(r9fmt(relation.matched_reference.volume.value))}</div>
        ${state.volumeFeedback ? `<p class="small-note">${escapeHTML(state.volumeFeedback)}</p>` : ''}</section>` : ''}`;
    } else {
      const item = p13VCase('V-FRUSTUM-CONE'), cut = item.cut_cone;
      sections = `<section class="panel-section"><h3>원뿔대의 부피 · 심화</h3>
        <div class="callout"><strong>${escapeHTML(cut.korean_label)}</strong>원뿔대는 큰 원뿔에서 작은 원뿔을 잘라낸 나머지입니다.</div>
        <div class="formula-box">큰 원뿔 ${escapeHTML(cut.big_cone_volume.expr)} ≈ ${escapeHTML(r9fmt(cut.big_cone_volume.value))}<br>− 작은 원뿔 ≈ ${escapeHTML(r9fmt(cut.small_cone_volume.value))}<br>= 원뿔대 ${escapeHTML(item.volume.expr)} ≈ ${escapeHTML(r9fmt(item.volume.value))}</div>
        <p class="small-note">원뿔대의 부피는 중학교 1학년 평가 범위가 아닌 심화 관찰입니다.</p></section>`;
    }
    refs.left.innerHTML = `<section class="panel-section"><p class="eyebrow">${r009ChapterNo('volume')} · 부피</p><h2>쌓아 보고, 부어 보고, 비교하기</h2>
      <p>기둥은 밑면이 쌓인 양으로, 뿔과 구는 기둥과 비교해 부피를 알아봅니다.</p>
      <label class="control-label" for="volumeModeSelect">탐구할 입체</label>
      <select id="volumeModeSelect">${P13_VOLUME_MODES.map(mode => `<option value="${mode.key}" ${mode.key === state.volumeMode ? 'selected' : ''}>${escapeHTML(mode.label)}</option>`).join('')}</select></section>${sections}`;
    p13VolumeEvidence();
    p13DrawVolumeStage();
    $('#volumeModeSelect', refs.left).addEventListener('change', event => {
      stopR007Playback();
      state.volumeMode = event.target.value;
      p13ResetVolumeState();
      renderer.resetView('solid');
      renderVolume();
      announce(`${P13_VOLUME_MODES.find(mode => mode.key === state.volumeMode).label}의 부피 탐구로 바꿨습니다.`);
    });
    $('#volumePillarSelect', refs.left)?.addEventListener('change', event => {
      stopR007Playback();
      state.volumePillar = event.target.value;
      state.volumeFill = 0;
      renderer.resetView('solid');
      renderVolume();
      announce(`${p13SolidLabel(p13PillarCase().solid)}의 부피를 봅니다.`);
    });
    $('#volumeRelationSelect', refs.left)?.addEventListener('change', event => {
      stopR007Playback();
      state.volumeRelation = event.target.value;
      state.volumePours = 0;
      state.volumeConePrediction = null;
      state.volumeFeedback = null;
      renderer.resetView('solid');
      renderVolume();
      announce(`${P13_RELATION_LABELS[state.volumeRelation]} 비교로 바꿨습니다.`);
    });
    $('#volumeFill', refs.left)?.addEventListener('input', event => { stopR007Playback(); p13DrawFill(Number(event.target.value)); });
    $('#volumeFillPlay', refs.left)?.addEventListener('click', () => state.r007Playing ? stopR007Playback({ announceStop: true }) : startR007Playback('volumeFill', p13DrawFill, 8));
    $('#volumeFillEmpty', refs.left)?.addEventListener('click', () => { stopR007Playback(); p13DrawFill(0, true); });
    $('#volumeFillFull', refs.left)?.addEventListener('click', () => { stopR007Playback(); p13DrawFill(1, true); renderVolume(); });
    $$('[data-volume-predict]', refs.left).forEach(button => button.addEventListener('click', () => {
      const ratio = button.dataset.volumeRatio;
      if (button.dataset.volumePredict === 'cone') {
        const relation = p13Relation(state.volumeRelation);
        state.volumeConePrediction = ratio;
        state.volumeFeedback = ratio === relation.expected_ratio.expr ? '예상을 기록했습니다. 직접 부어서 확인해 보세요.' : '예상을 기록했습니다. 실제로 몇 번 부어야 가득 차는지 확인해 보세요.';
      } else {
        const relation = p13Relation('REL-SPHERE-TWO-THIRDS');
        state.volumeSpherePrediction = ratio;
        state.volumeFeedback = ratio === relation.expected_ratio.expr ? '예상이 실제 비와 같습니다. 아래에서 근거를 확인하세요.' : '예상과 실제 비를 아래에서 비교해 보세요.';
      }
      renderVolume();
      announce(state.volumeFeedback);
    }));
    $('#volumePour', refs.left)?.addEventListener('click', () => {
      state.volumePours = Math.min(3, state.volumePours + 1);
      state.volumeFeedback = state.volumePours >= 3 ? '세 번째 붓기로 기둥이 가득 찼습니다.' : `${P13_ORDINALS[state.volumePours]} 붓기를 마쳤습니다.`;
      renderVolume();
      announce(state.volumeFeedback);
    });
    $('#volumePourReset', refs.left)?.addEventListener('click', () => {
      state.volumePours = 0;
      state.volumeFeedback = null;
      renderVolume();
      announce('붓기를 처음부터 다시 시작합니다.');
    });
    requestAnimationFrame(() => r009AfterRender());
  }
  function p13ResetVolumeState() {
    state.volumeFill = 0;
    state.volumePours = 0;
    state.volumeConePrediction = null;
    state.volumeSpherePrediction = null;
    state.volumeFeedback = null;
  }
