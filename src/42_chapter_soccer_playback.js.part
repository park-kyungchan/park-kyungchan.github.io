  let soccerAnimationHandle = null;
  let soccerAnimationLast = 0;
  function soccerStage(progress=state.soccerProgress) {
    const p=clamp(progress,0,1);
    if(p<.10)return {index:1,total:4,title:'원래 꼭짓점 찾기',detail:'정이십면체의 꼭짓점 12개를 먼저 확인합니다.'};
    if(p<.72)return {index:2,total:4,title:'같은 비율로 자르기',detail:'모든 꼭짓점을 같은 비율로 천천히 잘라 냅니다.'};
    if(p<.92)return {index:3,total:4,title:'새 면 자리 잡기',detail:'잘라 낸 자리에는 오각형이 생기고, 삼각형은 육각형으로 바뀝니다.'};
    return {index:4,total:4,title:'완성 모양 확인',detail:'꼭짓점·모서리·면의 수와 V−E+F를 확인합니다.'};
  }
  function stopSoccerPlayback() {
    state.soccerPlaying=false;
    if(soccerAnimationHandle)cancelAnimationFrame(soccerAnimationHandle);
    soccerAnimationHandle=null;soccerAnimationLast=0;
    const button=$('#soccerPlayToggle',refs.left);if(button){button.textContent='▶ 자동 영상';button.setAttribute('aria-pressed','false');}
  }
  function applySoccerProgress(value,{announceChange=true,syncSlider=true}={}) {
    state.soccerProgress=clamp(value,0,1);
    renderer.setSoccer(state.soccerProgress,state.soccerInflated);
    renderer.setViewStyle('solid');renderer.setLabelMode(state.soccerProgress<.001?'vertices':'none');
    const slider=$('#soccerSlider',refs.left),label=$('#soccerValue',refs.left),stage=soccerStage();
    if(syncSlider&&slider)slider.value=String(Math.round(state.soccerProgress*100));
    if(label)label.textContent=`${Math.round(state.soccerProgress*100)}%`;
    const title=$('#soccerStageTitle',refs.left),detail=$('#soccerStageDetail',refs.left),meter=$('#soccerStageMeter',refs.left);
    if(title)title.textContent=stage.title;if(detail)detail.textContent=stage.detail;if(meter)meter.textContent=`${stage.index}/${stage.total}`;
    refreshUniversalMapping();
    if(announceChange)announce(`${stage.index}/${stage.total} · ${stage.title}: ${stage.detail}`);
  }
  function startSoccerPlayback() {
    stopSoccerPlayback();state.soccerPlaying=true;
    if(state.soccerProgress>=.999)state.soccerProgress=0;
    const button=$('#soccerPlayToggle',refs.left);if(button){button.textContent='Ⅱ 일시정지';button.setAttribute('aria-pressed','true');}
    if(state.reducedMotion){
      const states=[0,.38,.78,1];
      states.forEach((v,i)=>setTimeout(()=>{if(!state.soccerPlaying||state.tab!=='soccer'||document.hidden)return;applySoccerProgress(v,{announceChange:true});if(v===1)stopSoccerPlayback();},i*1800));
      return;
    }
    const tick=t=>{
      if(!state.soccerPlaying||state.tab!=='soccer'||document.hidden){stopSoccerPlayback();return;}
      if(!soccerAnimationLast)soccerAnimationLast=t;
      const dt=Math.min(.05,(t-soccerAnimationLast)/1000);soccerAnimationLast=t;
      const next=Math.min(1,state.soccerProgress+dt/Math.max(10,state.soccerSeconds));
      applySoccerProgress(next,{announceChange:false});
      renderSoccerDockOnly();
      if(next>=1){stopSoccerPlayback();announce('축구공 다면체 자동 영상이 끝났습니다.');return;}
      soccerAnimationHandle=requestAnimationFrame(tick);
    };
    soccerAnimationHandle=requestAnimationFrame(tick);
  }


