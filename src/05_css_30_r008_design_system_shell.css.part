/* ===== P003 R008 MODULED DESIGN SYSTEM ===== */
/* P003 R008 — artifact-level design tokens.
   iOS 26 / Liquid Glass is used as WEB_R0 inspiration only, not as a project core rule. */
:root {
  color-scheme: light;

  /* Color system */
  --r8-canvas-0: #eef2f8;
  --r8-canvas-1: #f7f8fc;
  --r8-canvas-2: #e9eff9;
  --r8-stage-0: #edf5ff;
  --r8-stage-1: #f8fbff;
  --r8-stage-2: #f6f1ff;
  --r8-ink: #121d2f;
  --r8-ink-strong: #07111f;
  --r8-ink-secondary: #536277;
  --r8-ink-tertiary: #616e82;
  --r8-separator: rgba(24, 48, 82, .12);
  --r8-separator-strong: rgba(24, 48, 82, .22);
  --r8-glass: rgba(255, 255, 255, .66);
  --r8-glass-strong: rgba(255, 255, 255, .84);
  --r8-glass-solid: rgba(250, 252, 255, .96);
  --r8-glass-edge: rgba(255, 255, 255, .82);
  --r8-accent: #0a68ff;
  --r8-accent-text: #0060fb;   /* P1-4: AA-safe accent for text only */
  --r8-accent-2: #6c4cff;
  --r8-cyan: #00a7d8;
  --r8-teal: #0c956a;
  --r8-amber: #b66a05;
  --r8-rose: #d83e67;
  --r8-success: #067951;
  --r8-danger: #b92f50;
  --r8-focus: #005ce6;

  /* Type scale */
  --r8-font-ui: "Gaegu", -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "Apple SD Gothic Neo", "Noto Sans KR", "Malgun Gothic", system-ui, sans-serif;
  --r8-font-display: "Gaegu", -apple-system, BlinkMacSystemFont, "SF Pro Display", "Apple SD Gothic Neo", "Noto Sans KR", system-ui, sans-serif;
  --r8-type-11: .80rem;
  --r8-type-12: .84rem;
  --r8-type-13: .88rem;
  --r8-type-15: .98rem;
  --r8-type-17: 1.10rem;
  --r8-type-20: 1.30rem;
  --r8-type-24: 1.5rem;
  --r8-type-32: 2rem;

  /* Spacing and shape */
  --r8-space-1: 4px;
  --r8-space-2: 8px;
  --r8-space-3: 12px;
  --r8-space-4: 16px;
  --r8-space-5: 20px;
  --r8-space-6: 24px;
  --r8-space-8: 32px;
  --r8-radius-10: 10px;
  --r8-radius-14: 14px;
  --r8-radius-18: 18px;
  --r8-radius-24: 24px;
  --r8-radius-30: 30px;
  --r8-radius-pill: 999px;
  --r8-control-min: 46px;
  --r8-touch-min: 44px;
  --r8-panel-width: clamp(292px, 23vw, 356px);
  --r8-header-height: 64px;
  --r8-tabs-height: 58px;
  --r8-footer-height: 48px;
  --r8-transport-height: 78px;

  /* Elevation and optical material */
  --r8-shadow-shell: 0 24px 60px rgba(30, 50, 81, .16), 0 3px 14px rgba(30, 50, 81, .08);
  --r8-shadow-float: 0 18px 42px rgba(31, 55, 92, .18), 0 2px 10px rgba(31, 55, 92, .08);
  --r8-shadow-control: 0 8px 20px rgba(31, 55, 92, .10), inset 0 1px 0 rgba(255,255,255,.88);
  --r8-shadow-pressed: 0 3px 9px rgba(31, 55, 92, .10), inset 0 1px 0 rgba(255,255,255,.74);
  --r8-blur: 26px;
  --r8-saturation: 150%;

  /* Motion */
  --r8-ease-spring: cubic-bezier(.22, .82, .24, 1);
  --r8-ease-settle: cubic-bezier(.2, .7, .2, 1);
  --r8-duration-fast: 150ms;
  --r8-duration: 240ms;
  --r8-duration-slow: 420ms;
}

@supports (color: oklch(70% .15 250)) {
  :root {
    --r8-accent: oklch(62% .235 257);
    --r8-accent-2: oklch(61% .22 295);
    --r8-teal: oklch(59% .15 165);
    --r8-amber: oklch(67% .16 74);
    --r8-rose: oklch(62% .20 10);
  }
}

/* P003 R008 — fixed two-panel shell. There are no resize handles and no bottom/right fixed panels. */
html { overflow: hidden !important; background: var(--r8-canvas-0); }
body {
  font-family: var(--r8-font-ui) !important;
  color: var(--r8-ink) !important;
  overflow: hidden !important;
  background:
    radial-gradient(1200px 640px at 8% -8%, rgba(71, 154, 255, .22), transparent 58%),
    radial-gradient(1040px 640px at 96% 7%, rgba(127, 95, 255, .17), transparent 58%),
    linear-gradient(145deg, var(--r8-canvas-1), var(--r8-canvas-0) 58%, #f7f4ff) !important;
  letter-spacing: -.018em;
}
body::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -3;
  pointer-events: none;
  background-image: radial-gradient(rgba(23, 60, 104, .08) .55px, transparent .55px);
  background-size: 18px 18px;
  mask-image: linear-gradient(180deg, rgba(0,0,0,.18), transparent 34%, transparent 70%, rgba(0,0,0,.12));
}
.ambient-field { display: none !important; }

.glass-surface,
.r8-glass {
  background: linear-gradient(145deg, rgba(255,255,255,.78), rgba(244,248,255,.54)) !important;
  border: 1px solid var(--r8-glass-edge) !important;
  box-shadow: var(--r8-shadow-shell) !important;
  backdrop-filter: blur(var(--r8-blur)) saturate(var(--r8-saturation));
  -webkit-backdrop-filter: blur(var(--r8-blur)) saturate(var(--r8-saturation));
}
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .glass-surface, .r8-glass { background: var(--r8-glass-solid) !important; }
}
.glass-surface::after { opacity: .26 !important; }

.app-header {
  height: var(--r8-header-height) !important;
  min-height: var(--r8-header-height) !important;
  margin: 8px 10px 0 !important;
  padding: 8px 10px 8px 12px !important;
  border-radius: var(--r8-radius-24) !important;
  z-index: 70 !important;
}
.brand-lockup { gap: 10px !important; }
.brand-mark {
  width: 44px !important;
  height: 44px !important;
  flex-basis: 44px !important;
  border-radius: 15px !important;
  background:
    radial-gradient(circle at 28% 18%, rgba(255,255,255,.78), transparent 28%),
    linear-gradient(145deg, var(--r8-accent), var(--r8-accent-2) 76%) !important;
  box-shadow: 0 10px 24px rgba(54, 95, 238, .28), inset 0 1px 0 rgba(255,255,255,.64) !important;
}
.brand-mark svg { width: 28px !important; height: 28px !important; }
.title-block h1 {
  font-family: var(--r8-font-display) !important;
  font-size: clamp(1.14rem, 1.65vw, 1.48rem) !important;
  letter-spacing: -.052em !important;
}
.title-block .eyebrow { color: var(--r8-accent-text) !important; font-size: var(--r8-type-11) !important; }
.header-actions { gap: 6px !important; }
#layoutPresetButton { display: none !important; }
.header-actions .glass-button.compact {
  min-height: 44px !important;
  border-radius: var(--r8-radius-pill) !important;
  padding: 8px 12px !important;
  background: rgba(255,255,255,.55) !important;
  border-color: rgba(255,255,255,.72) !important;
  box-shadow: var(--r8-shadow-control) !important;
}

.lab-tabs {
  height: var(--r8-tabs-height) !important;
  min-height: var(--r8-tabs-height) !important;
  margin: 7px 10px 0 !important;
  padding: 5px !important;
  gap: 4px !important;
  border-radius: 22px !important;
  z-index: 60 !important;
  scroll-padding-inline: 8px;
  scrollbar-width: none !important;
}
.lab-tabs::-webkit-scrollbar { display: none; }
.tab-button {
  flex: 0 0 121px !important;
  min-width: 121px !important;
  min-height: 46px !important;
  padding: 5px 8px !important;
  border-radius: 16px !important;
  gap: 8px !important;
  color: var(--r8-ink-secondary) !important;
  transition: transform var(--r8-duration) var(--r8-ease-spring), background var(--r8-duration), box-shadow var(--r8-duration) !important;
}
.tab-symbol {
  width: 30px !important;
  height: 30px !important;
  flex-basis: 30px !important;
  border-radius: 10px !important;
  background: rgba(10,104,255,.08) !important;
  border: 0 !important;
}
.tab-copy strong { font-size: .84rem !important; letter-spacing: -.02em; }
.tab-copy small { font-size: .78rem !important; margin-top: 2px !important; line-height: 1.2 !important; }
.tab-button.is-active {
  color: var(--r8-ink-strong) !important;
  background: rgba(255,255,255,.77) !important;
  border-color: rgba(255,255,255,.9) !important;
  box-shadow: 0 8px 22px rgba(38,65,105,.13), inset 0 1px 0 rgba(255,255,255,.94) !important;
}
.tab-button.is-active .tab-symbol {
  background: linear-gradient(145deg, var(--r8-accent), var(--r8-accent-2)) !important;
  box-shadow: 0 7px 16px rgba(61, 86, 226, .24) !important;
}

.app-main {
  height: calc(100dvh - var(--r8-header-height) - var(--r8-tabs-height) - var(--r8-footer-height) - 30px) !important;
  min-height: 520px !important;
  display: grid !important;
  grid-template-columns: var(--r8-panel-width) minmax(0, 1fr) !important;
  gap: 10px !important;
  padding: 8px 10px 6px !important;
}
.app-main.controls-collapsed { grid-template-columns: minmax(0, 1fr) !important; }
.panel-resize-handle,
#panelResizeHandle,
#rightResizeHandle,
#dockResizeHandle,
.dock-resize-handle,
.dock-size-button { display: none !important; }

.controls-panel {
  grid-column: 1 !important;
  min-width: 0 !important;
  max-width: none !important;
  border-radius: var(--r8-radius-30) !important;
  padding: 17px 15px 22px !important;
  background: rgba(251,253,255,.82) !important;
  border: 1px solid rgba(255,255,255,.92) !important;
  box-shadow: var(--r8-shadow-shell) !important;
  overflow-x: hidden !important;
  overflow-y: auto !important;
}
.controls-panel::-webkit-scrollbar { width: 8px; }
.controls-panel::-webkit-scrollbar-thumb { background: rgba(67, 91, 124, .20); border-radius: 999px; border: 2px solid transparent; background-clip: padding-box; }
.app-main.controls-collapsed .controls-panel { display: none !important; }

.viewer-stage {
  grid-column: 2 !important;
  min-width: 0 !important;
  min-height: 0 !important;
  border-radius: var(--r8-radius-30) !important;
  overflow: hidden !important;
  background:
    radial-gradient(760px 520px at 18% 8%, rgba(86, 169, 255, .25), transparent 64%),
    radial-gradient(680px 500px at 88% 18%, rgba(125, 100, 255, .20), transparent 66%),
    linear-gradient(160deg, var(--r8-stage-1), var(--r8-stage-0) 48%, var(--r8-stage-2)) !important;
  border: 1px solid rgba(255,255,255,.88) !important;
  box-shadow: var(--r8-shadow-shell) !important;
}
.app-main.controls-collapsed .viewer-stage { grid-column: 1 !important; }
.stage-background {
  background:
    radial-gradient(circle at 50% 18%, rgba(255,255,255,.76), transparent 38%),
    linear-gradient(180deg, rgba(255,255,255,.25), rgba(224,236,252,.12)) !important;
}
#glCanvas, #labelCanvas, .stage-background, .module-overlay {
  height: 100% !important;
  inset: 0 !important;
}
.module-overlay {
  padding: 0 !important;
  overflow: hidden !important;
  background: transparent !important;
  z-index: 4 !important;
}
.viewer-toolbar {
  left: 16px !important;
  top: 62px !important;
  border-radius: var(--r8-radius-pill) !important;
  padding: 5px !important;
  gap: 3px !important;
  background: rgba(255,255,255,.62) !important;
  box-shadow: var(--r8-shadow-float) !important;
}
.tool-button {
  min-height: 44px !important;
  border-radius: 14px !important;
  padding: 8px 10px !important;
  box-shadow: none !important;
  background: transparent !important;
  border-color: transparent !important;
}
.tool-button.is-active { background: rgba(255,255,255,.88) !important; box-shadow: 0 5px 14px rgba(31,55,92,.11) !important; }
.stage-topline { top: 14px !important; left: 16px !important; right: 16px !important; z-index: 18 !important; }
.stage-status, .fold-stage-badge, .viewer-hint {
  background: rgba(255,255,255,.66) !important;
  border: 1px solid rgba(255,255,255,.88) !important;
  box-shadow: var(--r8-shadow-control) !important;
  backdrop-filter: blur(18px) saturate(140%);
  -webkit-backdrop-filter: blur(18px) saturate(140%);
}
.viewer-hint {
  bottom: calc(var(--r8-transport-height) + 17px) !important;
  left: 18px !important;
  transform: none !important;
  max-width: min(560px, calc(100% - 36px)) !important;
  font-size: var(--r8-type-11) !important;
  z-index: 15 !important;
}

/* The former bottom dock is now a floating transport control, not a panel. */
.learning-dock,
#centerLearningDock {
  position: absolute !important;
  left: 50% !important;
  right: auto !important;
  bottom: 14px !important;
  top: auto !important;
  transform: translateX(-50%) !important;
  width: min(880px, calc(100% - 32px)) !important;
  height: var(--r8-transport-height) !important;
  min-height: var(--r8-transport-height) !important;
  border-radius: 24px !important;
  z-index: 30 !important;
  background: rgba(255,255,255,.68) !important;
  border: 1px solid rgba(255,255,255,.9) !important;
  box-shadow: var(--r8-shadow-float) !important;
  overflow: visible !important;
}
.learning-dock-content {
  position: static !important;
  inset: auto !important;
  width: 100% !important;
  height: 100% !important;
  padding: 8px 10px !important;
  overflow: visible !important;
}

/* Live explanation floats in the upper-right of the stage. */
.live-guide {
  position: absolute;
  z-index: 26;
  top: 66px;
  right: 16px;
  width: min(348px, calc(100% - 32px));
  min-height: 126px;
  padding: 13px 14px 14px;
  border-radius: 22px;
  background:
    radial-gradient(circle at 88% 5%, rgba(255,255,255,.95), transparent 35%),
    linear-gradient(145deg, rgba(255,255,255,.82), rgba(236,244,255,.62));
  border: 1px solid rgba(255,255,255,.92);
  box-shadow: var(--r8-shadow-float);
  backdrop-filter: blur(24px) saturate(150%);
  -webkit-backdrop-filter: blur(24px) saturate(150%);
  pointer-events: none;
  transition: transform var(--r8-duration) var(--r8-ease-spring), opacity var(--r8-duration);
}
.live-guide::before {
  content: "";
  position: absolute;
  inset: 1px;
  border-radius: inherit;
  pointer-events: none;
  background: linear-gradient(120deg, rgba(255,255,255,.55), transparent 30%, transparent 72%, rgba(124,166,255,.12));
}
.live-guide > * { position: relative; z-index: 1; }
.live-guide-kicker { display: flex; align-items: center; justify-content: space-between; gap: 8px; color: var(--r8-accent-text); font-size: var(--r8-type-11); font-weight: 850; letter-spacing: .03em; }
.live-guide-step { display: inline-flex; min-height: 26px; align-items: center; padding: 3px 8px; border-radius: var(--r8-radius-pill); color: #36506e; background: rgba(255,255,255,.72); border: 1px solid rgba(24,48,82,.10); font-size: .80rem; }
.live-guide h2 { margin: 9px 0 5px; color: var(--r8-ink-strong); font-size: var(--r8-type-17); line-height: 1.28; letter-spacing: -.03em; }
.live-guide p { margin: 0; color: var(--r8-ink-secondary); font-size: var(--r8-type-12); line-height: 1.5; }
.live-guide-chips { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 9px; }
.live-guide-chips span { min-height: 25px; display: inline-flex; align-items: center; padding: 3px 8px; border-radius: var(--r8-radius-pill); color: #36516d; background: rgba(255,255,255,.66); border: 1px solid rgba(24,48,82,.09); font-size: .79rem; line-height: 1.35; font-weight: 760; }
.live-guide.is-pulsing { animation: r8-guide-pulse .46s var(--r8-ease-spring); }
@keyframes r8-guide-pulse { 0% { transform: scale(.985); opacity: .82; } 100% { transform: scale(1); opacity: 1; } }

/* Evidence is an optional sheet. It does not occupy a third column. */
.evidence-dialog {
  width: min(650px, calc(100vw - 28px));
  max-height: min(82dvh, 780px);
  margin: auto;
  padding: 0;
  border: 0;
  border-radius: 30px;
  color: var(--r8-ink);
  background: transparent;
  box-shadow: var(--r8-shadow-float);
  overflow: hidden;
}
.evidence-dialog::backdrop { background: rgba(12, 23, 39, .31); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
.evidence-dialog-shell { display: grid; grid-template-rows: auto minmax(0,1fr); max-height: inherit; background: rgba(248,251,255,.95); border: 1px solid rgba(255,255,255,.92); }
.evidence-dialog-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 16px; border-bottom: 1px solid var(--r8-separator); background: rgba(255,255,255,.70); }
.evidence-dialog-header div { min-width: 0; }
.evidence-dialog-header p { margin: 0 0 2px; color: var(--r8-accent-text); font-size: var(--r8-type-11); font-weight: 850; }
.evidence-dialog-header h2 { margin: 0; color: var(--r8-ink-strong); font-size: var(--r8-type-20); letter-spacing: -.035em; }
.evidence-dialog-close { width: 44px; min-width: 44px; height: 44px; border: 0; border-radius: 50%; color: var(--r8-ink); background: rgba(24,48,82,.08); cursor: pointer; font-size: 1.25rem; }
.evidence-content { min-height: 180px; overflow: auto; padding: 8px 17px 22px; }

.app-footer {
  min-height: var(--r8-footer-height) !important;
  height: var(--r8-footer-height) !important;
  margin: 0 10px 6px !important;
  padding: 4px 9px !important;
  border-radius: 20px !important;
  box-shadow: 0 9px 26px rgba(31,55,92,.11) !important;
  z-index: 50 !important;
}
.chapter-nav button { min-height: 40px !important; border-radius: 14px !important; }
.footer-scope { font-size: .79rem !important; }

@media (max-width: 1040px) {
  :root { --r8-panel-width: 276px; }
  .live-guide { width: min(320px, calc(100% - 28px)); right: 14px; }
  .tab-button { flex-basis: 112px !important; min-width: 112px !important; }
}
@media (max-width: 820px) {
  html, body { overflow: auto !important; }
  body { min-height: 100dvh; }
  .app-main {
    height: auto !important;
    min-height: 0 !important;
    grid-template-columns: minmax(0,1fr) !important;
    padding: 7px !important;
  }
  .viewer-stage { grid-column: 1 !important; grid-row: 1 !important; min-height: 680px !important; }
  .controls-panel { grid-column: 1 !important; grid-row: 2 !important; border-radius: 28px !important; margin-top: 3px; }
  .app-main.controls-collapsed .controls-panel { display: none !important; }
  .live-guide { top: 64px; right: 12px; width: min(310px, calc(100% - 24px)); }
  .viewer-toolbar { top: auto !important; bottom: calc(var(--r8-transport-height) + 18px) !important; }
  .viewer-hint { display: none !important; }
  .app-footer { position: sticky !important; bottom: 4px !important; }
}
@media (max-width: 560px) {
  :root { --r8-header-height: 58px; --r8-tabs-height: 54px; --r8-transport-height: 92px; }
  .app-header { margin-inline: 5px !important; padding-inline: 7px !important; border-radius: 21px !important; }
  .brand-mark { width: 38px !important; height: 38px !important; flex-basis: 38px !important; border-radius: 13px !important; }
  .title-block h1 { font-size: 1.02rem !important; }
  .title-block .eyebrow { font-size: .78rem !important; }
  .header-actions .glass-button.compact span:last-child { display: none; }
  .header-actions .glass-button.compact { width: 42px; min-width: 42px; min-height: 42px !important; padding: 4px !important; justify-content: center; }
  .lab-tabs { margin-inline: 5px !important; border-radius: 18px !important; }
  .tab-button { flex-basis: 104px !important; min-width: 104px !important; }
  .tab-copy small { display: none; }
  .viewer-stage { min-height: 640px !important; border-radius: 24px !important; }
  .live-guide { top: 61px; left: 10px; right: 10px; width: auto; min-height: 110px; padding: 11px 12px; border-radius: 19px; }
  .live-guide h2 { font-size: 1.02rem; }
  .live-guide p { font-size: .82rem; }
  .learning-dock, #centerLearningDock { width: calc(100% - 20px) !important; bottom: 10px !important; border-radius: 21px !important; }
  .viewer-toolbar { display: none !important; }
  .stage-topline { left: 10px !important; right: 10px !important; top: 10px !important; }
  .app-footer { margin-inline: 5px !important; grid-template-columns: 1fr !important; height: auto !important; min-height: 48px !important; }
  .footer-scope { display: none !important; }
  .chapter-nav { justify-content: space-between; }
}

@media (prefers-reduced-motion: reduce) {
  :root { --r8-duration-fast: 0ms; --r8-duration: 0ms; --r8-duration-slow: 0ms; }
  .live-guide, .live-guide.is-pulsing, .tab-button, button { animation: none !important; transition: none !important; }
}

