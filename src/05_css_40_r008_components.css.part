/* P003 R008 — controls, transport, stage content, and spatial canvas components. */
button, select, input, textarea { font-family: var(--r8-font-ui) !important; }
button:focus-visible, select:focus-visible, input:focus-visible, textarea:focus-visible, [tabindex]:focus-visible {
  outline: 3px solid var(--r8-focus) !important;
  outline-offset: 3px !important;
}
.glass-button, .tool-button, .tab-button, .action-button, .choice-button, .chip-button, .quiet-button,
.r007-global-controls button, .chapter-nav button {
  min-height: var(--r8-control-min) !important;
  border-radius: var(--r8-radius-14) !important;
  border: 1px solid rgba(24,48,82,.10) !important;
  color: var(--r8-ink) !important;
  background: linear-gradient(145deg, rgba(255,255,255,.86), rgba(244,248,255,.68)) !important;
  box-shadow: var(--r8-shadow-control) !important;
  transition: transform var(--r8-duration) var(--r8-ease-spring), box-shadow var(--r8-duration), background var(--r8-duration) !important;
}
.glass-button:hover, .tool-button:hover, .tab-button:hover, .action-button:hover, .choice-button:hover, .chip-button:hover, .quiet-button:hover,
.r007-global-controls button:hover, .chapter-nav button:hover { transform: translateY(-1px) scale(1.006); }
.glass-button:active, .tool-button:active, .tab-button:active, .action-button:active, .choice-button:active, .chip-button:active, .quiet-button:active,
.r007-global-controls button:active, .chapter-nav button:active { transform: translateY(1px) scale(.978); box-shadow: var(--r8-shadow-pressed) !important; }
.action-button.primary, .r8-primary {
  color: white !important;
  border-color: transparent !important;
  background: linear-gradient(145deg, var(--r8-accent), var(--r8-accent-2)) !important;
  box-shadow: 0 10px 22px rgba(48, 85, 230, .26), inset 0 1px 0 rgba(255,255,255,.38) !important;
}
.action-button.success { color: #07573f !important; background: linear-gradient(145deg,#f0fff8,#dcf8ec) !important; border-color: rgba(6,121,81,.18) !important; }
.choice-button.is-selected, .chip-button.is-active { color: #004da8 !important; background: #eaf3ff !important; border-color: rgba(10,104,255,.34) !important; }

.panel h2 { color: var(--r8-ink-strong) !important; font-size: var(--r8-type-20) !important; letter-spacing: -.04em !important; }
.panel h3 { color: #31445f !important; font-size: var(--r8-type-15) !important; }
.panel p, .panel li, .small-note, .callout { font-size: var(--r8-type-13) !important; }
.panel-section { padding: 12px 0 !important; border-top-color: var(--r8-separator) !important; }
.callout {
  border-radius: var(--r8-radius-14) !important;
  background: rgba(237,244,255,.72) !important;
  border: 1px solid rgba(10,104,255,.13) !important;
  box-shadow: inset 0 1px 0 rgba(255,255,255,.78);
}
.callout.success { background: rgba(232,250,242,.84) !important; border-color: rgba(6,121,81,.15) !important; }
select, input[type="number"], textarea {
  min-height: 46px !important;
  border-radius: var(--r8-radius-14) !important;
  border: 1px solid rgba(24,48,82,.13) !important;
  color: var(--r8-ink) !important;
  background: rgba(255,255,255,.76) !important;
  box-shadow: inset 0 1px 0 rgba(255,255,255,.9) !important;
}
input[type="range"] { accent-color: var(--r8-accent); }

/* Duplicate floating transport removed in R009. */

/* Spatial module canvases */
.r008-spatial-module {
  position: absolute;
  inset: 0;
  overflow: hidden;
  background:
    radial-gradient(760px 520px at 16% 10%, rgba(82,172,255,.18), transparent 66%),
    radial-gradient(640px 480px at 88% 18%, rgba(120,93,255,.16), transparent 68%),
    linear-gradient(160deg, rgba(249,252,255,.86), rgba(231,241,253,.78) 52%, rgba(244,239,255,.80));
}
.r008-spatial-canvas { display: block; width: 100%; height: 100%; touch-action: none; }
.r008-spatial-title {
  position: absolute;
  z-index: 8;
  left: 18px;
  top: 68px;
  max-width: min(520px, calc(100% - 390px));
  padding: 12px 14px;
  border-radius: 20px;
  color: var(--r8-ink);
  background: rgba(255,255,255,.58);
  border: 1px solid rgba(255,255,255,.86);
  box-shadow: 0 12px 30px rgba(31,55,92,.13);
  backdrop-filter: blur(18px) saturate(145%);
  -webkit-backdrop-filter: blur(18px) saturate(145%);
  pointer-events: none;
}
.r008-spatial-title p { margin: 0 0 3px; color: var(--r8-accent); font-size: .68rem; font-weight: 850; }
.r008-spatial-title h2 { margin: 0; color: var(--r8-ink-strong); font-size: clamp(1.05rem, 1.9vw, 1.42rem); letter-spacing: -.045em; }
.r008-spatial-title span { display: block; margin-top: 4px; color: var(--r8-ink-secondary); font-size: .72rem; }
.r008-spatial-legend {
  position: absolute;
  z-index: 8;
  left: 18px;
  bottom: calc(var(--r8-transport-height) + 20px);
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  max-width: min(650px, calc(100% - 38px));
  pointer-events: none;
}
.r008-spatial-legend span { min-height: 28px; display: inline-flex; align-items: center; gap: 6px; padding: 4px 9px; border-radius: 999px; color: #36516d; background: rgba(255,255,255,.66); border: 1px solid rgba(255,255,255,.88); box-shadow: 0 7px 18px rgba(31,55,92,.09); font-size: .66rem; font-weight: 760; backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
.r008-dot { width: 8px; height: 8px; border-radius: 50%; background: currentColor; box-shadow: 0 0 0 3px rgba(255,255,255,.62); }
.r008-dot.axis { color: var(--r8-amber); }
.r008-dot.surface { color: var(--r8-accent); }
.r008-dot.plane { color: #dd7f16; }
.r008-dot.intersection { color: var(--r8-rose); }
.r008-model-note { position: absolute; z-index: 8; right: 18px; bottom: calc(var(--r8-transport-height) + 20px); max-width: 310px; padding: 7px 10px; border-radius: 12px; color: #596a7d; background: rgba(255,255,255,.62); border: 1px solid rgba(255,255,255,.82); font-size: .61rem; line-height: 1.35; pointer-events: none; }

.r008-cut-inset {
  position: absolute;
  z-index: 8;
  left: 18px;
  bottom: calc(var(--r8-transport-height) + 60px);
  width: 190px;
  height: 150px;
  border-radius: 20px;
  background: rgba(255,255,255,.72);
  border: 1px solid rgba(255,255,255,.90);
  box-shadow: var(--r8-shadow-control);
  overflow: hidden;
  pointer-events: none;
}
.r008-cut-inset p { margin: 9px 11px 0; color: var(--r8-ink-secondary); font-size: .64rem; font-weight: 800; }
.r008-cut-inset canvas { width: 100%; height: calc(100% - 26px); display: block; }

/* Existing non-spatial overlays inherit the new system. */
.r007-module-shell { position: absolute !important; inset: 0 !important; min-height: 0 !important; height: 100% !important; padding: 70px 18px calc(var(--r8-transport-height) + 18px) !important; overflow: auto !important; background: transparent !important; }
.r007-module-card { width: min(1040px,100%) !important; min-height: 0 !important; margin: auto !important; }
.r007-module-heading { padding-right: 360px; }
.r007-svg-card { min-height: 340px !important; border-radius: 24px !important; background: rgba(255,255,255,.78) !important; border: 1px solid rgba(255,255,255,.92) !important; box-shadow: var(--r8-shadow-float) !important; }
.r007-svg-card svg { min-height: 340px !important; }
.r007-caption { border-radius: 16px !important; background: rgba(255,255,255,.72) !important; border: 1px solid rgba(255,255,255,.88) !important; box-shadow: var(--r8-shadow-control); }

@media (max-width: 1040px) {
  .r008-spatial-title { max-width: calc(100% - 350px); }
  .r008-model-note { display: none; }
  .r007-module-heading { padding-right: 330px; }
}
@media (max-width: 820px) {
  .r008-transport { grid-template-columns: auto minmax(0,1fr); }
  .r008-transport-tools { grid-column: 1 / -1; position: absolute; right: 8px; top: -52px; }
  .r008-spatial-title { top: 190px; max-width: calc(100% - 36px); }
  .r008-spatial-legend { bottom: calc(var(--r8-transport-height) + 18px); }
  .r008-cut-inset { bottom: calc(var(--r8-transport-height) + 58px); }
  .r007-module-heading { padding-right: 0; }
}
@media (max-width: 560px) {
  .r008-transport { grid-template-columns: auto minmax(0,1fr); gap: 6px; }
  .r008-transport-main button { min-width: 40px; padding: 4px 7px; }
  .r008-transport-main .play { min-width: 58px; }
  .r008-phase-rail { grid-template-columns: repeat(3, minmax(0,1fr)); margin-top: 4px; }
  .r008-phase-rail span { min-height: 20px; font-size: .56rem; }
  .r008-transport-copy strong { font-size: .70rem; }
  .r008-transport-tools { right: 6px; top: -48px; }
  .r008-transport-tools button { min-height: 40px !important; padding: 4px 7px; }
  .r008-spatial-title { top: 178px; left: 10px; max-width: calc(100% - 20px); padding: 9px 11px; border-radius: 16px; }
  .r008-spatial-title span { display: none; }
  .r008-spatial-legend { left: 10px; bottom: calc(var(--r8-transport-height) + 14px); }
  .r008-spatial-legend span { font-size: .58rem; min-height: 25px; }
  .r008-cut-inset { display: none; }
  .r007-module-shell { padding: 177px 8px calc(var(--r8-transport-height) + 14px) !important; }
  .r007-svg-card, .r007-svg-card svg { min-height: 280px !important; }
}

.r008-spatial-scene { position: absolute; inset: 0; overflow: hidden; }


