:root {
  color-scheme: light;
  --canvas: #eef5ff;
  --canvas-warm: #fff8f1;
  --glass: rgba(255,255,255,.66);
  --glass-strong: rgba(255,255,255,.86);
  --glass-soft: rgba(255,255,255,.46);
  --ink: #14233b;
  --ink-strong: #07162f;
  --muted: #5e718f;
  --muted-2: #8090aa;
  --line: rgba(53,78,117,.16);
  --line-strong: rgba(38,110,201,.34);
  --accent: #0a78ff;
  --accent-2: #635bff;
  --accent-soft: rgba(10,120,255,.12);
  --cyan: #00a8d8;
  --mint: #13a875;
  --amber: #c87800;
  --rose: #dc3f67;
  --danger: #c93455;
  --success: #087a55;
  --warning: #9e5b00;
  --focus: #005bd8;
  --touch: 48px;
  --radius-xs: 10px;
  --radius-sm: 14px;
  --radius-md: 18px;
  --radius-lg: 24px;
  --radius-xl: 31px;
  --shadow-glass: 0 22px 58px rgba(42,69,111,.16), 0 2px 8px rgba(42,69,111,.08), inset 0 1px 0 rgba(255,255,255,.88);
  --shadow-float: 0 14px 36px rgba(35,62,105,.18), inset 0 1px 0 rgba(255,255,255,.9);
  --shadow-press: 0 5px 14px rgba(35,62,105,.13), inset 0 1px 0 rgba(255,255,255,.8);
  --spring: cubic-bezier(.22,.8,.25,1);
}

* { box-sizing: border-box; }
html [hidden] { display: none !important; }
html, body { margin: 0; min-height: 100%; }
html { overflow: hidden; scroll-padding: 102px 0 76px; }
body {
  position: relative;
  min-width: 320px;
  color: var(--ink);
  background:
    radial-gradient(circle at 11% -5%, rgba(34,150,255,.20), transparent 31%),
    radial-gradient(circle at 95% 8%, rgba(119,83,255,.16), transparent 31%),
    radial-gradient(circle at 54% 103%, rgba(255,163,72,.14), transparent 37%),
    linear-gradient(155deg, #f4f8ff 0%, #eef6ff 44%, #fff7f0 100%);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", Pretendard, "Noto Sans KR", "Apple SD Gothic Neo", "Malgun Gothic", system-ui, sans-serif;
  line-height: 1.5;
  letter-spacing: -.014em;
  overscroll-behavior: none;
  -webkit-font-smoothing: antialiased;
}
button, select, input { font: inherit; }
button, select, input[type="range"] { -webkit-tap-highlight-color: transparent; }
button { min-height: var(--touch); }
button:focus-visible, select:focus-visible, input:focus-visible, [tabindex]:focus-visible, a:focus-visible {
  outline: 3px solid color-mix(in srgb, var(--focus) 86%, white);
  outline-offset: 3px;
}
button:disabled { cursor: not-allowed; opacity: .48; filter: saturate(.6); }
::selection { background: rgba(10,120,255,.22); }

.skip-link {
  position: fixed; z-index: 1000; left: 16px; top: -80px;
  padding: 12px 18px; border-radius: 999px; color: white; background: var(--ink-strong);
  font-weight: 800; transition: top .18s var(--spring);
}
.skip-link:focus { top: 14px; }

.ambient-field { position: fixed; inset: 0; overflow: hidden; pointer-events: none; z-index: -2; }
.ambient-aurora { position: absolute; border-radius: 50%; filter: blur(72px); opacity: .28; }
.aurora-a { width: 540px; height: 540px; left: -210px; top: 17%; background: #4cc7ff; animation: aurora-drift-a 14s ease-in-out infinite alternate; }
.aurora-b { width: 620px; height: 620px; right: -250px; bottom: -250px; background: #8a72ff; animation: aurora-drift-b 17s ease-in-out infinite alternate; }
.ambient-noise {
  position: absolute; inset: 0; opacity: .26;
  background-image:
    linear-gradient(rgba(74,113,165,.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(74,113,165,.035) 1px, transparent 1px);
  background-size: 56px 56px;
  mask-image: linear-gradient(180deg, transparent, black 13%, black 86%, transparent);
}
@keyframes aurora-drift-a { to { transform: translate(68px,-34px) scale(1.08); } }
@keyframes aurora-drift-b { to { transform: translate(-58px,-42px) scale(.94); } }

.glass-surface {
  background:
    linear-gradient(145deg, rgba(255,255,255,.80), rgba(255,255,255,.52)),
    var(--glass);
  border: 1px solid rgba(255,255,255,.78);
  box-shadow: var(--shadow-glass);
  backdrop-filter: blur(28px) saturate(145%);
  -webkit-backdrop-filter: blur(28px) saturate(145%);
}
.glass-surface::after {
  content: ""; position: absolute; inset: 0; pointer-events: none; border-radius: inherit;
  background: linear-gradient(126deg, rgba(255,255,255,.42), transparent 28%, transparent 72%, rgba(255,255,255,.18));
  opacity: .65;
}

.app-header {
  position: relative; z-index: 20;
  min-height: 76px;
  display: flex; align-items: center; justify-content: space-between; gap: 16px;
  margin: 10px 14px 0; padding: 10px 14px 10px 16px;
  border-radius: 26px;
}
.app-header > * { position: relative; z-index: 1; }
.brand-lockup { display: flex; align-items: center; gap: 12px; min-width: 0; }
.brand-mark {
  width: 48px; height: 48px; flex: 0 0 48px; display: grid; place-items: center;
  color: white; border-radius: 16px;
  background: linear-gradient(145deg, #2aa7ff, #5f5bff 72%);
  box-shadow: 0 10px 26px rgba(45,105,235,.28), inset 0 1px 0 rgba(255,255,255,.52);
}
.brand-mark svg { width: 31px; height: 31px; }
.title-block { min-width: 0; }
.title-block h1 { margin: 0; color: var(--ink-strong); font-size: clamp(1.35rem,2.2vw,2rem); line-height: 1.05; letter-spacing: -.05em; }
.eyebrow { margin: 0 0 4px; color: var(--accent); font-size: .72rem; font-weight: 850; letter-spacing: .075em; text-transform: uppercase; }
.header-actions { display: flex; align-items: center; justify-content: flex-end; gap: 7px; flex-wrap: wrap; }

.glass-button, .tool-button, .tab-button, .action-button, .choice-button, .chip-button, .quiet-button {
  position: relative;
  border: 1px solid rgba(47,82,132,.14);
  color: var(--ink);
  background: linear-gradient(145deg, rgba(255,255,255,.84), rgba(245,249,255,.58));
  box-shadow: 0 6px 16px rgba(45,72,113,.10), inset 0 1px 0 rgba(255,255,255,.92);
  border-radius: 16px;
  padding: 10px 14px;
  cursor: pointer;
  font-weight: 770;
  touch-action: manipulation;
  transition: transform .22s var(--spring), box-shadow .22s var(--spring), background .22s var(--spring), border-color .22s var(--spring), color .22s var(--spring);
}
.glass-button::before, .tool-button::before, .tab-button::before, .action-button::before, .choice-button::before, .chip-button::before {
  content: ""; position: absolute; inset: 1px; pointer-events: none; border-radius: inherit;
  background: linear-gradient(135deg, rgba(255,255,255,.38), transparent 38%); opacity: .65;
}
.glass-button > *, .tool-button > *, .tab-button > *, .action-button > *, .choice-button > *, .chip-button > * { position: relative; z-index: 1; }
.glass-button:hover, .tool-button:hover, .tab-button:hover, .action-button:hover, .choice-button:hover, .chip-button:hover, .quiet-button:hover {
  transform: translateY(-1px);
  border-color: rgba(10,120,255,.34);
  box-shadow: 0 10px 22px rgba(45,72,113,.14), inset 0 1px 0 rgba(255,255,255,.95);
}
.glass-button:active, .tool-button:active, .tab-button:active, .action-button:active, .choice-button:active, .chip-button:active, .quiet-button:active {
  transform: translateY(1px) scale(.985); box-shadow: var(--shadow-press);
}
.glass-button.compact { min-height: 44px; display: inline-flex; align-items: center; gap: 7px; border-radius: 999px; padding: 8px 12px; font-size: .82rem; }

.lab-tabs {
  position: relative; z-index: 18;
  display: flex; align-items: stretch; gap: 7px; overflow-x: auto;
  margin: 8px 14px 0; padding: 7px;
  min-height: 67px; border-radius: 23px;
  scrollbar-width: thin; scrollbar-color: rgba(10,120,255,.35) transparent;
}
.lab-tabs > * { position: relative; z-index: 1; }
.tab-button {
  flex: 1 0 174px; min-width: 174px; min-height: 52px;
  display: flex; align-items: center; gap: 10px; text-align: left;
  padding: 7px 11px; border-radius: 17px; box-shadow: none; background: transparent; border-color: transparent;
  color: var(--muted);
}
.tab-symbol {
  width: 34px; height: 34px; flex: 0 0 34px; display: grid; place-items: center;
  border-radius: 11px; color: var(--accent); background: rgba(10,120,255,.08);
  border: 1px solid rgba(10,120,255,.10); font-size: 1rem; font-weight: 900;
  transition: transform .28s var(--spring), background .22s var(--spring), color .22s var(--spring);
}
.tab-copy { display: grid; min-width: 0; line-height: 1.12; }
.tab-copy strong { color: currentColor; font-size: .9rem; white-space: nowrap; }
.tab-copy small { margin-top: 4px; color: var(--muted-2); font-size: .67rem; font-weight: 680; white-space: nowrap; }
.tab-button.is-active {
  color: var(--ink-strong); border-color: rgba(10,120,255,.18);
  background: linear-gradient(145deg, rgba(255,255,255,.92), rgba(231,241,255,.82));
  box-shadow: 0 8px 19px rgba(45,72,113,.13), inset 0 1px 0 white;
}
.tab-button.is-active .tab-symbol {
  color: white; background: linear-gradient(145deg,#0a8cff,#645cff); border-color: transparent;
  transform: translateY(-1px) scale(1.03); box-shadow: 0 7px 16px rgba(55,94,238,.25);
}
.tab-button.is-active .tab-copy small { color: #486b9e; }

.app-main {
  height: calc(100dvh - 76px - 67px - 60px);
  min-height: 590px;
  display: grid;
  grid-template-columns: minmax(260px,318px) minmax(480px,1fr) minmax(306px,390px);
  gap: 11px; padding: 10px 14px 9px;
}
.panel {
  position: relative; min-width: 0; overflow: auto;
  padding: 16px 16px 20px;
  border-radius: var(--radius-xl);
  scrollbar-width: thin; scrollbar-color: rgba(10,120,255,.28) transparent;
  scroll-padding: 18px;
}
.panel > * { position: relative; z-index: 1; }
.panel h2 { margin: 0 0 10px; color: var(--ink-strong); font-size: 1.15rem; letter-spacing: -.035em; }
.panel h3 { margin: 17px 0 8px; color: #2b4163; font-size: .94rem; letter-spacing: -.02em; }
.panel p { margin: 8px 0; }
.panel ul, .panel ol { padding-left: 1.22rem; }
.panel li + li { margin-top: 5px; }
.panel-section { padding: 15px 0; border-top: 1px solid var(--line); }
.panel-section:first-child { padding-top: 0; border-top: 0; }
.panel-section:last-child { padding-bottom: 0; }
.control-label { display: block; margin: 9px 0 6px; color: var(--muted); font-size: .82rem; font-weight: 790; }
select, input[type="number"] {
  width: 100%; min-height: 48px; padding: 10px 12px;
  color: var(--ink-strong); background: rgba(255,255,255,.75);
  border: 1px solid var(--line); border-radius: 14px;
  box-shadow: inset 0 1px 1px rgba(40,69,112,.05);
}
select option, select optgroup { color: #10223c; background: white; }
input[type="range"] { width: 100%; min-height: 44px; accent-color: var(--accent); cursor: pointer; }
input[type="checkbox"], input[type="radio"] { width: 20px; height: 20px; accent-color: var(--accent); vertical-align: -4px; }
.button-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 8px; }
.button-stack { display: grid; gap: 8px; }
.inline-actions { display: flex; gap: 8px; flex-wrap: wrap; }
.inline-actions > * { flex: 1 1 108px; }
.action-button, .choice-button, .chip-button { min-height: 48px; }
.action-button.primary, .choice-button.is-active, .chip-button.is-active, .tool-button.is-active {
  color: white; border-color: rgba(255,255,255,.34);
  background: linear-gradient(145deg,#0b8cff,#5e5bff 78%);
  box-shadow: 0 10px 23px rgba(48,88,228,.24), inset 0 1px 0 rgba(255,255,255,.42);
}
.action-button.success { color: #075b3e; border-color: rgba(19,168,117,.22); background: rgba(209,248,233,.84); }
.action-button.warning { color: #754300; border-color: rgba(200,120,0,.22); background: rgba(255,238,207,.86); }
.action-button.danger { color: #8c203b; border-color: rgba(220,63,103,.22); background: rgba(255,224,232,.86); }
.small-note { color: var(--muted); font-size: .79rem; }

.callout {
  margin: 9px 0; padding: 12px 13px; border-radius: 15px;
  color: #214269; background: linear-gradient(135deg,rgba(209,234,255,.74),rgba(238,234,255,.72));
  border: 1px solid rgba(10,120,255,.16); border-left: 4px solid var(--accent);
}
.callout strong { display: block; margin-bottom: 3px; color: var(--ink-strong); }
.callout.success { color: #15573f; background: rgba(218,249,236,.78); border-color: rgba(19,168,117,.22); border-left-color: var(--mint); }
.callout.warning { color: #6f4709; background: rgba(255,241,212,.82); border-color: rgba(200,120,0,.22); border-left-color: var(--amber); }
.callout.danger { color: #7d2940; background: rgba(255,228,235,.82); border-color: rgba(220,63,103,.22); border-left-color: var(--rose); }

.viewer-stage {
  position: relative; min-width: 0; overflow: hidden; isolation: isolate;
  border-radius: 34px; border: 1px solid rgba(255,255,255,.75);
  background: #dfeeff; box-shadow: 0 28px 74px rgba(39,69,116,.22), inset 0 1px 0 rgba(255,255,255,.9);
  touch-action: none;
}
.stage-background {
  position: absolute; inset: 0; pointer-events: none;
  background:
    radial-gradient(circle at 50% 36%, rgba(255,255,255,.95), rgba(230,243,255,.75) 33%, transparent 61%),
    radial-gradient(ellipse at 50% 84%, rgba(16,118,255,.12), transparent 48%),
    linear-gradient(180deg,#eaf5ff 0%,#dfeeff 52%,#d4e5f5 100%);
}
.stage-background::before {
  content: ""; position: absolute; inset: 0;
  background-image: linear-gradient(rgba(56,104,162,.07) 1px,transparent 1px),linear-gradient(90deg,rgba(56,104,162,.07) 1px,transparent 1px);
  background-size: 46px 46px; transform: perspective(760px) rotateX(63deg) scale(1.42) translateY(16%); transform-origin: 50% 70%;
  mask-image: linear-gradient(180deg,transparent 22%,black 52%,transparent 96%); opacity: .56;
}
.stage-background::after {
  content: ""; position: absolute; left: 18%; right: 18%; bottom: 7%; height: 11%; border-radius: 50%;
  background: radial-gradient(ellipse,rgba(53,88,130,.20),transparent 70%); filter: blur(14px);
}
#glCanvas, #labelCanvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
#glCanvas { filter: drop-shadow(0 24px 29px rgba(29,57,99,.20)); }
#labelCanvas { pointer-events: none; }
.module-overlay {
  position: absolute; inset: 0; z-index: 5; overflow: auto; padding: 72px 18px 84px;
  background: linear-gradient(180deg,rgba(244,249,255,.78),rgba(229,240,252,.82));
  backdrop-filter: blur(10px) saturate(125%); -webkit-backdrop-filter: blur(10px) saturate(125%);
  touch-action: pan-y;
}
.module-overlay[hidden] { display: none !important; }
.stage-topline { position: absolute; z-index: 8; left: 15px; right: 15px; top: 15px; display: flex; justify-content: space-between; gap: 9px; pointer-events: none; }
.glass-chip {
  display: inline-flex; align-items: center; gap: 8px; min-height: 38px; padding: 7px 12px; border-radius: 999px;
  color: #224061; background: rgba(255,255,255,.73); border: 1px solid rgba(255,255,255,.82);
  box-shadow: 0 8px 20px rgba(44,75,120,.12),inset 0 1px 0 white;
  backdrop-filter: blur(20px) saturate(145%); -webkit-backdrop-filter: blur(20px) saturate(145%);
  font-size: .75rem; font-weight: 790;
}
.status-pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--mint); box-shadow: 0 0 0 5px rgba(19,168,117,.13),0 0 15px rgba(19,168,117,.34); animation: status-breathe 2.4s ease-in-out infinite; }
@keyframes status-breathe { 50% { transform: scale(.78); opacity: .72; } }
.fold-stage-badge { display: grid; grid-template-columns: auto auto; column-gap: 7px; align-items: center; }
.fold-stage-step { color: var(--accent); font-size: .67rem; font-weight: 900; }
.fold-stage-title { color: var(--ink-strong); font-size: .78rem; }
.viewer-toolbar {
  position: absolute; z-index: 9; left: 14px; top: 60px;
  display: flex; gap: 5px; padding: 5px; border-radius: 20px;
}
.viewer-toolbar > * { position: relative; z-index: 1; }
.tool-button { min-height: 46px; display: inline-flex; align-items: center; gap: 6px; padding: 7px 10px; border-radius: 15px; font-size: .76rem; box-shadow: none; }
.viewer-hint { position: absolute; z-index: 8; left: 50%; bottom: 15px; transform: translateX(-50%); width: max-content; max-width: calc(100% - 30px); pointer-events: none; text-align: center; }
.viewer-fallback { position: absolute; inset: 0; z-index: 11; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; text-align: center; padding: 30px; background: rgba(239,247,255,.92); }
.viewer-fallback[hidden] { display: none !important; }

.metric-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 7px; }
.metric-card { min-width: 0; padding: 10px 6px; border-radius: 15px; text-align: center; background: rgba(255,255,255,.66); border: 1px solid var(--line); box-shadow: inset 0 1px 0 white; }
.metric-card .symbol { color: var(--muted); font-size: .67rem; font-weight: 760; }
.metric-card .value { display: block; color: var(--ink-strong); font-size: 1.36rem; font-weight: 920; font-variant-numeric: tabular-nums; }
.euler-meter { display: grid; grid-template-columns: repeat(7,auto); align-items: center; justify-content: center; gap: 7px; padding: 13px 7px; border-radius: 15px; background: rgba(255,255,255,.69); border: 1px solid var(--line); color: var(--ink-strong); font-size: 1.02rem; font-weight: 880; }
.euler-meter .result { min-width: 42px; padding: 4px 9px; border-radius: 9px; background: #caf3df; color: #07583e; }
.definition-list { display: grid; grid-template-columns: auto 1fr; gap: 7px 10px; margin: 0; }
.definition-list dt { color: var(--muted); font-weight: 790; }
.definition-list dd { margin: 0; color: var(--ink-strong); font-weight: 720; overflow-wrap: anywhere; }

.net-svg-wrap, .angle-svg-wrap, .vertex-patch-wrap {
  position: relative; min-height: 300px; overflow: hidden; border-radius: 20px;
  border: 1px solid rgba(33,91,155,.17);
  background: radial-gradient(circle at 48% 32%,#fff 0%,#eef7ff 56%,#dbeaf8 100%);
  box-shadow: inset 0 1px 0 white,0 15px 34px rgba(42,73,116,.13);
}
.net-svg, .angle-svg { display: block; width: 100%; height: 100%; min-height: 300px; touch-action: none; }
.net-face { fill: #e2f0fb; stroke: #5b7892; stroke-width: .035; filter: drop-shadow(.02px .03px .03px rgba(20,38,55,.20)); }
.net-face:nth-of-type(3n+1) { fill: #cfeeff; }
.net-face:nth-of-type(3n+2) { fill: #d9f6eb; }
.net-face-label { font-size: .15px; font-weight: 900; fill: #122a45; pointer-events: none; text-anchor: middle; dominant-baseline: middle; direction: ltr; unicode-bidi: bidi-override; paint-order: stroke; stroke: rgba(255,255,255,.9); stroke-width: .03; }
.net-hinge { stroke: #50738e; stroke-width: .045; stroke-dasharray: .1 .07; pointer-events: none; }
.net-boundary { stroke: #17293c; stroke-width: .055; stroke-linecap: round; cursor: pointer; }
.net-boundary-hit { stroke: transparent; stroke-width: .24; cursor: pointer; }
.net-boundary.is-seed { stroke: #007db8; stroke-width: .11; }
.net-boundary.is-wrong { stroke: #c72e55; stroke-width: .12; }
.net-boundary.is-matched { stroke: #13875c; stroke-width: .11; }
.net-edge-label { font-size: .135px; font-weight: 920; fill: #0b6a48; paint-order: stroke; stroke: white; stroke-width: .04; direction: ltr; unicode-bidi: bidi-override; }
.net-corner { fill: white; stroke: #334155; stroke-width: .035; cursor: pointer; }
.net-corner.is-seed { fill: #ffd35d; stroke: #74410c; stroke-width: .07; }
.net-corner.is-correct { fill: #31c98a; stroke: #0e5b3b; stroke-width: .06; }
.net-corner.is-wrong { fill: #f46a87; stroke: #7f1831; stroke-width: .06; }

.variant-strip { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 8px; padding: 3px 1px 8px; }
.variant-strip .chip-button { min-width: 0; min-height: 48px; padding-inline: 8px; white-space: nowrap; }
.progress-row { display: grid; grid-template-columns: auto 1fr auto; gap: 9px; align-items: center; }
.progress-value { min-width: 56px; text-align: right; color: var(--accent); font-weight: 900; font-variant-numeric: tabular-nums; }
.fold-timeline { display: grid; grid-template-columns: repeat(5,minmax(0,1fr)); gap: 5px; margin: 5px 0 10px; }
.fold-timeline span { min-height: 31px; display: grid; place-items: center; padding: 4px 3px; border-radius: 10px; color: #7588a4; background: rgba(255,255,255,.58); border: 1px solid var(--line); font-size: .62rem; font-weight: 780; text-align: center; }
.fold-timeline span.is-active { color: white; background: linear-gradient(145deg,#0a8cff,#5e5bff); border-color: transparent; box-shadow: 0 6px 15px rgba(45,92,225,.22); }
.fold-readout { display: grid; grid-template-columns: 1fr auto; gap: 8px; align-items: center; margin-top: 8px; padding: 10px 11px; border-radius: 14px; background: rgba(255,255,255,.67); border: 1px solid var(--line); }
.fold-readout strong { color: var(--ink-strong); }
.fold-readout small { color: var(--muted); }
.check-list { display: grid; gap: 8px; }
.check-item { display: flex; gap: 9px; align-items: flex-start; padding: 9px; border-radius: 12px; background: rgba(255,255,255,.57); border: 1px solid rgba(53,78,117,.09); }
.check-item .mark { font-weight: 950; }
.check-item.pass .mark { color: var(--success); }
.check-item.hold .mark { color: var(--warning); }

.table-wrap { overflow: auto; border: 1px solid var(--line); border-radius: 15px; background: rgba(255,255,255,.55); }
table { width: 100%; min-width: 520px; border-collapse: collapse; }
th, td { padding: 10px 11px; text-align: center; border-bottom: 1px solid var(--line); }
th { position: sticky; top: 0; z-index: 1; color: #2b4163; background: rgba(237,246,255,.95); }
td:first-child, th:first-child { text-align: left; }
tr:last-child td { border-bottom: 0; }
.angle-summary { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.angle-number { padding: 12px; border-radius: 14px; text-align: center; background: rgba(255,255,255,.63); border: 1px solid var(--line); }
.angle-number strong { display: block; color: var(--ink-strong); font-size: 1.34rem; }
.formula-box { padding: 14px; border-radius: 15px; color: #173457; background: rgba(237,246,255,.78); border: 1px solid rgba(10,120,255,.14); font-family: ui-monospace,"SFMono-Regular",Consolas,monospace; overflow-x: auto; font-variant-numeric: tabular-nums; }
.vertex-patch-wrap { min-height: 260px; background: radial-gradient(circle at 50% 32%,#dff3ff,#aacbe6 64%,#7095b7 100%); }
.vertex-patch-canvas { display: block; width: 100%; height: 260px; }
.demo-caption { display: grid; grid-template-columns: auto 1fr; gap: 10px; align-items: start; padding-top: 10px; }
.demo-caption .demo-icon { width: 35px; height: 35px; display: grid; place-items: center; border-radius: 12px; color: #006c9b; background: #d5f1ff; border: 1px solid rgba(0,126,184,.18); font-weight: 920; }
.demo-caption.danger .demo-icon { color: #9c2845; background: #ffe1e9; border-color: rgba(220,63,103,.24); }
.demo-caption.warning .demo-icon { color: #7a4a00; background: #ffedc7; border-color: rgba(200,120,0,.22); }
.demo-caption strong { display: block; color: var(--ink-strong); }
.demo-caption p { margin: 3px 0 0; color: var(--muted); font-size: .82rem; }

/* direct proof workspace */
.proof-workspace { display: grid; grid-template-rows: auto minmax(330px,1fr) auto; gap: 10px; max-width: 1040px; margin: 0 auto; min-height: 100%; }
.proof-stage-rail { display: grid; grid-template-columns: repeat(6,minmax(0,1fr)); gap: 5px; }
.proof-stage-rail span { position: relative; min-height: 42px; display: grid; place-items: center; padding: 5px 4px; border-radius: 12px; color: #71849f; background: rgba(255,255,255,.60); border: 1px solid var(--line); text-align: center; font-size: .66rem; font-weight: 780; }
.proof-stage-rail span.is-active { color: white; background: linear-gradient(145deg,#0b8cff,#615cff); border-color: transparent; box-shadow: 0 8px 17px rgba(48,88,228,.22); }
.proof-stage-rail span.is-complete::after { content: "✓"; position: absolute; right: 5px; top: 3px; color: var(--success); font-size: .63rem; }
.proof-board { position: relative; min-height: 350px; border-radius: 24px; overflow: hidden; background: rgba(255,255,255,.78); border: 1px solid rgba(255,255,255,.92); box-shadow: 0 16px 36px rgba(42,73,116,.13),inset 0 1px 0 white; }
.proof-board::before { content: ""; position: absolute; inset: 0; pointer-events: none; background-image: radial-gradient(circle,rgba(42,86,143,.12) 1px,transparent 1.5px); background-size: 22px 22px; mask-image: linear-gradient(180deg,black,transparent 96%); }
.proof-svg { position: relative; z-index: 1; display: block; width: 100%; height: 100%; min-height: 350px; }
.proof-region { fill: rgba(10,120,255,.06); stroke: rgba(10,120,255,.18); stroke-width: 2; }
.proof-region.outside { fill: rgba(255,178,52,.08); stroke: rgba(176,103,0,.34); stroke-dasharray: 8 6; }
.proof-edge { stroke: #24476c; stroke-width: 5; stroke-linecap: round; transition: opacity .35s var(--spring),stroke .35s var(--spring),stroke-width .35s var(--spring); }
.proof-edge.is-removable { stroke: var(--accent); stroke-width: 8; filter: drop-shadow(0 0 5px rgba(10,120,255,.28)); cursor: pointer; }
.proof-edge.is-active { stroke: #f08a00; stroke-width: 10; stroke-dasharray: 15 8; animation: proof-edge-flow .85s linear infinite; }
.proof-edge.is-removed { opacity: .08; }
.proof-edge.is-illegal { stroke: var(--danger); stroke-width: 8; }
@keyframes proof-edge-flow { to { stroke-dashoffset: -23; } }
.proof-node { fill: white; stroke: #24476c; stroke-width: 4; transition: opacity .35s var(--spring),transform .35s var(--spring),fill .35s var(--spring); transform-box: fill-box; transform-origin: center; }
.proof-node.is-leaf { fill: #dff8ec; stroke: var(--success); stroke-width: 6; cursor: pointer; }
.proof-node.is-active { fill: #ffe7a9; stroke: #dd7900; stroke-width: 7; transform: scale(1.16); }
.proof-node.is-removed { opacity: .08; transform: scale(.55); }
.proof-node.is-illegal { fill: #ffe3eb; stroke: var(--danger); }
.proof-label { fill: var(--ink-strong); font-size: 19px; font-weight: 900; text-anchor: middle; dominant-baseline: middle; pointer-events: none; paint-order: stroke; stroke: rgba(255,255,255,.95); stroke-width: 5; }
.proof-face-label { fill: #35587f; font-size: 14px; font-weight: 760; text-anchor: middle; paint-order: stroke; stroke: white; stroke-width: 4; }
.proof-outside-label { fill: #875300; font-size: 15px; font-weight: 900; }
.proof-counter-bar { position: absolute; z-index: 3; left: 14px; right: 14px; bottom: 12px; display: grid; grid-template-columns: repeat(4,auto) 1fr; gap: 8px; align-items: center; pointer-events: none; }
.proof-counter { min-width: 74px; padding: 7px 10px; border-radius: 13px; color: #27486d; background: rgba(255,255,255,.86); border: 1px solid rgba(255,255,255,.94); box-shadow: 0 6px 15px rgba(44,75,120,.10); font-size: .75rem; font-weight: 800; text-align: center; }
.proof-counter strong { display: block; color: var(--ink-strong); font-size: 1.16rem; font-variant-numeric: tabular-nums; }
.proof-invariant { justify-self: end; color: white; background: linear-gradient(145deg,#0d9169,#12b27f); }
.proof-invariant strong { color: white; }
.proof-decision-card { padding: 12px 14px; border-radius: 16px; background: rgba(255,255,255,.78); border: 1px solid rgba(255,255,255,.94); box-shadow: 0 8px 20px rgba(42,73,116,.10); }
.proof-decision-card strong { color: var(--ink-strong); }
.proof-decision-card p { margin: 4px 0 0; color: var(--muted); font-size: .82rem; }
.proof-controls-grid { display: grid; grid-template-columns: 1fr auto; gap: 9px; align-items: center; }
.proof-step-buttons { display: flex; gap: 6px; }
.proof-step-buttons button { min-width: 48px; padding-inline: 10px; }
.delta-cards { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 7px; }
.delta-card { min-height: 54px; border-radius: 14px; font-family: ui-monospace,"SFMono-Regular",Consolas,monospace; font-weight: 850; }
.delta-card.is-correct { border-color: rgba(19,168,117,.36); background: #dff8ec; color: #07583e; }
.proof-choice-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 7px; max-height: 245px; overflow: auto; padding: 2px; }
.proof-choice-grid button { min-height: 48px; }
.proof-choice-grid button.is-legal { border-color: rgba(10,120,255,.32); }
.proof-choice-grid button.is-chosen { color: white; background: linear-gradient(145deg,#0b8cff,#615cff); }
.proof-feedback { min-height: 62px; padding: 10px 12px; border-radius: 14px; background: rgba(255,255,255,.64); border: 1px solid var(--line); color: #314f73; }
.proof-feedback strong { color: var(--ink-strong); }

/* net positional-relation lab */
.relation-map { display: grid; gap: 8px; }
.relation-prompt { padding: 12px; border-radius: 15px; background: rgba(255,255,255,.66); border: 1px solid var(--line); }
.relation-prompt strong { color: var(--ink-strong); }
.relation-options { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 7px; }
.relation-result { min-height: 52px; padding: 10px 12px; border-radius: 14px; background: rgba(255,255,255,.60); border: 1px solid var(--line); }
.hinge-explainer { display: grid; grid-template-columns: 46px 1fr; gap: 10px; align-items: center; padding: 10px 11px; border-radius: 15px; background: rgba(255,255,255,.64); border: 1px solid var(--line); }
.hinge-icon { width: 46px; height: 46px; display: grid; place-items: center; border-radius: 15px; color: white; background: linear-gradient(145deg,#0b8cff,#615cff); font-size: 1.25rem; box-shadow: 0 8px 18px rgba(48,88,228,.22); }
.hinge-explainer strong { display: block; color: var(--ink-strong); }
.hinge-explainer small { color: var(--muted); }

/* why-five collision view */
.collision-legend { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 6px; }
.collision-legend span { display: grid; place-items: center; min-height: 38px; padding: 5px; border-radius: 11px; background: rgba(255,255,255,.62); border: 1px solid var(--line); color: #3a587a; font-size: .68rem; font-weight: 780; text-align: center; }
.collision-legend span::before { content: attr(data-symbol); display: block; color: var(--accent); font-size: .95rem; }

/* dialog */
.start-dialog { width: min(610px,calc(100% - 24px)); padding: 0; border: 0; background: transparent; color: var(--ink); }
.start-dialog::backdrop { background: rgba(25,47,82,.28); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
.start-card { position: relative; margin: 0; padding: 26px; border-radius: 30px; overflow: hidden; }
.start-card > * { position: relative; z-index: 1; }
.dialog-close { position: absolute; z-index: 2; right: 13px; top: 13px; width: 44px; min-height: 44px; border: 0; border-radius: 50%; color: #526987; background: rgba(255,255,255,.62); font-size: 1.45rem; cursor: pointer; }
.dialog-hero { display: flex; gap: 8px; margin-bottom: 17px; }
.dialog-hero span { width: 46px; height: 46px; display: grid; place-items: center; border-radius: 15px; color: white; background: linear-gradient(145deg,#18a3ff,#635bff); box-shadow: 0 8px 20px rgba(48,88,228,.20); font-weight: 900; }
.start-card h2 { margin: 0 0 16px; color: var(--ink-strong); font-size: clamp(1.45rem,4vw,2.2rem); line-height: 1.12; letter-spacing: -.045em; }
.start-steps { display: grid; gap: 10px; margin: 0 0 18px; padding: 0; list-style: none; counter-reset: step; }
.start-steps li { counter-increment: step; display: grid; grid-template-columns: 38px 1fr; gap: 10px; padding: 11px; border-radius: 16px; background: rgba(255,255,255,.57); border: 1px solid var(--line); }
.start-steps li::before { content: counter(step); width: 34px; height: 34px; display: grid; place-items: center; border-radius: 12px; color: white; background: linear-gradient(145deg,#0b8cff,#615cff); font-weight: 900; }
.start-steps strong { display: block; color: var(--ink-strong); }
.start-steps span { color: var(--muted); font-size: .84rem; }
.dialog-actions { display: flex; }
.dialog-actions button { flex: 1; min-height: 54px; }

.app-footer {
  position: relative; z-index: 18; min-height: 43px;
  display: flex; align-items: center; justify-content: space-between; gap: 16px;
  margin: 0 14px 9px; padding: 7px 14px; border-radius: 17px;
  color: var(--muted); font-size: .74rem;
}
.app-footer > * { position: relative; z-index: 1; }
#statusLive { color: #355476; font-weight: 760; }
.footer-scope { font-size: .69rem; letter-spacing: .02em; }

body.reduced-motion *, body.reduced-motion *::before, body.reduced-motion *::after {
  scroll-behavior: auto !important;
  animation-duration: .001ms !important;
  animation-iteration-count: 1 !important;
  transition-duration: .001ms !important;
}
body.reduced-motion .proof-edge.is-active { stroke-dasharray: none; }

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important; }
  .proof-edge.is-active { stroke-dasharray: none; }
}
@media (forced-colors: active) {
  .glass-surface, .panel, .viewer-stage, .proof-board, .callout { forced-color-adjust: none; border: 2px solid CanvasText; background: Canvas; color: CanvasText; box-shadow: none; }
  .tab-button.is-active, .action-button.primary, .tool-button.is-active { background: Highlight; color: HighlightText; }
  .proof-edge, .proof-node { stroke: CanvasText; }
}
@supports not (backdrop-filter: blur(2px)) {
  .glass-surface, .glass-chip, .module-overlay { background-color: rgba(247,251,255,.96); }
}

@media (max-width: 1270px) {
  .app-main { grid-template-columns: minmax(250px,300px) minmax(450px,1fr); }
  .activity-panel { grid-column: 1 / -1; max-height: 35vh; }
}
@media (max-width: 900px) {
  html { overflow: auto; }
  body { overscroll-behavior-y: auto; }
  .app-header { margin: 8px 9px 0; padding: 9px 10px; }
  .brand-mark { width: 44px; height: 44px; flex-basis: 44px; }
  .header-actions { gap: 5px; }
  .glass-button.compact { width: 44px; justify-content: center; padding: 7px; }
  .glass-button.compact span:last-child { display: none; }
  .lab-tabs { margin: 7px 9px 0; }
  .tab-button { min-width: 150px; flex-basis: 150px; }
  .tab-copy small { display: none; }
  .app-main { height: auto; min-height: 0; grid-template-columns: 1fr; padding: 8px 9px; }
  .controls-panel { order: 2; }
  .viewer-stage { order: 1; min-height: 64vh; }
  .activity-panel { order: 3; max-height: none; }
  .app-footer { margin: 0 9px 8px; flex-direction: column; align-items: flex-start; }
  .metric-grid { grid-template-columns: repeat(2,1fr); }
  .stage-topline { left: 10px; right: 10px; top: 10px; }
  .viewer-toolbar { left: 10px; top: 55px; }
  .module-overlay { padding: 69px 10px 84px; }
  .proof-stage-rail { overflow-x: auto; grid-template-columns: repeat(6,minmax(100px,1fr)); }
  .proof-counter-bar { grid-template-columns: repeat(4,1fr); }
  .proof-invariant { grid-column: 1 / -1; justify-self: stretch; }
}
@media (max-width: 560px) {
  .title-block .eyebrow { display: none; }
  .title-block h1 { font-size: 1.23rem; }
  .brand-mark { width: 40px; height: 40px; flex-basis: 40px; border-radius: 14px; }
  .app-header { border-radius: 21px; }
  .lab-tabs { border-radius: 19px; }
  .app-main { padding-top: 7px; }
  .panel { border-radius: 25px; padding: 14px; }
  .viewer-stage { min-height: 68vh; border-radius: 26px; }
  .tab-button { min-width: 132px; flex-basis: 132px; gap: 7px; }
  .tab-symbol { width: 31px; height: 31px; flex-basis: 31px; }
  .button-grid, .relation-options { grid-template-columns: 1fr; }
  .angle-summary { grid-template-columns: 1fr; }
  .proof-controls-grid { grid-template-columns: 1fr; }
  .proof-step-buttons { justify-content: stretch; }
  .proof-step-buttons button { flex: 1; }
  .proof-choice-grid { grid-template-columns: 1fr; }
  .delta-cards { grid-template-columns: 1fr; }
}
@media (min-width: 1600px) {
  .app-main { grid-template-columns: minmax(290px,340px) minmax(650px,1fr) minmax(350px,430px); }
  .panel { padding: 19px; }
}
  

