  const systemMotionQuery = typeof matchMedia === 'function' ? matchMedia('(prefers-reduced-motion: reduce)') : null;
  state.systemReducedMotion = !!systemMotionQuery?.matches;
  state.motionOverride = null;
  function applyMotionPreference(value, { rerender = false } = {}) {
    state.reducedMotion = !!value;
    document.body.classList.toggle('reduced-motion', state.reducedMotion);
    refs.motion.classList.toggle('is-active', state.reducedMotion);
    refs.motion.setAttribute('aria-pressed', String(state.reducedMotion));
    refs.motion.innerHTML = state.reducedMotion
      ? '<span aria-hidden="true">●</span><span>동작 줄임 켜짐</span>'
      : '<span aria-hidden="true">◌</span><span>동작 줄이기</span>';
    if (rerender) renderCurrentTab();
  }
  applyMotionPreference(state.systemReducedMotion);
  systemMotionQuery?.addEventListener?.('change', event => {
    state.systemReducedMotion = event.matches;
    if (state.motionOverride == null) applyMotionPreference(event.matches, { rerender: true });
  });

  $$('.tab-button').forEach(button => button.addEventListener('click', () => {
    stopFoldPlayback(); stopGeneratorPlayback(); stopSectionPlayback(); stopEulerPlayback(); stopSoccerPlayback(); stopR007Playback();
    state.tab = button.dataset.tab;
    activateTabButton(state.tab);
    renderCurrentTab();
    announce(`${button.querySelector('strong')?.textContent || button.textContent.trim()}로 이동했습니다.`);
  }));
  refs.navigate.addEventListener('click', () => setInteractionUI('navigate'));
  refs.select.addEventListener('click', () => setInteractionUI('select'));
  refs.controlsToggle?.addEventListener('click',()=>setControlsCollapsed(!state.controlsCollapsed));
  refs.zoomIn?.addEventListener('click', () => { renderer.distance = clamp(renderer.distance - .45, 2.5, 14); renderer.requestRender(); announce('화면을 확대했습니다.'); });
  refs.zoomOut?.addEventListener('click', () => { renderer.distance = clamp(renderer.distance + .45, 2.5, 14); renderer.requestRender(); announce('화면을 축소했습니다.'); });
  refs.right?.addEventListener('focusin', event => {
    const target = event.target.closest?.('button, input, select, [tabindex]');
    const notebook = $('#universalMappingNotebook', refs.right);
    if (!target || !notebook) return;
    const keepFocusVisible = (remaining = 2) => {
      const targetRect = target.getBoundingClientRect();
      const notebookRect = notebook.getBoundingClientRect();
      const panelRect = refs.right.getBoundingClientRect();
      const topLimit = notebookRect.bottom + 10;
      const bottomLimit = panelRect.bottom - 10;
      let delta = 0;
      if (targetRect.top < topLimit) delta = targetRect.top - topLimit;
      else if (targetRect.bottom > bottomLimit) delta = targetRect.bottom - bottomLimit;
      if (Math.abs(delta) > 1) {
        refs.right.scrollBy({ top: delta, behavior: 'instant' });
        if (remaining > 0) requestAnimationFrame(() => keepFocusVisible(remaining - 1));
      }
    };
    requestAnimationFrame(() => keepFocusVisible());
  });
  refs.reset.addEventListener('click', () => {
    if (!moduleSupports3D()) { r007ResetCurrent(); return; }
    renderer.resetView(state.tab === 'net' ? 'net' : state.tab === 'soccer' ? 'soccer' : 'solid'); announce('입체도형을 보는 방향을 처음으로 돌렸습니다.');
  });
  refs.motion.addEventListener('click', () => {
    state.motionOverride = !state.reducedMotion;
    stopFoldPlayback(); stopGeneratorPlayback(); stopEulerPlayback(); stopSoccerPlayback();
    applyMotionPreference(state.motionOverride, { rerender: true });
    announce(state.reducedMotion ? '동작 줄이기를 켰습니다. 처음·움직이는 중·결과의 핵심 상태는 유지됩니다.' : '연속 모션을 켰습니다.');
  });
  refs.fullscreen.addEventListener('click', async () => {
    try {
      if (!document.fullscreenElement) await document.documentElement.requestFullscreen();
      else await document.exitFullscreen();
    } catch (_) { announce('이 브라우저에서는 전체 화면 전환을 사용할 수 없습니다.'); }
  });
  refs.help.addEventListener('click', () => {
    if (typeof refs.startDialog.showModal === 'function' && !refs.startDialog.open) refs.startDialog.showModal();
    else refs.startDialog.setAttribute('open','');
  });
  refs.startDialog.addEventListener('close', () => {
    refs.main.focus({ preventScroll: true });
    announce('탐구 시작 안내를 닫았습니다. 입체 읽기부터 겉넓이·부피·최단거리까지 기본 8장과 심화 3장을 차례로 탐구해 보세요.');
  });
  refs.startExplore?.addEventListener('click', () => announce('탐구를 시작합니다. 먼저 입체를 돌리고 하나를 예측해 보세요.'));

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) { stopFoldPlayback(); stopGeneratorPlayback(); stopSectionPlayback(); stopEulerPlayback(); stopSoccerPlayback(); stopR007Playback(); }
  });
  window.addEventListener('blur', () => { if (state.foldPlaying || state.generatorPlaying || state.sectionPlaying || state.eulerPlaying || state.r007Playing) announce('창이 비활성화되어 재생을 일시정지했습니다.'); });
  window.addEventListener('resize', () => {
    if (state.tab === 'generator') requestAnimationFrame(drawGeneratorPatch);
    if (state.tab === 'euler') requestAnimationFrame(renderEulerCenter);
    if (state.tab === 'section' && state.sectionD != null) requestAnimationFrame(() => applySectionD(state.sectionD));
    if (state.tab === 'revolution') requestAnimationFrame(() => drawRevolutionVisual(state.revolutionProgress));
    if (state.tab === 'revsection') requestAnimationFrame(() => drawRevSectionVisual(state.revSectionProgress));
    if (state.tab === 'locus') requestAnimationFrame(() => drawLocusVisual(state.locusProgress));
    if (state.tab === 'geodesic') requestAnimationFrame(() => drawPathVisual(state.pathProgress));
  }, { passive: true });

  // SVG Net Diagram Keyboard Navigation
  document.addEventListener('keydown', (event) => {
    const activeElement = document.activeElement;
    if (activeElement && activeElement.closest('svg')) {
      if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
        event.preventDefault();
        const nextBtn = document.querySelector('#foldNextStepButton, #foldAutoButton');
        if (nextBtn) nextBtn.click();
      } else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
        event.preventDefault();
        const prevBtn = document.querySelector('#foldPrevStepButton');
        if (prevBtn) prevBtn.click();
      }
    }
  });



