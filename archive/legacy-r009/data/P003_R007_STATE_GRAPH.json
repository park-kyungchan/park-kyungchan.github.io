  "runtime_recovery": {
    "pointercancel": "release capture, clear resizing/gesture state, preserve last committed math state",
    "lostpointercapture": "same as pointercancel",
    "rapid_input": "stop stale autoplay before applying new chapter/case state",
    "module_switch_mid_animation": "cancel animation frame and render selected chapter ENTRY/current committed state",
    "reset_during_animation": "cancel autoplay then restore exact initial values and answer guards",
    "visibility_hidden": "pause autoplay; no hidden-step accumulation",
    "webgl_context_loss": "prevent blank failure and recover/restored renderer or Canvas2D fallback",
    "reduced_motion": "use discrete 0/.24/.52/.78/1 sequence preserving ENTRY/MID/EXIT"
  }
