  "global_invariants": [
    "one primary mathematical change per critical transition",
    "prediction answer remains hidden until explicit reveal/verify action",
    "auto demo and direct exploration read the same exact data",
    "reset restores both UI and mathematics state",
    "machine IDs remain internal only",
    "camera does not compete with analytic object/plane/path transitions"
  ],
  "global_nodes": [
    {
      "state_id": "G-ENTRY",
      "role": "ENTRY",
      "meaning": "chapter initial state with answer guard"
    },
    {
      "state_id": "G-PREDICT",
      "role": "PREDICT",
      "meaning": "learner records a mathematical prediction"
    },
    {
      "state_id": "G-MANIPULATE",
      "role": "MANIPULATE",
      "meaning": "learner or autoplay changes one controlled parameter"
    },
    {
      "state_id": "G-MID",
      "role": "MID",
      "meaning": "decisive causal intermediate state"
    },
    {
      "state_id": "G-VERIFY",
      "role": "VERIFY",
      "meaning": "exact evidence and invariant become available"
    },
    {
      "state_id": "G-EXPLAIN",
      "role": "EXPLAIN",
      "meaning": "learner compares prediction with evidence"
    },
    {
      "state_id": "G-TRANSFER",
      "role": "TRANSFER",
      "meaning": "new case or path candidate"
    },
    {
      "state_id": "G-ERROR",
      "role": "ERROR",
      "meaning": "structural reason without answer-only feedback"
    },
    {
      "state_id": "G-RESET",
      "role": "RESET",
      "meaning": "deterministic chapter initial state"
    }
  ],
  "global_transitions": [
    {
      "from": "G-ENTRY",
      "action": "record_prediction",
      "to": "G-PREDICT"
    },
    {
      "from": "G-PREDICT",
      "action": "start_auto_or_direct",
      "to": "G-MANIPULATE"
    },
    {
      "from": "G-MANIPULATE",
      "action": "reach_decisive_mid",
      "to": "G-MID"
    },
    {
      "from": "G-MID",
      "action": "complete_transform",
      "to": "G-VERIFY"
    },
    {
      "from": "G-VERIFY",
      "action": "compare_and_explain",
      "to": "G-EXPLAIN"
    },
    {
      "from": "G-EXPLAIN",
      "action": "choose_new_case",
      "to": "G-TRANSFER"
    },
    {
      "from": "*",
      "action": "invalid_or_incomplete_choice",
      "to": "G-ERROR"
    },
    {
      "from": "G-ERROR",
      "action": "recover_or_change_choice",
      "to": "G-PREDICT"
    },
    {
      "from": "*",
      "action": "reset",
      "to": "G-RESET"
    },
    {
      "from": "G-RESET",
      "action": "render_entry",
      "to": "G-ENTRY"
    }
  ],
